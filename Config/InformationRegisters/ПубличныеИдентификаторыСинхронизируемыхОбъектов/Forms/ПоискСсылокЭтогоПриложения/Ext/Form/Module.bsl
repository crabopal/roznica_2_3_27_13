#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИскомаяСсылкаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ИскомаяСсылка) Тогда
		
		НайтиЗаписиСоответствийНаСервере();
		
	Иначе
		
		НайденныеЗаписи.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеЗаписи

&НаКлиенте
Процедура НайденныеЗаписиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЗаписьРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиЗаписиСоответствий(Команда)
	
	НайтиЗаписиСоответствийНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапись(Команда)
	
	ОткрытьЗаписьРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьЗаписьРегистра()
	
	ДанныеТекущейСтроки = Элементы.НайденныеЗаписи.ТекущиеДанные;
	Если ДанныеТекущейСтроки = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗначениеКлюча = Новый Структура("Идентификатор, Ссылка, УзелИнформационнойБазы");
	ЗаполнитьЗначенияСвойств(ЗначениеКлюча, ДанныеТекущейСтроки);
	
	ПараметрыКлючаЗаписи = Новый Массив;
	ПараметрыКлючаЗаписи.Добавить(ЗначениеКлюча);
	
	КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.ПубличныеИдентификаторыСинхронизируемыхОбъектов", ПараметрыКлючаЗаписи);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
	
	ОткрытьФорму("РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.Форма.ФормаЗаписи", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Процедура НайтиЗаписиСоответствийНаСервере()
	
	НайденныеЗаписи.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ИскомаяСсылка);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор КАК Идентификатор,
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Ссылка,
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы КАК УзелИнформационнойБазы
		|ИЗ
		|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
		|ГДЕ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка = &Ссылка";
	
	НайденныеЗаписи.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти
