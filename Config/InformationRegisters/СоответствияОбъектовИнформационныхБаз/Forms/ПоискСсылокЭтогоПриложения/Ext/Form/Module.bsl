#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИскомаяСсылкаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ИскомаяСсылка) Тогда
		
		НайтиЗаписиСоответствийНаСервере();
		
	Иначе
		
		НайденныеЗаписи.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденныеЗаписи

&НаКлиенте
Процедура НайденныеЗаписиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЗаписьРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиЗаписиСоответствий(Команда)
	
	НайтиЗаписиСоответствийНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапись(Команда)
	
	ОткрытьЗаписьРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьЗаписьРегистра()
	
	ДанныеТекущейСтроки = Элементы.НайденныеЗаписи.ТекущиеДанные;
	Если ДанныеТекущейСтроки = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗначениеКлюча = Новый Структура;
	ЗначениеКлюча.Вставить("УникальныйИдентификаторПриемника");
	ЗначениеКлюча.Вставить("УникальныйИдентификаторИсточника");
	ЗначениеКлюча.Вставить("ТипПриемника");
	ЗначениеКлюча.Вставить("ТипИсточника");
	ЗначениеКлюча.Вставить("УзелИнформационнойБазы");
	
	ЗаполнитьЗначенияСвойств(ЗначениеКлюча, ДанныеТекущейСтроки);
	
	ПараметрыКлючаЗаписи = Новый Массив;
	ПараметрыКлючаЗаписи.Добавить(ЗначениеКлюча);
	
	КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.СоответствияОбъектовИнформационныхБаз", ПараметрыКлючаЗаписи);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
	
	ОткрытьФорму("РегистрСведений.СоответствияОбъектовИнформационныхБаз.ФормаЗаписи", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Процедура НайтиЗаписиСоответствийНаСервере()
	
	НайденныеЗаписи.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УникальныйИдентификаторИсточника", ИскомаяСсылка);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника КАК УникальныйИдентификаторПриемника,
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторИсточника,
		|	СоответствияОбъектовИнформационныхБаз.ТипПриемника КАК ТипПриемника,
		|	СоответствияОбъектовИнформационныхБаз.ТипИсточника КАК ТипИсточника,
		|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы КАК УзелИнформационнойБазы
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|ГДЕ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника = &УникальныйИдентификаторИсточника";
	
	НайденныеЗаписи.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти
