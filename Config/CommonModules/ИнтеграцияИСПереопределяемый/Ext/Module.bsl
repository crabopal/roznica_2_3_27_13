	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанныхДляГенерацииСерий);
	ТаблицаРезультатЗаполненияГенерации = Запрос.Выполнить().Выгрузить();
	
	РезультатЗаполненияСерий.ЗаполнениеЗавершено = Истина;
	
	Ошибки = Новый Структура;
	Ошибки.Вставить("СписокОшибок", Новый Массив);
	Ошибки.Вставить("ГруппыОшибок", Новый Соответствие);
	
	//Генерация
	Для Каждого СтрокаТЧ Из ТаблицаРезультатЗаполненияГенерации Цикл
		
		Если Не СтрокаТЧ.ИспользоватьСерии Тогда
			
			СтрокаТЧ.ЕстьОшибка = Истина;
			СтрокаТЧ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Для номенклатуры %1 серии не используются.'"), СтрокаТЧ.НоменклатураНаименование);
			
		//ИначеЕсли НЕ СтрокаТЧ.АвтоматическиГенерироватьСерии И Не ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
		//	
		//	СтрокаТЧ.ЕстьОшибка = Истина;
		//	СтрокаТЧ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Для номенклатуры %1 не предусмотрена автоматическая генерация серий.'"), СтрокаТЧ.НоменклатураНаименование);
			
		ИначеЕсли (СтрокаТЧ.ИспользоватьЗаписьСкладскогоЖурналаВЕТИССерии
			Или СтрокаТЧ.ИспользоватьИдентификаторПартииВЕТИССерии)
			//Или СтрокаТЧ.ИспользоватьПроизводителяВЕТИССерии)
			И Не ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторПартииВЕТИС) Тогда
			
			СтрокаТЧ.ЕстьОшибка = Истина;
			СтрокаТЧ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Для номенклатуры %1 для генерации серий требуются данные ВетИС.'"), СтрокаТЧ.НоменклатураНаименование);
			
		//ИначеЕсли СтрокаТЧ.АвтоматическиГенерироватьСерии И Не ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
			
			Если Не ПравоДоступа("Добавление", Метаданные.Справочники.СерииНоменклатуры) Тогда
				
				СтрокаТЧ.ЕстьОшибка = Истина;
				СтрокаТЧ.ТекстОшибки = НСтр("ru = 'Генерация серий недоступна пользователю.'");
				
			Иначе
				
				Попытка
					
					НоваяСерия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
					НоваяСерия.Заполнить(СтрокаТЧ);
					ЗаполнитьЗначенияСвойств(НоваяСерия, СтрокаТЧ);
					НоваяСерия.Записать();
					
					СтрокаТЧ.Серия = НоваяСерия.Ссылка;
					
				Исключение
					
					РезультатЗаполненияСерий.ЗаполнениеЗавершено = Ложь;
					СтрокаТЧ.ЕстьОшибка = Истина;
					СтрокаТЧ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось сгенерировать серию для номенклатуры %1 по причине: %2'"),
						СтрокаТЧ.НоменклатураНаименование,
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				КонецПопытки;
				
			КонецЕсли;
		 
		КонецЕсли;
		
		КлючПоиска = Новый Структура;
		КлючПоиска.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
		КлючПоиска.Вставить("Серия", ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа(Метаданные.ОпределяемыеТипы.СерияНоменклатуры));
		//Если СтрокаТЧ.ИспользоватьМРЦМОТПСерии Тогда
		//	КлючПоиска.Вставить("МРЦ", СтрокаТЧ.МаксимальнаяРозничнаяЦенаМОТП);
		//КонецЕсли;
		//Если СтрокаТЧ.ИспользоватьСправку2ЕГАИССерии Тогда
		//	КлючПоиска.Вставить("Справка2", СтрокаТЧ.Справка2ЕГАИС);
		//ИначеЕсли СтрокаТЧ.ИспользоватьПроизводителяЕГАИССерии Тогда
		//	КлючПоиска.Вставить("Справка2", СтрокаТЧ.Справка2ЕГАИСПроизводительЕГАИС);
		//КонецЕсли;
		Если СтрокаТЧ.ИспользоватьЗаписьСкладскогоЖурналаВЕТИССерии Тогда
			КлючПоиска.Вставить("ЗаписьСкладскогоЖурнала", СтрокаТЧ.ЗаписьСкладскогоЖурналаВЕТИС);
		//ИначеЕсли СтрокаТЧ.ИспользоватьПроизводителяВЕТИССерии Тогда
		//	КлючПоиска.Вставить("ЗаписьСкладскогоЖурнала", СтрокаТЧ.ЗаписьСкладскогоЖурналаВЕТИСПроизводительВЕТИС);
		КонецЕсли;
		Если СтрокаТЧ.ИспользоватьИдентификаторПартииВЕТИССерии Тогда
			КлючПоиска.Вставить("ИдентификаторПартии", СтрокаТЧ.ИдентификаторПартииВЕТИС);
		КонецЕсли;
		ИсходныеСтроки = ТаблицаДанныхДляГенерацииСерий.НайтиСтроки(КлючПоиска);
		Для Каждого СтрокаДляГенерации Из ИсходныеСтроки Цикл
			Если ДатаПодходитПоТочности(СтрокаДляГенерации.ДатаПроизводства, СтрокаТЧ.ДатаПроизводства,
				СтрокаТЧ.ИспользоватьДатуПроизводстваСерии, СтрокаТЧ.ТочностьУказанияСрокаГодностиСерии)
				И ДатаПодходитПоТочности(СтрокаДляГенерации.ГоденДо, СтрокаТЧ.ГоденДо,
					СтрокаТЧ.ИспользоватьСрокГодностиСерии, СтрокаТЧ.ТочностьУказанияСрокаГодностиСерии) Тогда
				ЗаполнитьЗначенияСвойств(СтрокаДляГенерации, СтрокаТЧ, "Серия, ЕстьОшибка, ТекстОшибки");
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаТЧ.ЕстьОшибка Тогда
			Если РезультатЗаполненияСерий.СписокОшибок = Неопределено Тогда
				РезультатЗаполненияСерий.СписокОшибок = Новый Массив;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				Ошибки, "СгенерироватьСерии", СтрокаТЧ.ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	//Подготовка результата
	РезультатЗаполненияСерий.Серии.Очистить();
	Для Каждого СтрокаТЧ Из ТаблицаДанныхДляГенерацииСерий Цикл
		СтруктураЗаполненияСтроки = Новый Структура;
		СтруктураЗаполненияСтроки.Вставить("Серия", СтрокаТЧ.Серия);
		Если ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
			СтруктураЗаполненияСтроки.Вставить("СтатусУказанияСерий", 2);
		КонецЕсли;
		РезультатЗаполненияСерий.Серии.Добавить(СтруктураЗаполненияСтроки);
	КонецЦикла;
	Если Ошибки.СписокОшибок.Количество() > 0 Тогда 
		РезультатЗаполненияСерий.СписокОшибок = Ошибки;
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаПодходитПоТочности(ДатаНеокругленная, ДатаОкругленная, ИспользоватьДату, ТочностьДаты)
	Если Не ИспользоватьДату Тогда
		Возврат Истина;
	ИначеЕсли ТочностьДаты = Перечисления.ТочностиУказанияСрокаГодности.СТочностьюДоЧасов Тогда
		Возврат НачалоЧаса(ДатаНеокругленная) = ДатаОкругленная;
	ИначеЕсли ТочностьДаты = Перечисления.ТочностиУказанияСрокаГодности.СТочностьюДоДней Тогда
		Возврат НачалоДня(ДатаНеокругленная) = ДатаОкругленная;
	Иначе
		Возврат ДатаНеокругленная = ДатаОкругленная;
	КонецЕсли;
КонецФункции

