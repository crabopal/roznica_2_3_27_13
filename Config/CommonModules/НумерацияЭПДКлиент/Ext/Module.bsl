#Область СлужебныйПрограммныйИнтерфейс

// Отменяет запись нового исходящего ЭПД и открывает восстановление при нарушенной нумерации.
// Вызывается из обработчика ПередЗаписью основной формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Отказ - Булево
//  ПараметрыЗаписи - Структура - параметры отмененной записи: с ними документ записывается после восстановления.
//
Процедура ПередЗаписьюФормыДокумента(Форма, Отказ, ПараметрыЗаписи = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Форма.Объект.Ссылка) Или Форма.Объект.ЭтоВходящий Тогда
		Возврат;
	КонецЕсли;

	ИмяДокумента = ИмяДокументаФормы(Форма);
	НарушающийНомер = НумерацияЭПДВызовСервера.НестандартныйСтаршийНомер(ИмяДокумента,
		Форма.Объект.Дата);
	Если Не ЗначениеЗаполнено(НарушающийНомер) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	ОткрытьФорму(ИмяФормыВосстановления(),
		Новый Структура("ИмяДокумента, Номер, Дата", ИмяДокумента, НарушающийНомер, Форма.Объект.Дата), Форма, , , ,
		Новый ОписаниеОповещения("ПослеВосстановленияНумерации", ЭтотОбъект,
			Новый Структура("Форма, ПараметрыЗаписи", Форма, ПараметрыЗаписи)));

КонецПроцедуры

// Записывает документ после восстановления нумерации и показывает итог.
//
// Параметры:
//  Итог - Структура - см. НумерацияЭПД.ВосстановитьНумерацию
//       - Неопределено - окно закрыто без восстановления.
//  Контекст - Структура:
//   * Форма - ФормаКлиентскогоПриложения
//   * ПараметрыЗаписи - Структура, Неопределено - параметры отмененной записи.
//
Процедура ПослеВосстановленияНумерации(Итог, Контекст) Экспорт

	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Форма = Контекст.Форма;
	// Записываем после закрытия блокирующего окна: запись при открытом окне вызывает сбой веб-клиента.
	Попытка
		Если ТипЗнч(Контекст.ПараметрыЗаписи) = Тип("Структура") Тогда
			ДокументЗаписан = Форма.Записать(Контекст.ПараметрыЗаписи);
		Иначе
			ДокументЗаписан = Форма.Записать();
		КонецЕсли;
	Исключение
		ДокументЗаписан = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Итог.Вставить("ДокументЗаписан", ДокументЗаписан);
	Итог.Вставить("Документ", Форма.Объект.Ссылка);
	ОткрытьФорму(ИмяФормыВосстановления(),
		Новый Структура("Итог, ИмяДокумента, Дата", Итог, ИмяДокументаФормы(Форма), Форма.Объект.Дата), Форма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяДокументаФормы(Форма)

	Возврат СтрРазделить(Форма.ИмяФормы, ".")[1];

КонецФункции

Функция ИмяФормыВосстановления()

	Возврат "Обработка.ВосстановлениеНумерацииЭПД.Форма";

КонецФункции

#КонецОбласти
