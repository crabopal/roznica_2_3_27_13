		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО втЦеновыеГруппы.ЦеноваяГруппа = СправочникНоменклатура.ЦеноваяГруппа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				&ЦеныНаДату,
		|				НЕ Номенклатура.ВидНоменклатуры.ИспользоватьЦенуНоменклатуры
		|					И ВидЦены В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							втЦеновыеГруппы.ВидЦен
		|						ИЗ
		|							втЦеновыеГруппы КАК втЦеновыеГруппы)) КАК ЦеныНоменклатурыПоЦеновымГруппам
		|		ПО (ЦеныНоменклатурыПоЦеновымГруппам.Номенклатура = СправочникНоменклатура.Ссылка)
		|			И (ЦеныНоменклатурыПоЦеновымГруппам.ВидЦены = втЦеновыеГруппы.ВидЦен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникНоменклатура.Ссылка,
		|	ХарактеристикиНоменклатуры.Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка),
		|	ЦеныНоменклатурыПоЦеновымГруппам.Упаковка,
		|	0,
		|	ЕСТЬNULL(ЦеныНоменклатурыПоЦеновымГруппам.Цена, 0),
		|	втЦеновыеГруппы.ВидЦен
		|ИЗ
		|	втЦеновыеГруппы КАК втЦеновыеГруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО втЦеновыеГруппы.ЦеноваяГруппа = СправочникНоменклатура.ЦеноваяГруппа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				&ЦеныНаДату,
		|				Номенклатура.ВидНоменклатуры.ИспользоватьЦенуНоменклатуры
		|					И ВидЦены В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							втЦеновыеГруппы.ВидЦен
		|						ИЗ
		|							втЦеновыеГруппы КАК втЦеновыеГруппы)) КАК ЦеныНоменклатурыПоЦеновымГруппам
		|		ПО (ЦеныНоменклатурыПоЦеновымГруппам.Номенклатура = СправочникНоменклатура.Ссылка)
		|			И (ЦеныНоменклатурыПоЦеновымГруппам.ВидЦены = втЦеновыеГруппы.ВидЦен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО (СправочникНоменклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
		|				ИЛИ СправочникНоменклатура.ВидНоменклатуры = ХарактеристикиНоменклатуры.Владелец)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втЦеныНоменклатуры.ВидЦен КАК ВидЦен,
		|	втЦеныНоменклатуры.Номенклатура КАК Номенклатура,
		|	втЦеныНоменклатуры.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(втЦеныНоменклатуры.ЦенаПоЦеновымГруппам) > 0
		|			ТОГДА МАКСИМУМ(втЦеныНоменклатуры.УпаковкаПоЦеновымГруппам)
		|		ИНАЧЕ МАКСИМУМ(втЦеныНоменклатуры.УпаковкаПоВидуЦен)
		|	КОНЕЦ КАК Упаковка,
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(втЦеныНоменклатуры.ЦенаПоЦеновымГруппам) > 0
		|			ТОГДА МАКСИМУМ(втЦеныНоменклатуры.ЦенаПоЦеновымГруппам)
		|		ИНАЧЕ МАКСИМУМ(втЦеныНоменклатуры.ЦенаПоВидуЦен)
		|	КОНЕЦ КАК Цена
		|ПОМЕСТИТЬ втИтоговыеЦеныНоменклатуры
		|ИЗ
		|	втЦеныНоменклатуры КАК втЦеныНоменклатуры
		|ГДЕ
		|	втЦеныНоменклатуры.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
		|
		|СГРУППИРОВАТЬ ПО
		|	втЦеныНоменклатуры.Номенклатура,
		|	втЦеныНоменклатуры.Характеристика,
		|	втЦеныНоменклатуры.ВидЦен
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втИтоговыеЦеныНоменклатуры.ВидЦен КАК ТипЦен,
		|	втИтоговыеЦеныНоменклатуры.Номенклатура КАК Номенклатура,
		|	втИтоговыеЦеныНоменклатуры.Характеристика КАК Характеристика,
		|	втИтоговыеЦеныНоменклатуры.Упаковка КАК Упаковка,
		|	втИтоговыеЦеныНоменклатуры.Цена КАК Цена,
		|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СправочникНоменклатура.Весовой КАК Весовой,
		|	ВЫРАЗИТЬ(КодыТоваровSKU.SKU КАК ЧИСЛО(9, 0)) КАК SKU
		|ИЗ
		|	втИтоговыеЦеныНоменклатуры КАК втИтоговыеЦеныНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ [ИсточникКодовSKU] КАК КодыТоваровSKU
		|		ПО (КодыТоваровSKU.Номенклатура = втИтоговыеЦеныНоменклатуры.Номенклатура)
		|			И (КодыТоваровSKU.Характеристика = втИтоговыеЦеныНоменклатуры.Характеристика)
		|			И (КодыТоваровSKU.Упаковка = втИтоговыеЦеныНоменклатуры.Упаковка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО (СправочникНоменклатура.Ссылка = втИтоговыеЦеныНоменклатуры.Номенклатура)
		|ГДЕ
		|	[УсловиеОтбораSKU]
		|ИТОГИ ПО
		|	ТипЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втЦеныНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втИтоговыеЦеныНоменклатуры
		|";
		
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ДополнительныеПараметры.Свойство("ТаблицаКодовSKU")
		И ЗначениеЗаполнено(ДополнительныеПараметры.ТаблицаКодовSKU) Тогда
		
		ЗапросSKU = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.SKU КАК SKU,
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Характеристика КАК Характеристика,
		|	Т.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ втКодыТоваровSKU
		|ИЗ
		|	&ТаблицаКодовSKU КАК Т");
		
		ЗапросSKU.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЗапросSKU.УстановитьПараметр("ТаблицаКодовSKU", ДополнительныеПараметры.ТаблицаКодовSKU);
		ЗапросSKU.Выполнить();
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ИсточникКодовSKU]", "втКодыТоваровSKU");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеОтбораSKU]", "НЕ КодыТоваровSKU.SKU ЕСТЬ NULL");
	
		Запрос.УстановитьПараметр("ЦеныНаДату", ТекущаяДатаСеанса());
	КонецЕсли;
	
	ДатаДокумента = ТекущаяДатаСеанса();
	Если КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
		ДатаДокумента = КомпонентыОбмена.УзелКорреспондента.ДатаНачалаВыгрузкиДокументов;
	ИначеЕсли КомпонентыОбмена.ПараметрыКонвертации.ПереходНаНовуюРедакцию Тогда
		ДатаДокумента = КомпонентыОбмена.ПараметрыКонвертации.ДатаОстатков;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ИсточникКодовSKU]", "РегистрСведений.КодыТоваровSKU");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеОтбораSKU]", "ИСТИНА");
		
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если НЕ Запрос.Параметры.Свойство("ЦеныНаДату") Тогда
		Запрос.УстановитьПараметр("ЦеныНаДату", ДатаДокумента);
	КонецЕсли;
	
	КомпонентыОбмена.ПараметрыКонвертации.Свойство("ТолькоЦеныПравилЦенообразованияМагазинов", ТолькоЦеныПравилЦенообразованияМагазинов);
	
	Запрос.УстановитьПараметр("ТипЦенДляИзмененияЦен", КомпонентыОбмена.ПараметрыКонвертации.ТипЦенДляИзмененияЦен);
	Запрос.УстановитьПараметр("ТолькоЦеныПравилЦенообразованияМагазинов", ТолькоЦеныПравилЦенообразованияМагазинов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ШаблонТаблицаТоваров = Новый ТаблицаЗначений;
	Для Каждого КолонкаРезультата Из РезультатЗапроса.Колонки Цикл
		ШаблонТаблицаТоваров.Колонки.Добавить(КолонкаРезультата.Имя, КолонкаРезультата.ТипЗначения);
	КонецЦикла;
	
	ВыборкаВидЦены = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Префикс = Константы["ПрефиксУзлаРаспределеннойИнформационнойБазы"].Получить(); 
	
	Если ПустаяСтрока(Префикс) Тогда
		ОбменДаннымиПереопределяемый.ПриОпределенииПрефиксаИнформационнойБазыПоУмолчанию(Префикс);
	КонецЕсли;
	
	ПравилоУстановкаЦенОтправка = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Документ_УстановкаЦенНоменклатуры_Отправка", "Имя");
	Если Не ПравилоУстановкаЦенОтправка = Неопределено Тогда
		
		СчетчикЦены = 1;
		
		Пока ВыборкаВидЦены.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаВидЦены.ТипЦен) Тогда
				Продолжить;
			КонецЕсли;
			
			СчетчикТовары = 0;
			ДанныеИБСтруктура = Неопределено;
			
			ВыборкаДетали  = ВыборкаВидЦены.Выбрать();
			
			Пока ВыборкаДетали.Следующий() Цикл
				
				Если ДанныеИБСтруктура = Неопределено Тогда
					
				  	ДанныеИБСтруктура = Новый Структура("Дата, Номер, Ответственный, Комментарий");
					
					ШаблонПрефикса = Префикс + "-" + "А";
					НомерДокумента = ШаблонПрефикса + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Строка(СчетчикЦены), 11 - СтрДлина(ШаблонПрефикса));
					
					ДанныеИБСтруктура.Дата        = ДатаДокумента;
					ДанныеИБСтруктура.Номер       = НомерДокумента;
					ДанныеИБСтруктура.Комментарий = НСтр("ru = 'Создан автоматически при первой выгрузке.'");
					
					ТаблицаТоваров = ШаблонТаблицаТоваров.Скопировать();
					
				КонецЕсли;
				
				СтрокаТовары = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТовары, ВыборкаДетали);
				СчетчикТовары = СчетчикТовары + 1;
				
				ВыгрузитьОбъектВыборки = (ТаблицаТоваров.Количество() > 9998) ИЛИ (ВыборкаДетали.Количество() = СчетчикТовары);	
					
				Если ВыгрузитьОбъектВыборки Тогда
					Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменУРМК"
						И ПодключаемоеОборудованиеOfflineВызовСервера.ДоступностьРаботыСКодамиТоваровSKU()
						И ЗначениеНастроекПовтИсп.ПолучитьЗначениеКонстанты("АвтоматическиГенерироватьSKU") Тогда
					    РегистрыСведений.КодыТоваровSKU.ОбновитьКоды_SKU_PLU(ТаблицаТоваров, Истина);
					КонецЕсли;
	
					ОбработатьХарактеристикиТоваров(КомпонентыОбмена, ТаблицаТоваров);
					ОбработатьУпаковкиТоваров(КомпонентыОбмена, ТаблицаТоваров);
	
					ДанныеИБСтруктура.Вставить("Товары", ТаблицаТоваров);
					ДанныеИБСтруктура.Вставить("ТипЦен", ВыборкаВидЦены.ТипЦен);
					ДанныеИБСтруктура.Вставить("УстановкаЦенНоменклатуры", Истина);
	
					ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
						ДанныеИБСтруктура, 
						ПравилоУстановкаЦенОтправка);
						
					ДанныеИБСтруктура = Неопределено;
					СчетчикЦены = СчетчикЦены + 1;
					 
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры
