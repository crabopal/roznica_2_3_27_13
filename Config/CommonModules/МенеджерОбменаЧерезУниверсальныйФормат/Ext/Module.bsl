Процедура ПКО_Справочник_АлкогольнаяПродукцияЕГАИС_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ВидПродукции) Тогда
		СтруктураВидПродукции = Новый Структура("Код, Наименование, ВидЛицензии, Маркируемый");
		ЗаполнитьЗначенияСвойств(СтруктураВидПродукции, ДанныеИБ.ВидПродукции);
		Если НЕ ЗначениеЗаполнено(СтруктураВидПродукции.Код) Тогда
			СтруктураВидПродукции.Код = "0";
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеИБ.ВидПродукции.ВидЛицензии) Тогда
			ВидЛицензии = ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидПродукции.ВидЛицензии);
			СтруктураВидПродукции.Вставить("ВидЛицензии", ВидЛицензии);
		КонецЕсли;
		ДанныеXDTO.Вставить("ВидАлкогольнойПродукции", СтруктураВидПродукции);
	Иначе
		ДанныеXDTO.Вставить("ВидАлкогольнойПродукции", Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ТипПродукции) Тогда
		ТипПродукции = ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ТипПродукции);
		ДанныеXDTO.Вставить("ТипПродукции", ТипПродукции);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.Крепость) Тогда
		ДанныеXDTO.Вставить("Крепость", Окр(ДанныеИБ.Крепость,2));
	КонецЕсли;
