	КонецЕсли;
	
	Если СвойствоФорматаОбмена(КомпонентыОбмена, "СведенияПрослеживаемости") Тогда
		ЗаполнитьСведенияОПрослеживаемости(ДанныеИБ.ДополнительныеСвойства.Товары, ДанныеИБ, ДанныеXDTO);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Товары", ДанныеИБ.ДополнительныеСвойства.Товары);
КонецПроцедуры
Процедура ПКО_Документ_ОприходованиеТоваровВПоступление_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
