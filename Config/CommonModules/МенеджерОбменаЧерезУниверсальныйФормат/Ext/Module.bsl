	|	ОКР(РКОРасшифровкаПлатежаПоСтавкеНДС.СуммаВзаиморасчетов * РКОРасшифровкаПлатежаПоСтавкеНДС.СуммаВзаиморасчетовРКО / РКОРасшифровкаПлатежаПоСтавкеНДСИтог.СуммаВзаиморасчетов, 2),
	|	РКОРасшифровкаПлатежаПоСтавкеНДС.СтавкаНДС,
	|	ОКР(РКОРасшифровкаПлатежаПоСтавкеНДС.СуммаВзаиморасчетов * РКОРасшифровкаПлатежаПоСтавкеНДС.СуммаВзаиморасчетовРКО / РКОРасшифровкаПлатежаПоСтавкеНДСИтог.СуммаВзаиморасчетов * ЕСТЬNULL(СтавкиНДС.КоэфициентПоСтавкеНДС, 0), 2)
	|ИЗ
	|	РКОРасшифровкаПлатежаПоСтавкеНДС КАК РКОРасшифровкаПлатежаПоСтавкеНДС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РКОРасшифровкаПлатежаПоСтавкеНДСИтог КАК РКОРасшифровкаПлатежаПоСтавкеНДСИтог
	|		ПО РКОРасшифровкаПлатежаПоСтавкеНДС.ДокументРКО = РКОРасшифровкаПлатежаПоСтавкеНДСИтог.ДокументРКО
	|			И РКОРасшифровкаПлатежаПоСтавкеНДС.СтатьяДДС = РКОРасшифровкаПлатежаПоСтавкеНДСИтог.СтатьяДДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтавкиНДС КАК СтавкиНДС
	|		ПО РКОРасшифровкаПлатежаПоСтавкеНДС.СтавкаНДС = СтавкиНДС.СтавкаНДС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПКОРасшифровкаПлатежа.СтатьяДДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	ПКОРасшифровкаПлатежа.СтавкаНДС,
	|	ОКР(ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов * ПКОРасшифровкаПлатежа.КоэфициентПоСтавкеНДС, 2)
	|ИЗ
	|	ПКОРасшифровкаПлатежа КАК ПКОРасшифровкаПлатежа
	|ГДЕ
	|	(ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = НЕОПРЕДЕЛЕНО
	|			ИЛИ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = ЗНАЧЕНИЕ(Документ.РеализацияТоваров.ПустаяСсылка)
	|			ИЛИ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = ЗНАЧЕНИЕ(Документ.ЧекККМ.ПустаяСсылка)
	|			ИЛИ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = ЗНАЧЕНИЕ(Документ.ВозвратТоваровПоставщику.ПустаяСсылка)
	|			ИЛИ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = ЗНАЧЕНИЕ(Документ.РасходныйКассовыйОрдер.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПКОРасшифровкаПлатежа.СтатьяДДС,
	|	ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом,
	|	ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	ПКОРасшифровкаПлатежа.СтавкаНДС,
	|	ОКР(ПКОРасшифровкаПлатежа.СуммаВзаиморасчетов * ПКОРасшифровкаПлатежа.КоэфициентПоСтавкеНДС, 2)
	|ИЗ
	|	ПКОРасшифровкаПлатежа КАК ПКОРасшифровкаПлатежа
	|ГДЕ
	|	НЕ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = НЕОПРЕДЕЛЕНО
	|	И НЕ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом ССЫЛКА Документ.РеализацияТоваров
	|	И НЕ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом ССЫЛКА Документ.ЧекККМ
	|	И НЕ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом ССЫЛКА Документ.ВозвратТоваровПоставщику
	|	И НЕ ПКОРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом ССЫЛКА Документ.РасходныйКассовыйОрдер
	|";
	 
	Возврат ТекстЗапроса;
КонецФункции
Процедура УстановитьИспользованиеПКО(ИспользованиеПКО, Режим)
	Для Каждого Правило Из ИспользованиеПКО Цикл
		ИспользованиеПКО[Правило.Ключ] = Режим;
	КонецЦикла;
КонецПроцедуры
Процедура УстановитьПравилоДляДокумента(Ссылка, Правило, Тип, ДополнительноеУсловие = "")
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Товары.НомерСтроки
	|ИЗ
	|   Документ."+Тип+".Товары КАК Товары
	|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|       ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|   Товары.Ссылка = &Ссылка
	|   И СправочникНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)" + ДополнительноеУсловие;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если Тип = "ОтчетОРозничныхПродажах" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И СправочникНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)","");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Правило = Ложь;
	КонецЕсли;
КонецПроцедуры
Процедура УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена, ИмяПКО, ИмяТЧ, ИмяСвойства, ИскатьВИменахФормата, ИмяНовогоПКС)
	СтрокаПравилКонвертации = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти(ИмяПКО, "ИмяПКО");
	
	Если ИскатьВИменахФормата Тогда
		СвойствоТЧ = СтрокаПравилКонвертации.СвойстваТабличныхЧастей.Найти(ИмяТЧ, "ТЧФормата");
		СтрокаСвойствТЧ = СвойствоТЧ.Свойства.Найти(ИмяСвойства, "СвойствоФормата");
	Иначе
		СвойствоТЧ = СтрокаПравилКонвертации.СвойстваТабличныхЧастей.Найти(ИмяТЧ, "ТЧКонфигурации");
		СтрокаСвойствТЧ = СвойствоТЧ.Свойства.Найти(ИмяСвойства, "СвойствоКонфигурации");
	КонецЕсли;
	
	СтрокаСвойствТЧ.ПравилоКонвертацииСвойства = ИмяНовогоПКС;
КонецПроцедуры
Функция ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO)
	// ДанныеXDTO содержат только 1 свойство, 
	// значит выполняется загрузка значения свойства, а не самого объекта. 
	Возврат ДанныеXDTO.Количество() = 1;
КонецФункции
Процедура ЗаполнитьСтавкиНДСОтправка(КомпонентыОбмена, ТабличнаяЧасть)

	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.СтавкиНДС") Тогда

		ТабличнаяЧасть.Колонки.СтавкаНДС.Имя = "СтавкаНДССсылка";
		ТабличнаяЧасть.Колонки.Добавить("СтавкаНДС");

		Для Каждого Строка Из ТабличнаяЧасть Цикл
			Если Не ТабличнаяЧасть.Колонки.Найти("СтавкаНДССсылка") = Неопределено Тогда
				Инструкция = Новый Структура;
				Инструкция.Вставить("Значение", СтавкаНДССтруктура(Строка.СтавкаНДССсылка));
				Инструкция.Вставить("ИмяПКО", "Справочник_СтавкиНДС_Отправка");
				Строка.СтавкаНДС = Инструкция;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
Функция СтавкаНДСОтправка(СтавкаНДС, КомпонентыОбмена)

	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.СтавкиНДС") Тогда
		
		Инструкция = Новый Структура;
		Инструкция.Вставить("Значение", СтавкаНДССтруктура(СтавкаНДС));
		Инструкция.Вставить("ИмяПКО", "Справочник_СтавкиНДС_Отправка");
		
		Возврат Инструкция;
	Иначе
		ПКПД_СтавкиНДС = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_СтавкиНДС", "ИмяПКПД");
		
		Возврат ПКПД_СтавкиНДС.КонвертацииЗначенийПриОтправке.Получить(СтавкаНДС);
	КонецЕсли;
	
КонецФункции
Функция СтавкаНДСПолучение(СтавкаНДС, КомпонентыОбмена)
	ПКПД_СтавкиНДС = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_СтавкиНДС", "ИмяПКПД");

	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.СтавкиНДС") Тогда
		Если СтавкаНДС.НеОблагается Тогда
			Возврат Перечисления.СтавкиНДС.БезНДС;
		ИначеЕсли СтавкаНДС.ВидСтавки.Значение = "Нулевая" Тогда
			Возврат Перечисления.СтавкиНДС.НДС0;
		ИначеЕсли СтавкаНДС.Свойство("Ставка") Тогда
			
			СтавкаСтрока = Строка(СтавкаНДС.Ставка);
						
			Если СтавкаНДС.РасчетнаяСтавка Тогда
				
				СтавкаЧисло = Число(СтавкаНДС.Ставка);
				СтавкаЧисло = 100 + СтавкаЧисло;
				
				СтавкаНДСЗначение = "НДС"+СтавкаСтрока+"_"+Формат(СтавкаЧисло, "ЧГ=");
			Иначе
				СтавкаНДСЗначение = "НДС"+СтавкаСтрока;
			КонецЕсли;
			
			Попытка
				Возврат ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.СтавкиНДС."+СтавкаНДСЗначение);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
			
		Иначе
			Возврат УчетНДС.СтавкаНДСПоУмолчанию();
		КонецЕсли;  
	Иначе		
		Возврат ПКПД_СтавкиНДС.КонвертацииЗначенийПриПолучении.Получить(СтавкаНДС.Значение);
    КонецЕсли;
КонецФункции
Функция СтавкаНДССтруктура(СтавкаНДС)
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтавкаНДССтруктура = Новый Структура("
		|Ставка,
		|РасчетнаяСтавка,
		|НеОблагается,
		|ВидСтавки");
	
	СтавкаНДССтруктура.РасчетнаяСтавка = Ложь;
	СтавкаНДССтруктура.НеОблагается = Ложь;
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда	
		СтавкаНДССтруктура.Ставка = 0;
		СтавкаНДССтруктура.НеОблагается = Истина;
		СтавкаНДССтруктура.ВидСтавки = "БезНДС";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		СтавкаНДССтруктура.Ставка = 18;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		СтавкаНДССтруктура.Ставка = 18;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		СтавкаНДССтруктура.Ставка = 10;
		СтавкаНДССтруктура.ВидСтавки = "Пониженная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		СтавкаНДССтруктура.Ставка = 10;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ПониженнаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		СтавкаНДССтруктура.Ставка = 20;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		СтавкаНДССтруктура.Ставка = 20;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		СтавкаНДССтруктура.Ставка = 22;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		СтавкаНДССтруктура.Ставка = 22;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		СтавкаНДССтруктура.Ставка = 5;
		СтавкаНДССтруктура.ВидСтавки = "Пониженная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		СтавкаНДССтруктура.Ставка = 5;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ПониженнаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		СтавкаНДССтруктура.Ставка = 7;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		СтавкаНДССтруктура.Ставка = 7;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		СтавкаНДССтруктура.Ставка = 0;
		СтавкаНДССтруктура.ВидСтавки = "Нулевая";
	КонецЕсли;
		
	Возврат СтавкаНДССтруктура;
	
КонецФункции	
Функция ВидПродукцииИСНоменклатуры(ДанныеИБ)
	Результат = Справочники.ВидыПродукцииИС.ПустаяСсылка();
	
	ОписаниеНоменклатуры = РегистрыСведений.ОписаниеНоменклатурыИС.Получить(Новый Структура("Номенклатура", ДанныеИБ.Ссылка));
	Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
		ВидыПродукцииИС = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииКлюча(ОписаниеНоменклатуры.КлючВидовПродукции);
		Если ВидыПродукцииИС.Количество() Тогда
			Результат = ВидыПродукцииИС[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
Процедура ЗаполнитьВидПродукцииИС(КомпонентыОбмена, ДанныеXDTO, ДанныеИБ, ИмяПКО)
	Если ДанныеXDTO.Свойство("ВидПродукцииИС") Тогда
		ДанныеXDTO.Удалить("ВидПродукцииИС");
	КонецЕсли;
	
	ОписаниеНоменклатуры = РегистрыСведений.ОписаниеНоменклатурыИС.Получить(Новый Структура("Номенклатура", ДанныеИБ.Ссылка));

	Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда

		ВидПродукцииИС = Справочники.КлючиВидовПродукцииИС.ЗначениеПеречисленияПоКлючу(ОписаниеНоменклатуры.КлючВидовПродукции);
		
		ОсобенностьУчета = ИнтеграцияИСРТКлиентСервер.ОсобенностьУчетаПоВидуПродукции(ВидПродукцииИС);
		
		СтрокаПКПД = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти(ИмяПКО, "ИмяПКПД");
		СоответствиеПКПД = СтрокаПКПД.КонвертацииЗначенийПриОтправке;

		Если СоответствиеПКПД[ОсобенностьУчета] <> Неопределено			
			И ЗначениеПеречисленияФорматаОбмена(КомпонентыОбмена, "ВидыПродукцииИС."+СоответствиеПКПД[ОсобенностьУчета]) Тогда
			Инструкция = Новый Структура("ИмяПКО, Значение", ИмяПКО, ОсобенностьУчета);
			ДанныеXDTO.Вставить("ВидПродукцииИС", Инструкция);
		Иначе
			ДанныеXDTO.Вставить("ВидПродукцииИССсылка", ВидПродукцииИС);
		КонецЕсли;

	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#КонецОбласти
