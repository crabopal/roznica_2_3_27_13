	Запрос = Новый Запрос;
	Запрос.Текст = ТоварыДокумента;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("СерииВТаблицеТоваров", НЕ СвойствоФорматаОбмена(КомпонентыОбмена, "СерииНоменклатуры"));

