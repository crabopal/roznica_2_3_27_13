	Если ТипОснования = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		ЗаполнитьПеремещениеМеждуМОД_ИСМПНаОснованииПеремещенияТоваров(ДокументОбъект, ДанныеЗаполнения, ПараметрыЗаполнения);
