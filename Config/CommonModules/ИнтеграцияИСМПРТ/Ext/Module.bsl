	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС") Тогда
		ЗаполнитьМаркировкаТоваровИСМПНаОснованииВходящейТранспортнойОперацииВЕТИС(ДокументОбъект, ДанныеЗаполнения, ПараметрыЗаполнения);
	КонецЕсли;

	
КонецПроцедуры

