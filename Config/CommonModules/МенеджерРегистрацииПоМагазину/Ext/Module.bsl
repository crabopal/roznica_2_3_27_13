Процедура ПРО_РегистрСведений_СтатусыДокументовВЕТИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Объект.Отбор.Документ.Значение <> Неопределено Тогда
		ПолучателиДляЦикла = ОбщегоНазначения.ФиксированныеДанные(Получатели, Ложь);
		Если ОбщегоНазначения.СсылкаСуществует(Объект.Отбор.Документ.Значение) Тогда
			ПолучателиДокументаОснования = ОпределитьПолучателей(Объект.Отбор.Документ.Значение.ПолучитьОбъект(), "ПоМагазину");
		Иначе
			ПолучателиДокументаОснования = Новый Массив;
		КонецЕсли;
		Для Каждого Получатель Из ПолучателиДляЦикла Цикл
			Индекс = Получатели.Найти(Получатель);
			Если ПолучателиДокументаОснования.Найти(Получатель) = Неопределено И Индекс <> Неопределено Тогда
				Получатели.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
