	Если ПРО.Идентификатор = "Документ_ВходящаяТранспортнаяОперацияВЕТИС" Тогда 
		ПРО_Документ_ВходящаяТранспортнаяОперацияВЕТИС_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ЗапросСкладскогоЖурналаВЕТИС" Тогда 
		ПРО_Документ_ЗапросСкладскогоЖурналаВЕТИС_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ИнвентаризацияПродукцииВЕТИС" Тогда 
