Процедура ПРО_РегистрНакопления_ТоварыОрганизаций2_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если ТипЗнч(Объект.Отбор.Регистратор.Значение) = Тип("ДокументСсылка.ВводНачальныхОстатковУзла") Тогда
		Индекс = Получатели.Найти(ПланыОбмена.ГлавныйУзел());
		Если Индекс <> Неопределено Тогда
			Получатели.Удалить(Индекс);
		КонецЕсли;
	ИначеЕсли ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда	
		МассивУзлов = Новый Массив;
		МассивУзлов.Добавить(ПланыОбмена.ГлавныйУзел());
		ОбменДаннымиСобытия.ДополнитьПолучателей(Объект, МассивУзлов);
	КонецЕсли;
КонецПроцедуры
