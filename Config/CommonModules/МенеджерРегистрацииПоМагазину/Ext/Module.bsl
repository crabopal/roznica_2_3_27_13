Процедура ПРО_РегистрСведений_НапоминанияПользователя_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если Объект.Количество() > 0 И ЗначениеЗаполнено(Объект[0].Источник) Тогда
		МетаданныеИсточника = Объект[0].Источник.Метаданные();
		Если НЕ Метаданные.Документы.Содержит(МетаданныеИсточника) Тогда
			Отказ = Истина;
		ИначеЕсли НЕ Метаданные.ПланыОбмена.ПоМагазину.Состав.Содержит(МетаданныеИсточника) Тогда
			Отказ = Истина;
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
