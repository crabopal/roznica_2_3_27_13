Процедура ПРО_Справочник_КонтрольПродаж2_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.ТорговыйОбъект КАК Магазин
	|ИЗ
	|	Справочник.КонтрольПродаж.ТорговыеОбъекты КАК Магазины
	|ГДЕ
	|	Магазины.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	МассивМагазинов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");
	
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	ПараметрыЗапроса.Вставить("ПоВсемМагазинам", Объект.Ссылка.ДляВсехТорговыхОбъектов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ГДЕ
	| (МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов) ИЛИ &СвойствоОбъекта_ПоВсемМагазинам)
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел
	|[УсловиеОтбораПоРеквизитуФлагу]
	|";
КонецПроцедуры

Процедура ПРО_Справочник_КонтрольПродаж2_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	МассивМагазинов = Объект.ТорговыеОбъекты.ВыгрузитьКолонку("ТорговыйОбъект");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ГДЕ
	| МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов)
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел
	|[УсловиеОтбораПоРеквизитуФлагу]
	|";
