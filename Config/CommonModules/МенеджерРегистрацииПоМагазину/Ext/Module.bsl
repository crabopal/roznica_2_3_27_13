Процедура ПРО_РегистрСведений_ЗаписиСкладскогоЖурналаВРезервеВЕТИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Объект.Отбор.Регистратор.Значение <> Неопределено Тогда
		ПолучателиДляЦикла = ОбщегоНазначения.ФиксированныеДанные(Получатели, Ложь);
		Если ОбщегоНазначения.СсылкаСуществует(Объект.Отбор.Регистратор.Значение) Тогда
			ПолучателиДокументаОснования = ОпределитьПолучателей(Объект.Отбор.Регистратор.Значение.ПолучитьОбъект(), "ПоМагазину");
		Иначе
			ПолучателиДокументаОснования = Новый Массив;
		КонецЕсли;
		Для Каждого Получатель Из ПолучателиДляЦикла Цикл
			Индекс = Получатели.Найти(Получатель);
			Если ПолучателиДокументаОснования.Найти(Получатель) = Неопределено И Индекс <> Неопределено Тогда
				Получатели.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
