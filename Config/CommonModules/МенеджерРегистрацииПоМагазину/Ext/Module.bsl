Процедура ПРО_РегистрСведений_ЦеныНоменклатуры_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ЦеноваяГруппа = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦеновыеГруппы.Ссылка КАК ЦеноваяГруппа
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦеновыеГруппы КАК ЦеновыеГруппы
		|		ПО (ЦеновыеГруппы.Ссылка = Номенклатура.ЦеноваяГруппа)
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура
		|	И ЦеновыеГруппы.Ссылка ЕСТЬ НЕ NULL
		|");
	
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЦеноваяГруппа = Выборка.ЦеноваяГруппа;
	КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ПравилаЦенообразования.Ссылка
	|ПОМЕСТИТЬ ПравилаЦенообразования
	|ИЗ
	|	Справочник.ПравилаЦенообразования КАК ПравилаЦенообразования
	|ГДЕ
	|	ПравилаЦенообразования.ВидЦен = &СвойствоОбъекта_ВидЦен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПравилаЦенообразованияДополнительныеВидыЦен.Ссылка
	|ИЗ
	|	Справочник.ПравилаЦенообразования.ДополнительныеВидыЦен КАК ПравилаЦенообразованияДополнительныеВидыЦен
	|ГДЕ
	|	ПравилаЦенообразованияДополнительныеВидыЦен.ВидЦен = &СвойствоОбъекта_ВидЦен
	|
	|%1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Магазины.Ссылка КАК Магазин
	|ПОМЕСТИТЬ втМагазины
	|ИЗ
	|	Справочник.Магазины КАК Магазины
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПравилаЦенообразования КАК ПравилаЦенообразования
	|		ПО Магазины.ПравилоЦенообразования = ПравилаЦенообразования.Ссылка
	|ГДЕ
	|	Магазины.СкладУправляющейСистемы = ЛОЖЬ
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ЛЕВОЕ СОЕДИНЕНИЕ втМагазины КАК втМагазины
	| ПО МагазиныУзла.Магазин = втМагазины.Магазин
	|ГДЕ
	| ПланОбмена.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Период
	| И втМагазины.Магазин ЕСТЬ НЕ NULL 
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел
	| И НЕ ПланОбмена.ПометкаУдаления
	|[УсловиеОтбораПоРеквизитуФлагу]
	|";
	
	ПараметрыЗапроса.Вставить("ВидЦен", Объект.ВидЦены);
	
	СтрокаЗамены = "";
	Если ЗначениеЗаполнено(ЦеноваяГруппа) Тогда
		ПараметрыЗапроса.Вставить("Номенклатура", Объект.Номенклатура);
		ПараметрыЗапроса.Вставить("ЦеноваяГруппа", ЦеноваяГруппа);
		СтрокаЗамены = "ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ПравилаЦенообразованияЦеновыеГруппы.Ссылка
			|ИЗ
			|	Справочник.ПравилаЦенообразования.ЦеновыеГруппы КАК ПравилаЦенообразованияЦеновыеГруппы
			|ГДЕ
			|	ПравилаЦенообразованияЦеновыеГруппы.ВидЦен = &СвойствоОбъекта_ВидЦен
			|	И ПравилаЦенообразованияЦеновыеГруппы.ЦеноваяГруппа = &СвойствоОбъекта_ЦеноваяГруппа";
	
	КонецЕсли;
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, СтрокаЗамены);
КонецПроцедуры

