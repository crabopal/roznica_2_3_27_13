Процедура ПРО_Документ_ВводОстатковПрослеживаемыхИмпортныхТоваров_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	// Получаем значение параметра МассивМагазинов из версии объекта до изменения
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Магазины.Ссылка КАК Магазин
	|ИЗ
	|	Документ.ВводОстатковПрослеживаемыхИмпортныхТоваров.Товары КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Магазины КАК Магазины
	|		ПО (Док.Склад.Магазин = Магазины.Ссылка)
	|ГДЕ
	|	Док.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	МассивМагазинов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ГДЕ
	| (ПланОбмена.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
	| И МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов)
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел)
	| И НЕ ПланОбмена.ПометкаУдаления
	|[УсловиеОтбораПоРеквизитуФлагу]
	|";
КонецПроцедуры

