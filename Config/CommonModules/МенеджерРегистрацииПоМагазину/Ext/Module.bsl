Процедура ПРО_Справочник_ВЕТИСПрисоединенныеФайлы_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	// Получаем значение параметра Магазин
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВЕТИСПрисоединенныеФайлы.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА ВЕТИСПрисоединенныеФайлы.Документ.ТорговыйОбъект <> ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	|			ТОГДА ВЕТИСПрисоединенныеФайлы.Документ.ТорговыйОбъект
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Магазин,
	|	ВЕТИСПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ТаблицаМагазины
	|ИЗ
	|	Справочник.ВЕТИСПрисоединенныеФайлы КАК ВЕТИСПрисоединенныеФайлы
	|ГДЕ
	|	ВЕТИСПрисоединенныеФайлы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМагазины.Магазин КАК Магазин
	|ИЗ
	|	ТаблицаМагазины КАК ТаблицаМагазины
	|ГДЕ
	|	ТаблицаМагазины.Магазин <> ЛОЖЬ
	|");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	МассивМагазинов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ГДЕ
	| (МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов)
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел)
	|";
КонецПроцедуры

