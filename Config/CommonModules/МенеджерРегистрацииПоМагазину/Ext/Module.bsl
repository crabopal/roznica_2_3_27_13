Процедура ПРО_Документ_МаркетинговаяАкция2_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	// Получаем значение параметра МассивМагазинов из версии объекта до изменения
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.Магазин КАК Магазин
	|ИЗ
	|	Документ.МаркетинговаяАкция.Магазины КАК Магазины
	|ГДЕ
	|	Магазины.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	МассивМагазинов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	ПараметрыЗапроса.Вставить("ПоВсемМагазинам", Объект.Ссылка.ДляВсехМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ПоМагазину КАК ПланОбмена
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ПоМагазину.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбмена.Ссылка
	|ГДЕ
	| (МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов) ИЛИ &СвойствоОбъекта_ПоВсемМагазинам)
	| И НЕ ПланОбмена.Ссылка = &ПоМагазинуЭтотУзел
	|";
КонецПроцедуры

