Процедура ПРО_Документ_СчетФактураПолученный_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Объект.ДокументыОснования.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДокументОснование)
				И ОбщегоНазначения.СсылкаСуществует(СтрокаТаблицы.ДокументОснование) Тогда
				ПолучателиДокументаОснования = ОпределитьПолучателей(СтрокаТаблицы.ДокументОснование.ПолучитьОбъект(), "ПоМагазину");
			Иначе
				ПолучателиДокументаОснования = Новый Массив;
			КонецЕсли;
			ПолучателиДляЦикла = Получатели;
			Для Каждого Получатель Из ПолучателиДляЦикла Цикл
				Индекс = Получатели.Найти(Получатель);
				Если ПолучателиДокументаОснования.Найти(Получатель) = Неопределено И Индекс <> Неопределено Тогда
					Получатели.Удалить(Индекс);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
