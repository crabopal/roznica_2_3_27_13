#Область СлужебныйПрограммныйИнтерфейс

// Проверяет внутренний номер нового ЭПД, не даёт изменить его у записанного документа
// и заполняет пустой номер исходящего документа.
// Вызывается из обработчика ПередЗаписью модуля объекта.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  Отказ - Булево
//
Процедура ПередЗаписьюДокумента(ДокументОбъект, Отказ) Экспорт

	Если Отказ Или ДокументОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ДокументОбъект.ЭтоНовый() Тогда
		ПроверитьНомерНовогоДокумента(ДокументОбъект);
	Иначе
		ПроверитьИзменениеВнутреннегоНомера(ДокументОбъект);
	КонецЕсли;

	Если Не ДокументОбъект.ЭтоВходящий Тогда
		ЗаполнитьНомерДокументаВнутреннимНомером(ДокументОбъект);
	КонецЕсли;

КонецПроцедуры

// Скрывает внутренний номер и показывает номер в самом исходящем документе на основной форме ЭПД.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ПриСозданииНаСервереФормыДокумента(Форма) Экспорт

	Если Форма.Объект.ЭтоВходящий Тогда
		Возврат;
	КонецЕсли;

	Вид = ОписаниеВида(СтрРазделить(Форма.ИмяФормы, ".")[1]);
	Если Вид = Неопределено Или Не ЗначениеЗаполнено(Вид.РеквизитНомера) Тогда
		Возврат;
	КонецЕсли;

	Форма.Элементы.ГруппаРеквизитаНомер.Видимость = Ложь;
	Форма.Элементы["ГруппаРеквизита" + Вид.РеквизитНомера].Видимость = Истина;

КонецПроцедуры

// Возвращает старший номер года, от которого автонумерация продолжиться не может.
//
// Параметры:
//  ИмяДокумента - Строка
//  Дата - Дата - определяет год; пустая дата - текущий год.
//
// Возвращаемое значение:
//  Строка - нестандартный старший номер; пустая строка, если нумерация в порядке.
//
Функция НестандартныйСтаршийНомер(ИмяДокумента, Знач Дата) Экспорт

	Если ОписаниеВида(ИмяДокумента) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Нумерация общая, права пользователя не учитываются.
	УстановитьПривилегированныйРежим(Истина);

	НумерацияВида = ОписаниеНумерации(ИмяДокумента);
	Если Не НумерацияВида.ПрефиксПоддерживается Тогда
		Возврат "";
	КонецЕсли;

	// Платформа продолжает нумерацию от старшего номера своего префикса. Префикс нового документа до записи
	// неизвестен: организацию заполняет ПередЗаписью документа. Поэтому проверяется старший номер каждого префикса.
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(Док.Номер), """") КАК Номер
		|ИЗ
		|	&Таблица КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Если НумерацияВида.СПрефиксом Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(Док.Номер, 3, 1) = ""-""
		|			ТОГДА ПОДСТРОКА(Док.Номер, 1, 3)
		|		КОГДА ПОДСТРОКА(Док.Номер, 5, 1) = ""-""
		|			ТОГДА ПОДСТРОКА(Док.Номер, 1, 5)
		|		ИНАЧЕ """"
		|	КОНЕЦ";
	КонецЕсли;
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&Таблица", "Документ." + ИмяДокумента));
	УстановитьПериодГода(Запрос, Дата);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Номер = СокрЛП(Выборка.Номер);
		// Номера без префикса у вида с префиксацией платформа не продолжает.
		Если НумерацияВида.СПрефиксом И ПрефиксНомера(Номер, НумерацияВида) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Номер) И Не НомерВЕдиномФормате(Номер, НумерацияВида)
			И ПрефиксОрганизацииДокументаПоддерживается(ИмяДокумента, Номер, Дата, НумерацияВида) Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает виды ЭПД, имена реквизитов номера и соответствующие титулы.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * Представление - Строка
//   * РеквизитНомера - Строка - имя реквизита номера в самом документе; пусто у ЭДФ.
//   * Титулы - Массив из ПеречислениеСсылка.ТипыЭлементовРегламентаЭДО - титулы с этим номером.
//
Функция ВидыДокументов() Экспорт

	Виды = Новый Массив;
	ДобавитьВид(Виды, "ЭлектроннаяТранспортнаяНакладная",
		"ТитулГрузоотправителяТранспортнаяНакладнаяНомер", "ЭТрН_Титул1");
	ДобавитьВид(Виды, "ЭлектроннаяСопроводительнаяВедомость",
		"ТитулПеревозчикаПорядковыйНомерСопроводительнойВедомости", "ЭСВ_Титул1_1, ЭСВ_Титул1_2, ЭСВ_Титул1_5");
	ДобавитьВид(Виды, "ЭлектронныйЗаказЗаявка", "ТитулГрузоотправителяЗаказНомер", "ЭЗЗ_Титул1");
	ДобавитьВид(Виды, "ЭлектронныйЗаказНаряд", "ТитулФрахтователяПорядковыйНомерЗаказНаряда", "ЭЗН_Титул1");
	ДобавитьВид(Виды, "ЭлектронныйПутевойЛист", "ТитулОформлениеНомерПутевогоЛиста", "ЭПЛ_Титул1");
	ДобавитьВид(Виды, "ЭлектроннаяЭкспедиторскаяРасписка", "ТитулЭкспедитораНомер", "ЭЭР_Титул1");
	ДобавитьВид(Виды, "ЭлектроннаяCкладскаяРасписка", "ТитулЭкспедитораНомер", "ЭСР_Титул1");
	ДобавитьВид(Виды, "ЭлектронноеПоручениеЭкспедитору", "ТитулЗаказчикаНомер", "ЭПЭ_Титул1");
	ДобавитьВид(Виды, "ЭлектронныйДоговорФрахтования", "", "");

	Возврат Виды;

КонецФункции

// Подбирает новые внутренние номера проблемным документам года.
//
// Параметры:
//  ИмяДокумента - Строка - пустая строка: все виды.
//  Год - Число
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяДокумента - Строка
//   * Ссылка - ДокументСсылка
//   * ТекущийНомер - Строка
//   * НовыйНомер - Строка
//   * ПеренестиВНомерДокумента - Булево
//
Функция ПроблемныеДокументы(ИмяДокумента, Год) Экспорт

	Виды = Новый Массив;
	Для Каждого Вид Из ВидыДокументов() Цикл
		Если (Не ЗначениеЗаполнено(ИмяДокумента) Или Вид.Имя = ИмяДокумента)
			И ОписаниеНумерации(Вид.Имя).ПрефиксПоддерживается Тогда
			Виды.Добавить(Вид);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Если Виды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Нумерация общая, права пользователя не учитываются.
	УстановитьПривилегированныйРежим(Истина);

	Номера = НомераДокументовГода(Виды, Год);
	Для Каждого Вид Из Виды Цикл
		ДобавитьПроблемныеДокументыВида(Результат, Вид,
			Номера.НайтиСтроки(Новый Структура("ИмяДокумента", Вид.Имя)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выдаёт документам с нарушенной нумерацией новые внутренние номера.
//
// Параметры:
//  ИмяДокумента - Строка - пустая строка: все виды.
//  Год - Число
//
// Возвращаемое значение:
//  Структура:
//   * Исправлено - Массив из Структура - Документ, СтарыйНомер, НовыйНомер.
//   * ПропущеноБезПрав - Массив из ДокументСсылка
//   * Ошибки - Массив из Структура - Документ, Текст.
//   * АвтонумерацияОбновлена - Булево
//
Функция ВосстановитьНумерацию(ИмяДокумента, Год) Экспорт

	// Права проверяются до включения привилегированного режима.
	ПравоИзменения = Новый Соответствие;
	Для Каждого Вид Из ВидыДокументов() Цикл
		ПравоИзменения.Вставить(Вид.Имя, ПравоДоступа("Изменение", Метаданные.Документы[Вид.Имя]));
	КонецЦикла;

	Проблемные = ПроблемныеДокументы(ИмяДокумента, Год);
	// Исправляются только документы, доступные пользователю по ограничениям доступа:
	// запись ниже выполняется в привилегированном режиме.
	Доступные = ДоступныеДокументы(Проблемные);

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура;
	Результат.Вставить("Исправлено", Новый Массив);
	Результат.Вставить("ПропущеноБезПрав", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("АвтонумерацияОбновлена", Истина);

	Для Каждого Описание Из Проблемные Цикл

		Если Не ПравоИзменения[Описание.ИмяДокумента] Или Доступные[Описание.Ссылка] = Неопределено Тогда
			Результат.ПропущеноБезПрав.Добавить(Описание.Ссылка);
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			ИзменитьНомерДокумента(Описание);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы[Описание.ИмяДокумента], Описание.Ссылка,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Результат.Ошибки.Добавить(Новый Структура("Документ, Текст",
				Описание.Ссылка, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
			Продолжить;
		КонецПопытки;

		Результат.Исправлено.Добавить(Новый Структура("Документ, СтарыйНомер, НовыйНомер",
			Описание.Ссылка, Описание.ТекущийНомер, Описание.НовыйНомер));

	КонецЦикла;

	// Если обновить не удалось, запись новых документов не застрянет: занятому номеру подбирается свободный.
	Для Каждого Вид Из ВидыДокументов() Цикл
		Если ЗначениеЗаполнено(ИмяДокумента) И Вид.Имя <> ИмяДокумента Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ОбновитьНумерациюОбъектов(Метаданные.Документы[Вид.Имя]);
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы[Вид.Имя], , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.АвтонумерацияОбновлена = Ложь;
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИзменениеВнутреннегоНомера

// Внутренний номер записанного документа меняет только восстановление нумерации: номер не в едином формате,
// присвоенный вручную или кодом, снова сбивает автонумерацию. Номер, который видит контрагент, хранится
// в отдельном реквизите и не ограничивается. Загрузку обменом ПередЗаписьюДокумента не проверяет.
//
Процедура ПроверитьИзменениеВнутреннегоНомера(ДокументОбъект)

	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ВосстановлениеНумерацииЭПД") Тогда
		Возврат;
	КонецЕсли;

	// У вида без отдельного номера документа (ЭДФ) внутренний номер - единственный номер на форме.
	Вид = ОписаниеВида(ДокументОбъект.Метаданные().Имя);
	Если Вид = Неопределено Или Не ЗначениеЗаполнено(Вид.РеквизитНомера) Тогда
		Возврат;
	КонецЕсли;

	ЗаписанныйНомер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Ссылка, "Номер");
	Если СокрЛП(ДокументОбъект.Номер) = СокрЛП(ЗаписанныйНомер) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Внутренний номер документа «%1» назначается автоматически, изменить его нельзя: «%2» → «%3».
		|Номер, который видит контрагент, указывается в поле «Номер» формы документа.'"),
		ДокументОбъект.Метаданные().Представление(), СокрЛП(ЗаписанныйНомер), СокрЛП(ДокументОбъект.Номер));

КонецПроцедуры

#КонецОбласти

#Область НомерНовогоДокумента

// Номер мог быть назначен до записи (команда «Отправить»), поэтому проверяется всегда.
// Номер меньше следующего свободного заменяется: так он не занят и нумерация не идёт назад.
//
Процедура ПроверитьНомерНовогоДокумента(ДокументОбъект)

	НумерацияВида = ОписаниеНумерации(ДокументОбъект.Метаданные().Имя);
	Если Не НумерацияВида.ПрефиксПоддерживается Тогда
		Возврат;
	КонецЕсли;

	Если Не НомерВЕдиномФормате(ДокументОбъект.Номер, НумерацияВида) Тогда
		ДокументОбъект.УстановитьНовыйНомер();
	КонецЕсли;

	Если НомерВЕдиномФормате(ДокументОбъект.Номер, НумерацияВида) Тогда
		СледующийНомер = СледующийСвободныйНомер(ДокументОбъект, ПрефиксНомера(ДокументОбъект.Номер, НумерацияВида));
		Если СокрЛП(ДокументОбъект.Номер) < СледующийНомер Тогда
			ДокументОбъект.Номер = СледующийНомер;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Префикс - у организации: в выданном номере он может быть испорчен.
	Префикс = ?(НумерацияВида.СПрефиксом, ПрефиксНовогоНомера(ДокументОбъект), "");
	Если Не ПрефиксПоддерживается(Префикс, НумерацияВида) Тогда
		Возврат;
	КонецЕсли;

	Если ДокументОбъект.ЭтоВходящий Тогда
		ДокументОбъект.Номер = СледующийСвободныйНомер(ДокументОбъект, Префикс);
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Нарушена нумерация документов «%1»: автонумерация выдаёт номер «%2», который использовать нельзя.
		|Восстановите нумерацию: журнал «Электронные перевозочные документы» → Ещё → «Восстановление нумерации».'"),
		ДокументОбъект.Метаданные().Представление(), СокрЛП(ДокументОбъект.Номер));

КонецПроцедуры

// Возвращает номер, следующий за максимальным номером года в едином формате с тем же префиксом.
//
Функция СледующийСвободныйНомер(ДокументОбъект, Префикс)

	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ДлинаЦифр = МетаданныеДокумента.ДлинаНомера - СтрДлина(Префикс);

	ШаблонНомера = ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Префикс)
		+ СтрЗаменить(СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("#", ДлинаЦифр), "#", "[0-9]");

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос(СтрЗаменить(
		"ВЫБРАТЬ
		|	МАКСИМУМ(Док.Номер) КАК Номер
		|ИЗ
		|	&Таблица КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Док.Номер ПОДОБНО &ШаблонНомера СПЕЦСИМВОЛ ""~""
		|	И Док.Ссылка <> &Ссылка", "&Таблица", "Документ." + МетаданныеДокумента.Имя));
	Запрос.УстановитьПараметр("ШаблонНомера", ШаблонНомера);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	УстановитьПериодГода(Запрос, ДокументОбъект.Дата);
	Выборка = Запрос.Выполнить().Выбрать();

	ПоследнийНомер = 0;
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Номер) Тогда
		ПоследнийНомер = Число(Сред(СокрЛП(Выборка.Номер), СтрДлина(Префикс) + 1));
	КонецЕсли;

	Возврат Префикс + НомерИзЧисла(ПоследнийНомер + 1, ДлинаЦифр);

КонецФункции

// Заполняет пустой номер, указанный в самом документе, внутренним номером.
//
Процедура ЗаполнитьНомерДокументаВнутреннимНомером(ДокументОбъект)

	Вид = ОписаниеВида(ДокументОбъект.Метаданные().Имя);
	Если Вид = Неопределено Или Не ЗначениеЗаполнено(Вид.РеквизитНомера)
		Или Вид.Титулы.Найти(ДокументОбъект.ТекущийТитул) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
		ДокументОбъект.УстановитьНовыйНомер();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект[Вид.РеквизитНомера]) Тогда
		ДокументОбъект[Вид.РеквизитНомера] = ДокументОбъект.Номер;
	КонецЕсли;

	ВерсияТитула = Неопределено;
	СтруктураРеквизитов = Неопределено;
	Если Не ДокументОбъект.ДополнительныеСвойства.Свойство("ВерсияТитула", ВерсияТитула)
		Или Не ДокументОбъект.ДополнительныеСвойства.Свойство("СтруктураРеквизитов", СтруктураРеквизитов)
		Или СтруктураРеквизитов = Неопределено
		Или Вид.Титулы.Найти(ВерсияТитула.Титул) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеВВерсии = Неопределено;
	СтруктураРеквизитов.Свойство(Вид.РеквизитНомера, ЗначениеВВерсии);
	Если Не ЗначениеЗаполнено(ЗначениеВВерсии) Тогда
		// Структура может быть фиксированной.
		НоваяСтруктураРеквизитов = Новый Структура(СтруктураРеквизитов);
		НоваяСтруктураРеквизитов.Вставить(Вид.РеквизитНомера, ДокументОбъект[Вид.РеквизитНомера]);
		ДокументОбъект.ДополнительныеСвойства.Вставить("СтруктураРеквизитов", НоваяСтруктураРеквизитов);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВосстановлениеНумерации

Функция НомераДокументовГода(Виды, Год)

	ТекстыЗапросов = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		ТекстыЗапросов.Добавить(СтрШаблон(
			"ВЫБРАТЬ
			|	""%1"" КАК ИмяДокумента,
			|	Док.Ссылка КАК Ссылка,
			|	Док.Дата КАК Дата,
			|	Док.Номер КАК Номер,
			|	Док.Организация КАК Организация,
			|	Док.ЭтоВходящий КАК Входящий,
			|	%2 КАК НомерДокумента
			|ИЗ
			|	Документ.%1 КАК Док
			|ГДЕ
			|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода",
			Вид.Имя, ?(ЗначениеЗаполнено(Вид.РеквизитНомера), "Док." + Вид.РеквизитНомера, """""")));
	КонецЦикла;

	Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО Дата, Ссылка");
	НачалоПериода = Дата(Год, 1, 1);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецГода(НачалоПериода));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Документы, которые пользователь видит с учетом ограничений доступа. Вызывается вне привилегированного режима.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: ДокументСсылка, значение: Истина.
//
Функция ДоступныеДокументы(Описания)

	Доступные = Новый Соответствие;
	Если Описания.Количество() = 0 Тогда
		Возврат Доступные;
	КонецЕсли;

	СсылкиПоВидам = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		Ссылки = СсылкиПоВидам[Описание.ИмяДокумента];
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			СсылкиПоВидам.Вставить(Описание.ИмяДокумента, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(Описание.Ссылка);
	КонецЦикла;

	// Один запрос по всем видам: РАЗРЕШЕННЫЕ первого запроса объединения действует на всё объединение.
	Запрос = Новый Запрос;
	ТекстыЗапросов = Новый Массив;
	Для Каждого ВидИСсылки Из СсылкиПоВидам Цикл
		ИмяПараметра = "Ссылки" + XMLСтрока(ТекстыЗапросов.Количество());
		ТекстыЗапросов.Добавить(СтрШаблон(
			"ВЫБРАТЬ%1
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.%2 КАК Док
			|ГДЕ
			|	Док.Ссылка В (&%3)",
			?(ТекстыЗапросов.Количество() = 0, " РАЗРЕШЕННЫЕ", ""), ВидИСсылки.Ключ, ИмяПараметра));
		Запрос.УстановитьПараметр(ИмяПараметра, ВидИСсылки.Значение);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Доступные.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

	Возврат Доступные;

КонецФункции

Процедура ДобавитьПроблемныеДокументыВида(Результат, Вид, СтрокиДокументов)

	НумерацияВида = ОписаниеНумерации(Вид.Имя);

	// Регистр не различается, как в базе: «гоцб-000005» занимает «ГОЦБ-000005».
	ЗанятыеНомера = Новый Соответствие;
	ПоследниеНомера = Новый Соответствие;
	СтаршийНомер = "";
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл
		Номер = СокрЛП(СтрокаДокумента.Номер);
		ЗанятыеНомера.Вставить(ВРег(Номер), Истина);
		Если НомерВЕдиномФормате(Номер, НумерацияВида) Тогда
			Префикс = ПрефиксНомера(Номер, НумерацияВида);
			ПоследниеНомера.Вставить(ВРег(Префикс), Макс(ПоследнийНомерПрефикса(ПоследниеНомера, Префикс),
				Число(Сред(Номер, СтрДлина(Префикс) + 1))));
			Если Номер > СтаршийНомер Тогда
				СтаршийНомер = Номер;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Без префиксации БСП новый номер получает префикс серии, которую продолжает платформа,
	// - старшего номера в едином формате: «ФС00-9» становится «ФС00-000009».
	ПрефиксСерии = ПрефиксНомера(СтаршийНомер, НумерацияВида);

	ПрефиксыОрганизаций = Новый Соответствие;
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл

		ТекущийНомер = СокрЛП(СтрокаДокумента.Номер);
		Если НомерВЕдиномФормате(ТекущийНомер, НумерацияВида) Тогда
			Продолжить;
		КонецЕсли;

		Если НумерацияВида.СПрефиксом Тогда
			Префикс = ПрефиксНомераОрганизации(Вид.Имя, СтрокаДокумента.Организация, НумерацияВида, ПрефиксыОрганизаций);
		Иначе
			Префикс = ПрефиксСерии;
		КонецЕсли;
		Если Не ПрефиксПоддерживается(Префикс, НумерацияВида) Тогда
			Продолжить;
		КонецЕсли;
		ДлинаЦифр = НумерацияВида.ДлинаНомера - СтрДлина(Префикс);

		Цифры = Сред(ТекущийНомер, СтрДлина(ПрефиксНомера(ТекущийНомер, НумерацияВида)) + 1);
		НовыйНомер = "";
		Если ЗначениеЗаполнено(Цифры) И СтрДлина(Цифры) < ДлинаЦифр И ТолькоЦифры(Цифры) Тогда
			НовыйНомер = Префикс + НомерИзЧисла(Число(Цифры), ДлинаЦифр);
		КонецЕсли;
		ПоследнийНомер = ПоследнийНомерПрефикса(ПоследниеНомера, Префикс);
		Пока ПустаяСтрока(НовыйНомер) Или ЗанятыеНомера.Получить(ВРег(НовыйНомер)) <> Неопределено Цикл
			ПоследнийНомер = ПоследнийНомер + 1;
			НовыйНомер = Префикс + НомерИзЧисла(ПоследнийНомер, ДлинаЦифр);
		КонецЦикла;
		ПоследниеНомера.Вставить(ВРег(Префикс), ПоследнийНомер);
		ЗанятыеНомера.Вставить(ВРег(НовыйНомер), Истина);

		Описание = Новый Структура;
		Описание.Вставить("ИмяДокумента", Вид.Имя);
		Описание.Вставить("Ссылка", СтрокаДокумента.Ссылка);
		Описание.Вставить("ТекущийНомер", ТекущийНомер);
		Описание.Вставить("НовыйНомер", НовыйНомер);
		Описание.Вставить("ПеренестиВНомерДокумента", ЗначениеЗаполнено(Вид.РеквизитНомера)
			И Не СтрокаДокумента.Входящий И Не ЗначениеЗаполнено(СтрокаДокумента.НомерДокумента));
		Результат.Добавить(Описание);

	КонецЦикла;

КонецПроцедуры

// Вызывается в транзакции.
Процедура ИзменитьНомерДокумента(Описание)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ." + Описание.ИмяДокумента);
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Описание.Ссылка);
	Блокировка.Заблокировать();

	ДокументОбъект = Описание.Ссылка.ПолучитьОбъект();
	Если СокрЛП(ДокументОбъект.Номер) <> Описание.ТекущийНомер Тогда
		ВызватьИсключение НСтр("ru = 'Номер документа изменился после поиска, запустите восстановление ещё раз.'");
	КонецЕсли;

	Если Описание.ПеренестиВНомерДокумента Тогда
		Вид = ОписаниеВида(Описание.ИмяДокумента);
		Если Не ЗначениеЗаполнено(ДокументОбъект[Вид.РеквизитНомера]) Тогда
			ДокументОбъект[Вид.РеквизитНомера] = Описание.ТекущийНомер;
			ЗаписатьНомерВВерсииТитулов(ДокументОбъект, Вид, Описание.ТекущийНомер);
		КонецЕсли;
	КонецЕсли;

	// Обычная запись: ПриЗаписи обновляет реестр ЭПД.
	ДокументОбъект.Номер = Описание.НовыйНомер;
	ДокументОбъект.ДополнительныеСвойства.Вставить("ВосстановлениеНумерацииЭПД", Истина);
	ДокументОбъект.Записать();

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация,
		ДокументОбъект.Метаданные(), Описание.Ссылка,
		СтрШаблон(НСтр("ru = 'Внутренний номер изменён: %1 → %2'"), Описание.ТекущийНомер, Описание.НовыйНомер));

КонецПроцедуры

// Форма и выгрузка в XML читают номер из версии титула.
//
Процедура ЗаписатьНомерВВерсииТитулов(ДокументОбъект, Вид, Номер)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Значения.Титул КАК Титул,
		|	МАКСИМУМ(Значения.НомерВерсии) КАК НомерВерсии
		|ИЗ
		|	РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Значения
		|ГДЕ
		|	Значения.Документ = &Документ
		|	И Значения.Титул В (&Титулы)
		|
		|СГРУППИРОВАТЬ ПО
		|	Значения.Титул");
	Запрос.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Титулы", Вид.Титулы);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Набор = РегистрыСведений.ЗначенияРеквизитовДокументовЭПД.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(ДокументОбъект.Ссылка);
		Набор.Отбор.Титул.Установить(Выборка.Титул);
		Набор.Отбор.НомерВерсии.Установить(Выборка.НомерВерсии);
		Набор.Прочитать();

		Запись = Неопределено;
		Для Каждого СтрокаНабора Из Набор Цикл
			Если СтрокаНабора.ИмяРеквизита = Вид.РеквизитНомера
				И Не ЗначениеЗаполнено(СтрокаНабора.ИмяТабличнойЧасти) Тогда
				Запись = СтрокаНабора;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Запись = Неопределено Тогда
			Запись = Набор.Добавить();
			Запись.Документ = ДокументОбъект.Ссылка;
			Запись.Организация = ДокументОбъект.Организация;
			Запись.Титул = Выборка.Титул;
			Запись.НомерВерсии = Выборка.НомерВерсии;
			Запись.ИмяРеквизита = Вид.РеквизитНомера;
			Запись.ТипРеквизита = Перечисления.ТипыРеквизитовЭПД.НеограниченнаяСтрока;
		ИначеЕсли ЗначениеЗаполнено(Запись.ЗначениеРеквизитаСтрока) Тогда
			Продолжить;
		КонецЕсли;

		Запись.ЗначениеРеквизитаСтрока = Номер;
		Набор.Записать();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ОписаниеВида(ИмяДокумента)

	Для Каждого Вид Из ВидыДокументов() Цикл
		Если Вид.Имя = ИмяДокумента Тогда
			Возврат Вид;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьВид(Виды, Имя, РеквизитНомера, ИменаТитулов)

	Титулы = Новый Массив;
	Для Каждого ИмяТитула Из СтрРазделить(СтрЗаменить(ИменаТитулов, " ", ""), ",", Ложь) Цикл
		Титулы.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО[ИмяТитула]);
	КонецЦикла;

	Вид = Новый Структура;
	Вид.Вставить("Имя", Имя);
	Вид.Вставить("Представление", Метаданные.Документы[Имя].Представление());
	Вид.Вставить("РеквизитНомера", РеквизитНомера);
	Вид.Вставить("Титулы", Титулы);
	Виды.Добавить(Вид);

КонецПроцедуры

// СПрефиксом - вид в префиксации БСП: на установку его нового номера есть подписка.
// ПрефиксПоддерживается - Ложь, если подписки добавляют к префиксу свою часть или среди них есть не из префиксации
// БСП (см. ПрефиксНовогоНомера): такой вид здесь не обрабатывается.
Функция ОписаниеНумерации(ИмяДокумента)

	НумерацияВида = Новый Структура("ДлинаНомера, СПрефиксом, ПрефиксПоддерживается",
		Метаданные.Документы[ИмяДокумента].ДлинаНомера, ПодпискиНаУстановкуНомера(ИмяДокумента).Количество() > 0, Истина);
	Если НумерацияВида.СПрефиксом Тогда
		НумерацияВида.ПрефиксПоддерживается = ПрефиксПоддерживается(
			ПрефиксНовогоНомера(Документы[ИмяДокумента].СоздатьДокумент()), НумерацияВида);
	КонецЕсли;

	Возврат НумерацияВида;

КонецФункции

// Поддерживается префикс БСП без дополнительной части, иначе номер из него не пройдёт проверку формата.
// Неопределено - префикс не вычислен (см. ПрефиксНовогоНомера).
Функция ПрефиксПоддерживается(Префикс, НумерацияВида)

	Возврат Префикс <> Неопределено И ПрефиксНомера(Префикс + "0", НумерацияВида) = Префикс;

КонецФункции

Функция ПодпискиНаУстановкуНомера(ИмяДокумента)

	Подписки = Новый Массив;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяДокумента);
	Для Каждого Подписка Из Метаданные.ПодпискиНаСобытия Цикл
		// Без Строка() сравнение всегда ложно (8.3.27).
		Если Строка(Подписка.Событие) = "ПриУстановкеНовогоНомера" И Подписка.Источник.СодержитТип(ТипОбъекта) Тогда
			Подписки.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;

	Возврат Подписки;

КонецФункции

// Единый формат: ровно ДлинаНомера символов - префикс (см. ПрефиксНомера) и цифры.
Функция НомерВЕдиномФормате(Знач Номер, НумерацияВида)

	Номер = СокрЛП(Номер);
	Цифры = Сред(Номер, СтрДлина(ПрефиксНомера(Номер, НумерацияВида)) + 1);
	Возврат СтрДлина(Номер) = НумерацияВида.ДлинаНомера И ЗначениеЗаполнено(Цифры) И ТолькоЦифры(Цифры);

КонецФункции

// Префикс в номере. У вида в префиксации БСП - символы до дефиса включительно, дефис третий или пятый:
// «ОР-», «ИБ-», «ОРИБ-». Без префиксации БСП - всё до последнего нецифрового символа включительно: так нумерацию
// продолжает платформа, а префикс может ставить сама конфигурация или пользователь («ФС00-000001»).
Функция ПрефиксНомера(Знач Номер, НумерацияВида)

	Номер = СокрЛП(Номер);
	Если НумерацияВида.СПрефиксом Тогда
		ПозицияДефиса = СтрНайти(Номер, "-");
		Если ПозицияДефиса = 3 Или ПозицияДефиса = 5 Тогда
			Возврат Лев(Номер, ПозицияДефиса);
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Позиция = СтрДлина(Номер);
	Пока Позиция > 0 И СтрНайти("0123456789", Сред(Номер, Позиция, 1)) > 0 Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Лев(Номер, Позиция);

КонецФункции

// Префикс, который подставят подписки БСП. Номер при этом не выдаётся и не резервируется.
// Обработчики префиксации БСП вызываются напрямую, а не по имени из подписки.
// Неопределено - у вида есть подписка с другим обработчиком: её префикс здесь не вычислить.
Функция ПрефиксНовогоНомера(ДокументОбъект)

	Префикс = "";
	СтандартнаяОбработка = Истина;
	Для Каждого Подписка Из ПодпискиНаУстановкуНомера(ДокументОбъект.Метаданные().Имя) Цикл
		ИмяОбработчика = ОбработчикПрефиксацииБСП(Подписка);
		Если ИмяОбработчика = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		МодульПрефиксацияОбъектовСобытия = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовСобытия");
		Если ИмяОбработчика = "УстановитьПрефиксИнформационнойБазыИОрганизации" Тогда
			МодульПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазыИОрганизации(ДокументОбъект,
				СтандартнаяОбработка, Префикс);
		ИначеЕсли ИмяОбработчика = "УстановитьПрефиксИнформационнойБазы" Тогда
			МодульПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазы(ДокументОбъект,
				СтандартнаяОбработка, Префикс);
		Иначе
			МодульПрефиксацияОбъектовСобытия.УстановитьПрефиксОрганизации(ДокументОбъект,
				СтандартнаяОбработка, Префикс);
		КонецЕсли;
	КонецЦикла;

	Возврат Префикс;

КонецФункции

// Имя обработчика префиксации БСП в подписке; Неопределено - обработчик другой.
Функция ОбработчикПрефиксацииБСП(Подписка)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПрефиксацияОбъектов") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИменаОбработчиков = СтрРазделить("УстановитьПрефиксИнформационнойБазыИОрганизации,"
		+ "УстановитьПрефиксИнформационнойБазы,УстановитьПрефиксОрганизации", ",");
	Для Каждого ИмяОбработчика Из ИменаОбработчиков Цикл
		Если ВРег(Подписка.Обработчик) = ВРег("ПрефиксацияОбъектовСобытия." + ИмяОбработчика) Тогда
			Возврат ИмяОбработчика;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Как и восстановление, пропускает документ организации, чей префикс не поддерживается.
// Запрос выполняется только у вида в префиксации БСП (подписка на установку номера; у ЭПД в типовых
// конфигурациях её нет) и только для старшего номера не в едином формате - по числу префиксов.
Функция ПрефиксОрганизацииДокументаПоддерживается(ИмяДокумента, Номер, Дата, НумерацияВида)

	Если Не НумерацияВида.СПрефиксом Тогда
		Возврат Истина;
	КонецЕсли;

	Запрос = Новый Запрос(СтрЗаменить(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Организация КАК Организация
		|ИЗ
		|	&Таблица КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Док.Номер = &Номер", "&Таблица", "Документ." + ИмяДокумента));
	Запрос.УстановитьПараметр("Номер", Номер);
	УстановитьПериодГода(Запрос, Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;

	Префикс = ПрефиксНомераОрганизации(ИмяДокумента, Выборка.Организация, НумерацияВида, Новый Соответствие);
	Возврат ПрефиксПоддерживается(Префикс, НумерацияВида);

КонецФункции

Функция ПрефиксНомераОрганизации(ИмяДокумента, Организация, НумерацияВида, ПрефиксыОрганизаций)

	Если Не НумерацияВида.СПрефиксом Тогда
		Возврат "";
	КонецЕсли;

	Префикс = ПрефиксыОрганизаций.Получить(Организация);
	Если Префикс = Неопределено Тогда
		ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
		ДокументОбъект.Организация = Организация;
		Префикс = ПрефиксНовогоНомера(ДокументОбъект);
		ПрефиксыОрганизаций.Вставить(Организация, Префикс);
	КонецЕсли;

	Возврат Префикс;

КонецФункции

Функция ПоследнийНомерПрефикса(ПоследниеНомера, Префикс)

	ПоследнийНомер = ПоследниеНомера.Получить(ВРег(Префикс));
	Возврат ?(ПоследнийНомер = Неопределено, 0, ПоследнийНомер);

КонецФункции

Процедура УстановитьПериодГода(Запрос, Знач Дата)

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецГода(Дата));

КонецПроцедуры

Функция НомерИзЧисла(Число, ДлинаНомера)

	Если Число >= Pow(10, ДлинаНомера) Тогда
		ВызватьИсключение НСтр("ru = 'Исчерпан диапазон внутренних номеров документов ЭПД за год.'");
	КонецЕсли;

	Возврат Формат(Число, "ЧЦ=" + ДлинаНомера + "; ЧВН=; ЧГ=0");

КонецФункции

Функция ТолькоЦифры(Строка)

	Возврат ПустаяСтрока(СтрСоединить(СтрРазделить(Строка, "0123456789"), ""));

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ЭПД.Восстановление нумерации'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

#КонецОбласти
