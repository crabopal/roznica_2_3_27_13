
#Область ПрограммныйИнтерфейс

// Переопределяет открытие формы настройка кассового qr-кода СБП
//
// Параметры:
//  КассаККМ 		- ОпределяемыйТип.КассаККМРМК - касса qr-кода;
//  Организация 	- ОпределяемыйТип.ОрганизацияРМК - организация кассового qr-кода;
//  ТорговыйОбъект 	- ОпределяемыйТип.ТорговыйОбъектРМК - торговый объект кассового qr-кода;
//
//@skip-warning
Процедура ОткрытьФормуНастройкиКассовогоQRКода(КассаККМ, Организация, ТорговыйОбъект) Экспорт
	
	ИнтеграцияСПлатежнымиСистемамиРТКлиент.ОткрытьФормуНастройкиКассовогоQRКода(
		КассаККМ, 
		Организация, 
		ТорговыйОбъект);
	
	
КонецПроцедуры

// Получает код способа оплаты ЭТ БПО в зависимости от платежной системы и переданного значения метода оплаты БИП.
//
// Параметры:
//  Результат - Число - возвращаемое значение, код способа оплаты ЭТ БПО:
//                      1 - СБПQR;
//                      2 - ПлатиQR;
//                      3 - Цифровой рубль;
//                      0 - Карта.
//  Интеграция - ОпределеяемыйТип.НастройкиИнтеграцииСПлатежнымиСистемамиРМК - настройки интеграции с платежными системами;
//  МетодОплаты - Число, Неопределено - метод оплаты БИП, может принимать одно следующих значений:
//                                      1 - Национальная платежная система;
//                                      2 - Международная платежная система;
//                                      3 - Система быстрых платежей;
//                                      4 - MultiQR;
//                                      5 - PayQR-сервисы;
//                                      6 - Цифровая валюта центрального банка (Central bank digital currency);
//                                      7 - Электронные кошельки;
//                                      Неопределено - данные отсутствуют.
//
Процедура ПолучитьКодСпособаОплатыЭТ(Результат, Интеграция, МетодОплаты) Экспорт
	
	Результат = ИнтеграцияСПлатежнымиСистемамиРТКлиентСервер.ПолучитьКодСпособаОплатыЭТ(Интеграция, МетодОплаты);
	
КонецПроцедуры

#КонецОбласти
