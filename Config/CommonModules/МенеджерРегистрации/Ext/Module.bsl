Процедура ПРО_Документ_ПоступлениеТоваров_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|НомераГТД.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НомераГТД КАК НомераГТД
			|ГДЕ
			|	НомераГТД.ЭтоРНПТ
			|	И НомераГТД.Ссылка В(&НомераГТД)
			|";
	
		Запрос.УстановитьПараметр("НомераГТД", Объект.Товары.ВыгрузитьКолонку("НомерГТД"));
		РезультатЗапроса = Запрос.Выполнить();
	
		Отказ = НЕ РезультатЗапроса.Пустой();
	КонецЕсли;
КонецПроцедуры
