Процедура ПРО_РегистрСведений_СостояниеОплатыЗаказаПокупателя_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Заказ = Объект.Отбор.ЗаказПокупателя.Значение;
	Если НЕ ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Отказ = Истина;
	КонецЕсли;
