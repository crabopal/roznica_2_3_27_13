Процедура ДобавитьПРО_Документ_ПеремещениеТоваров(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "Документ_ПеремещениеТоваров";
	
	НовоеПравило.ОбъектМетаданныхИмя = "Документ.ПеремещениеТоваров";
	НовоеПравило.ИмяПланаОбмена = "СинхронизацияДанныхЧерезУниверсальныйФормат";
	НовоеПравило.ИмяРеквизитаФлага = "РежимВыгрузкиДокументов";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработке = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Истина;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Ложь;
		
	УстановитьОтборы(НовоеПравило, 
		ОтборПоСвойствамПланаОбмена_2(),
		ОтборПоСвойствамОбъекта_1());
КонецПроцедуры

Процедура ПРО_Документ_ПеремещениеТоваров_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	// Внутренние перемещения не выгружаем.
	Если Объект.Организация = Объект.ОрганизацияПолучатель
		И Объект.МагазинОтправитель = Объект.МагазинПолучатель Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ
		И ЗначениеЗаполнено(Объект.ОрганизацияПолучатель)
		И Объект.Организация <> Объект.ОрганизацияПолучатель Тогда 
		ИспользоватьКэш = Ложь;    
	
		МассивОрганизаций = Новый Массив;
		МассивОрганизаций.Добавить(Объект.Организация);
		МассивОрганизаций.Добавить(Объект.ОрганизацияПолучатель);
	
		ПараметрыЗапроса.Вставить("МассивОрганизаций", МассивОрганизаций);
		ПараметрыЗапроса.Вставить("ВариантНастройки", "ОбменКасса");
	
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ОрганизацииОтбор.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ОрганизацииОтбор.Организация В (&СвойствоОбъекта_МассивОрганизаций)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолеПроверки
		|ПОМЕСТИТЬ втОрганизации
		|ИЗ
		|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Организации КАК ОрганизацииОтбор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(втОрганизации.ПолеПроверки) КАК ПолеПроверки,
		|	втОрганизации.Ссылка КАК Узел
		|ПОМЕСТИТЬ втПолучатели
		|ИЗ
		|	втОрганизации КАК втОрганизации
		|
		|СГРУППИРОВАТЬ ПО
		|	втОрганизации.Ссылка
		|
		|ИМЕЮЩИЕ
		|	СУММА(втОрганизации.ПолеПроверки) <= 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка,
		|	ОрганизацииПланаОбмена.Организация КАК Организация,
		|	втПолучатели.Узел КАК Узел
		|ИЗ
		|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК ПланОбменаОсновнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Организации КАК ОрганизацииПланаОбмена
		|		ПО ПланОбменаОсновнаяТаблица.Ссылка = ОрганизацииПланаОбмена.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПолучатели КАК втПолучатели
		|		ПО (втПолучатели.Узел = ПланОбменаОсновнаяТаблица.Ссылка)
		|ГДЕ
		|	ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
		|	И (ОрганизацииПланаОбмена.Организация = &СвойствоОбъекта_Организация
		|			ИЛИ ПланОбменаОсновнаяТаблица.ИспользоватьОтборПоОрганизациям = ЛОЖЬ)
		|	И НЕ ПланОбменаОсновнаяТаблица.ЭтотУзел
		|	И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|	И ПланОбменаОсновнаяТаблица.ВариантНастройки <> &СвойствоОбъекта_ВариантНастройки
		|	И втПолучатели.Узел ЕСТЬ NULL
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";
	КонецЕсли;
КонецПроцедуры

