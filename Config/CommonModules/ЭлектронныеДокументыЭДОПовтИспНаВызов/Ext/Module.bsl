// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Свойства сообщений просмотра карточки документа.
// 
// Параметры:
//  ЭлектронныйДокумент - см. ЭлектронныеДокументыЭДО.СвойстваСообщенийПросмотраКарточкиДокумента.ЭлектронныйДокумент
// 
// Возвращаемое значение:
//  См. ЭлектронныеДокументыЭДО.СвойстваСообщенийПросмотраКарточкиДокумента
Функция СвойстваСообщенийПросмотраКарточкиДокумента(ЭлектронныйДокумент) Экспорт
	Возврат ЭлектронныеДокументыЭДО.СвойстваСообщенийПросмотраКарточкиДокумента(ЭлектронныйДокумент);
КонецФункции

// Параметры:
//  ЭлектронныйДокумент - см. ЭлектронныеДокументыЭДО.СостояниеДокумента.ЭлектронныйДокумент
// 
// Возвращаемое значение:
//  См. ЭлектронныеДокументыЭДО.СостояниеДокумента
Функция СостояниеДокумента(ЭлектронныйДокумент) Экспорт
	Возврат ЭлектронныеДокументыЭДО.СостояниеДокумента(ЭлектронныйДокумент);
КонецФункции

// Параметры отложенной визуализации.
// 
// Возвращаемое значение:
//  Структура:
//   * ОтложитьВизуализацию - Булево
//   * ТребуетсяВизуализация - Булево
Функция ПараметрыОтложеннойВизуализации() Экспорт
	
	КлючОбъектаНастройкиОтложитьВизуализацию = ВизуализацияЭДОСлужебный.КлючОбъектаНастройкиОтложитьВизуализацию();
	КлючОбъектаНастройкиТребуетсяВизуализация = ВизуализацияЭДОСлужебный.КлючОбъектаНастройкиТребуетсяВизуализация();
	КлючНастроекОтложеннойВизуализации = ВизуализацияЭДОСлужебный.КлючНастроекОтложеннойВизуализации();
	ОтложитьВизуализацию = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъектаНастройкиОтложитьВизуализацию,
		КлючНастроекОтложеннойВизуализации,
		Ложь);
	ТребуетсяВизуализация = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъектаНастройкиТребуетсяВизуализация,
		КлючНастроекОтложеннойВизуализации,
		Ложь);
	
	ПараметрыОтложеннойВизуализации = Новый Структура;
	ПараметрыОтложеннойВизуализации.Вставить("ОтложитьВизуализацию", ОтложитьВизуализацию);
	ПараметрыОтложеннойВизуализации.Вставить("ТребуетсяВизуализация", ТребуетсяВизуализация);
	
	Возврат ПараметрыОтложеннойВизуализации;
	
КонецФункции

#КонецОбласти
