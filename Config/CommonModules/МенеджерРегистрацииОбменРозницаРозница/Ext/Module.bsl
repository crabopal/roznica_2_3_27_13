	НовоеПравило.Идентификатор = "РегистрСведений_ИнформативныеОстаткиТоваровПоМагазинам";
	
	НовоеПравило.ОбъектМетаданныхИмя = "РегистрСведений.ИнформативныеОстаткиТоваровПоМагазинам";
	НовоеПравило.ИмяПланаОбмена = "ОбменРозницаРозница";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработке = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Ложь;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Ложь;
		
	УстановитьОтборы(НовоеПравило, 
		ПустойОтборПоСвойствамПланаОбмена(),
		ПустойОтборПоСвойствамОбъекта());
КонецПроцедуры

Процедура ПРО_РегистрСведений_ИнформативныеОстаткиТоваровПоМагазинам_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	ПараметрыЗапроса.Вставить("Магазин", Объект.Магазин);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МагазиныОстатков.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменРозницаРозница.МагазиныИнформативныхОстатков КАК МагазиныОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменРозницаРозница.Магазины КАК МагазиныУзла
	|		ПО (МагазиныУзла.Ссылка = МагазиныОстатков.Ссылка)
	|			И (МагазиныУзла.Магазин = МагазиныОстатков.Магазин)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменРозницаРозница КАК ОбменРозницаРозница
	|		ПО (ОбменРозницаРозница.Ссылка = МагазиныОстатков.Ссылка)
	|ГДЕ
	|	МагазиныОстатков.Магазин = &СвойствоОбъекта_Магазин
	|	И ОбменРозницаРозница.РежимВыгрузкиИнформативныхОстатков = ЗНАЧЕНИЕ(Перечисление.РежимыВыгрузкиИнформативныхОстатков.ИндивидуальнаяНастройка)
	|	И МагазиныУзла.Магазин ЕСТЬ NULL 
	|   И НЕ ОбменРозницаРозница.Ссылка = &ОбменРозницаРозницаЭтотУзел
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МагазиныУзла.Ссылка
	|ИЗ
	|	ПланОбмена.ОбменРозницаРозница.Магазины КАК МагазиныУзла
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменРозницаРозница КАК ОбменРозницаРозница
	|		ПО (ОбменРозницаРозница.Ссылка = МагазиныУзла.Ссылка)
	|ГДЕ
	|	НЕ МагазиныУзла.Магазин = &СвойствоОбъекта_Магазин
	|	И ОбменРозницаРозница.РежимВыгрузкиИнформативныхОстатков = ЗНАЧЕНИЕ(Перечисление.РежимыВыгрузкиИнформативныхОстатков.ВыгружатьПоВсемМагазинам)
	|   И НЕ ОбменРозницаРозница.Ссылка = &ОбменРозницаРозницаЭтотУзел";
КонецПроцедуры
