Процедура ПРО_Документ_СчетФактураПолученный_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Получатели.Количество() > 0
		И Объект.ДокументыОснования.Количество() > 0 Тогда
		
		Получатели.Очистить();
		
		Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
			Если ОбщегоНазначения.СсылкаСуществует(СтрокаТаблицы.ДокументОснование) Тогда
				ПолучателиДокументаОснования = ОпределитьПолучателей(СтрокаТаблицы.ДокументОснование.ПолучитьОбъект(),
					ПРО.ИмяПланаОбмена);
				
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПолучателиДокументаОснования, Истина);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
