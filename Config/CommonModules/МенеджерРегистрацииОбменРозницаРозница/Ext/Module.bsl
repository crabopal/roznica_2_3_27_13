Процедура ПРО_Документ_СчетФактураВыданный_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Получатели.Количество() > 0
		И ЗначениеЗаполнено(Объект.ДокументОснование)
		И ОбщегоНазначения.СсылкаСуществует(Объект.ДокументОснование) Тогда
		Получатели = ОпределитьПолучателей(Объект.ДокументОснование.ПолучитьОбъект(), ПРО.ИмяПланаОбмена);
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
