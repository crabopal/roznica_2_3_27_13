Процедура ПРО_Документ_ПоложениеОПремировании2_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	// Получаем значение параметра МассивМагазинов из версии объекта до изменения
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.Магазин КАК Магазин
	|ИЗ
	|	Документ.ПоложениеОПремировании.Магазины КАК Магазины
	|ГДЕ
	|	Магазины.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	МассивМагазинов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Магазин");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	ПараметрыЗапроса.Вставить("ПоВсемМагазинам", Объект.Ссылка.ДляВсехМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ОбменРозницаРозница КАК ПланОбменаОсновнаяТаблица
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменРозницаРозница.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбменаОсновнаяТаблица.Ссылка
	|ГДЕ
	| ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
	| И НЕ ПланОбменаОсновнаяТаблица.ВариантНастройки = ""ПоРабочемуМесту""
	| И (МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов)
	| 		ИЛИ &СвойствоОбъекта_ПоВсемМагазинам
	| 		ИЛИ НЕ ПланОбменаОсновнаяТаблица.ПодчиненныйУзел) 
	| [ОбязательныеУсловия]
	|";
КонецПроцедуры

Процедура ПРО_Документ_ПоложениеОПремировании2_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	// Получаем значение параметра МассивМагазинов из текущей версии объекта
	МассивМагазинов = Объект.Магазины.ВыгрузитьКолонку("Магазин");
	ПараметрыЗапроса.Вставить("МассивМагазинов", МассивМагазинов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
	|ИЗ
	| ПланОбмена.ОбменРозницаРозница КАК ПланОбменаОсновнаяТаблица
	|ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменРозницаРозница.Магазины КАК МагазиныУзла
	| ПО МагазиныУзла.Ссылка = ПланОбменаОсновнаяТаблица.Ссылка
	|ГДЕ
	| ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
	| И НЕ ПланОбменаОсновнаяТаблица.ВариантНастройки = ""ПоРабочемуМесту""
	| И (МагазиныУзла.Магазин В(&СвойствоОбъекта_МассивМагазинов)
	| 		ИЛИ НЕ ПланОбменаОсновнаяТаблица.ПодчиненныйУзел) 
	| [ОбязательныеУсловия]
	|";
КонецПроцедуры
