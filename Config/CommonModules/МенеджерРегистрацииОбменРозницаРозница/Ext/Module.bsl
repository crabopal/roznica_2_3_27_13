// Обработчик события ПослеОбработки правила регистрации 
// Параметры:    
//  ПРО - СтрокаТаблицыЗначений - Правило регистрации объекта
//  Отказ - Булево - Отказ от выполнения правила регистрации.
//  Объект - КонстантаМенеджерЗначения
//         - СправочникОбъект
//         - ДокументОбъект
//         - ПланВидовХарактеристикОбъект
//         - ПланСчетовОбъект
//         - ПланВидовРасчетаОбъект
//         - БизнесПроцессОбъект
//         - ЗадачаОбъект
//         - РегистрСведенийНаборЗаписей
//         - РегистрНакопленияНаборЗаписей
//         - РегистрБухгалтерииНаборЗаписей
//         - РегистрРасчетаНаборЗаписей - объект для которого выполняется правило регистрации.
//  ОбъектМетаданных - ОбъектМетаданных - Объект метаданных, соответствующий объекту.
//  Получатели - Массив - список узлов-получателей, на которых будет зарегистрирован объект.
//  Выгрузка - Булево - контекст выполнения правила регистрации, если Истина то происходит выгрузка объекта.
Процедура ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка) Экспорт
	Если ПРО.Идентификатор = "Справочник_ВЕТИСПрисоединенныеФайлы" Тогда 
		ПРО_Справочник_ВЕТИСПрисоединенныеФайлы_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыДокументовВЕТИС" Тогда 
		ПРО_РегистрСведений_СтатусыДокументовВЕТИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыОформленияДокументовВЕТИС" Тогда 
		ПРО_РегистрСведений_СтатусыОформленияДокументовВЕТИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ЗаписиСкладскогоЖурналаВРезервеВЕТИС" Тогда 
		ПРО_РегистрСведений_ЗаписиСкладскогоЖурналаВРезервеВЕТИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ЭквайринговыеТерминалы" Тогда 
		ПРО_Справочник_ЭквайринговыеТерминалы_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_Кассы" Тогда 
		ПРО_Справочник_Кассы_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыДокументовЕГАИС" Тогда 
		ПРО_РегистрСведений_СтатусыДокументовЕГАИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыОформленияДокументовЕГАИС" Тогда 
		ПРО_РегистрСведений_СтатусыОформленияДокументовЕГАИС_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ЗаявкаНаВыпускКиЗГИСМ" Тогда 
		ПРО_Документ_ЗаявкаНаВыпускКиЗГИСМ_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_СчетФактураВыданный" Тогда 
		ПРО_Документ_СчетФактураВыданный_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_СчетФактураПолученный" Тогда 
		ПРО_Документ_СчетФактураПолученный_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ИнформационнаяРассылка" Тогда 
		ПРО_Документ_ИнформационнаяРассылка_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыЗаявокНаВыпускКиЗГИСМ" Тогда 
		ПРО_РегистрСведений_СтатусыЗаявокНаВыпускКиЗГИСМ_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ДвоичныеДанныеФайлов" Тогда 
		ПРО_РегистрСведений_ДвоичныеДанныеФайлов_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ЦеныНоменклатуры" Тогда 
		ПРО_РегистрСведений_ЦеныНоменклатуры_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СостоянияОригиналовПервичныхДокументов" Тогда 
		ПРО_РегистрСведений_СостоянияОригиналовПервичныхДокументов_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ДанныеОперацийСБП" Тогда 
		ПРО_РегистрСведений_ДанныеОперацийСБП_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ИдентификаторыОперацийСБП" Тогда 
		ПРО_РегистрСведений_ИдентификаторыОперацийСБП_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрНакопления_ДвиженияСерийТоваров" Тогда 
		ПРО_РегистрНакопления_ДвиженияСерийТоваров_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
#Область СлужебныеПроцедурыИФункции
Функция ОпределитьПолучателей(Объект, ИмяПланаОбмена)
	Возврат ОбменДаннымиСобытия.ОпределитьПолучателей(Объект, ИмяПланаОбмена);
КонецФункции

Процедура УстановитьОтборы(ПравилоРегистрации, ОтборПоСвойствамПланаОбмена, ОтборПоСвойствамОбъекта)
	Обработка = Обработки.ЗагрузкаПравилРегистрацииОбъектов.Создать();
	
	ПравилаXML = Новый ЧтениеXML;
	
	//ОтборПоСвойствамПланаОбмена
	ПравилоРегистрации.ОтборПоСвойствамПланаОбмена = ОбменДаннымиСервер.ИнициализацияТаблицыОтборПоСвойствамПланаОбмена().Скопировать();
	
	ПравилаXML.УстановитьСтроку(ОтборПоСвойствамПланаОбмена);
	ПравилаXML.Прочитать();
	Обработка.ЗагрузитьДеревоОтбораПоСвойствамПланаОбмена(ПравилаXML, ПравилоРегистрации.ОтборПоСвойствамПланаОбмена);
	
	Обработка.Регистрация = Новый Структура("ИмяПланаОбмена", ПравилоРегистрации.ИмяПланаОбмена);
	Обработка.ПодготовитьПравилоРегистрацииПоСвойствамПланаОбмена(ПравилоРегистрации);
	
	//ОтборПоСвойствамОбъекта
	ПравилаXML.УстановитьСтроку(ОтборПоСвойствамОбъекта);
	ПравилаXML.Прочитать();
	
	ПравилоРегистрации.ОтборПоСвойствамОбъекта = ОбменДаннымиСервер.ИнициализацияТаблицыОтборПоСвойствамОбъекта().Скопировать();
	Обработка.ЗагрузитьДеревоОтбораПоСвойствамОбъекта(ПравилаXML, ПравилоРегистрации.ОтборПоСвойствамОбъекта);
КонецПроцедуры 

#Область Справочник_ВЕТИСПрисоединенныеФайлы
Процедура ДобавитьПРО_Справочник_ВЕТИСПрисоединенныеФайлы(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "Справочник_ВЕТИСПрисоединенныеФайлы";
	
	НовоеПравило.ОбъектМетаданныхИмя = "Справочник.ВЕТИСПрисоединенныеФайлы";
	НовоеПравило.ИмяПланаОбмена = "ОбменРозницаРозница";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработке = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Ложь;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Истина;
		
	УстановитьОтборы(НовоеПравило, 
		ОтборПоСвойствамПланаОбмена_9(),
		ПустойОтборПоСвойствамОбъекта());
КонецПроцедуры

Процедура ПРО_Справочник_ВЕТИСПрисоединенныеФайлы_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Документ = Объект.Документ;
	Если ЗначениеЗаполнено(Документ)
		И ОбщегоНазначения.СсылкаСуществует(Документ) Тогда
		Получатели = ОпределитьПолучателей(Документ.ПолучитьОбъект(), ПРО.ИмяПланаОбмена);
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область Документ_ВходящаяТранспортнаяОперацияВЕТИС
Процедура ДобавитьПРО_Документ_ВходящаяТранспортнаяОперацияВЕТИС(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "Документ_ВходящаяТранспортнаяОперацияВЕТИС";
	
	НовоеПравило.ОбъектМетаданныхИмя = "Документ.ВходящаяТранспортнаяОперацияВЕТИС";
	НовоеПравило.ИмяПланаОбмена = "ОбменРозницаРозница";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработке = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Ложь;
