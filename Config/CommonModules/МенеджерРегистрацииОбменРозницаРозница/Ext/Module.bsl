Процедура ПРО_Справочник_Кассы_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Если Получатели.Количество() > 0
		И Объект.ПробиватьЧекиПоКассеККМ И ЗначениеЗаполнено(Объект.КассаККМ)
		И ОбщегоНазначения.СсылкаСуществует(Объект.КассаККМ) Тогда
		Получатели = ОпределитьПолучателей(Объект.КассаККМ.ПолучитьОбъект(), ПРО.ИмяПланаОбмена);
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
