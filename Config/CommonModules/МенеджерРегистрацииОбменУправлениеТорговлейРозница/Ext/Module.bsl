// Обработчик события ПередОбработкой правила регистрации 
// Параметры:
//  ПРО - СтрокаТаблицыЗначений - Правило регистрации объекта
//  Отказ - Булево - Отказ от выполнения правила регистрации.
//  Объект - КонстантаМенеджерЗначения
//         - СправочникОбъект
//         - ДокументОбъект
//         - ПланВидовХарактеристикОбъект
//         - ПланСчетовОбъект
//         - ПланВидовРасчетаОбъект
//         - БизнесПроцессОбъект
//         - ЗадачаОбъект
//         - РегистрСведенийНаборЗаписей
//         - РегистрНакопленияНаборЗаписей
//         - РегистрБухгалтерииНаборЗаписей
//         - РегистрРасчетаНаборЗаписей - объект для которого выполняется правило регистрации.
//  ОбъектМетаданных - ОбъектМетаданных - Объект метаданных, соответствующий объекту.
//  Выгрузка - Булево - контекст выполнения правила регистрации, если Истина то происходит выгрузка объекта.
Процедура ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка) Экспорт
	Если ПРО.Идентификатор = "Документ_ЗаявкаНаВыпускКиЗГИСМ" Тогда 
		ПРО_Документ_ЗаявкаНаВыпускКиЗГИСМ_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ТТНВходящаяЕГАИС" Тогда 
		ПРО_Документ_ТТНВходящаяЕГАИС_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ПриказНаПроведениеИнвентаризацииТоваров" Тогда 
		ПРО_Документ_ПриказНаПроведениеИнвентаризацииТоваров_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_РасходныйКассовыйОрдер" Тогда 
		ПРО_Документ_РасходныйКассовыйОрдер_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ПриходныйОрдерНаТовары" Тогда 
		ПРО_Документ_ПриходныйОрдерНаТовары_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_МаркетинговаяАкция" Тогда 
		ПРО_Документ_МаркетинговаяАкция_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ОрдерНаОтражениеРезультатовПересчетовТоваров" Тогда 
		ПРО_Документ_ОрдерНаОтражениеРезультатовПересчетовТоваров_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_КлассификаторОрганизацийЕГАИС" Тогда 
		ПРО_Справочник_КлассификаторОрганизацийЕГАИС_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_КлассификаторТНВЭД" Тогда 
		ПРО_Справочник_КлассификаторТНВЭД_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_КлассификаторАлкогольнойПродукцииЕГАИС" Тогда 
		ПРО_Справочник_КлассификаторАлкогольнойПродукцииЕГАИС_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ВидыДисконтныхКарт" Тогда 
		ПРО_Справочник_ВидыДисконтныхКарт_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_Штрихкоды" Тогда 
		ПРО_РегистрСведений_Штрихкоды_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыЗаявокНаВыпускКиЗГИСМ" Тогда 
		ПРО_РегистрСведений_СтатусыЗаявокНаВыпускКиЗГИСМ_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	КонецЕсли;
КонецПроцедуры

// Обработчик события ПриОбработке правила регистрации
// Параметры:
//  Отказ - Булево - Отказ от выполнения правила регистрации.
//  ПРО - СтрокаТаблицыЗначений - Правило регистрации объекта
//  Объект - КонстантаМенеджерЗначения
//         - СправочникОбъект
//         - ДокументОбъект
//         - ПланВидовХарактеристикОбъект
//         - ПланСчетовОбъект
//         - ПланВидовРасчетаОбъект
//         - БизнесПроцессОбъект
//         - ЗадачаОбъект
//         - РегистрСведенийНаборЗаписей
//         - РегистрНакопленияНаборЗаписей
//         - РегистрБухгалтерииНаборЗаписей
//         - РегистрРасчетаНаборЗаписей - объект для которого выполняется правило регистрации.
//  ТекстЗапроса - Строка - текст запроса для определения узлов получателей.
//  ПараметрыЗапроса - Структура - параметры запроса для определения узлов получателей.
//  ИспользоватьКэш - Булево - использование платформенного механизма повторно используемых значений.
//  Выгрузка - Булево - контекст выполнения правила регистрации, если Истина то происходит выгрузка объекта. 
//  ДополнительныеСвойства - Структура.
Процедура ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства) Экспорт
