Процедура ПРО_Документ_РасходныйКассовыйОрдер_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Организация = Объект.Организация;
	Если Организация.ОбособленноеПодразделение Тогда
		Организация = Организация.ГоловнаяОрганизация;
	КонецЕсли;
	
	ОрганизацияПолучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаПолучатель, "Владелец");
	Если ОрганизацияПолучатель <> Неопределено Тогда
		Если ОрганизацияПолучатель.ОбособленноеПодразделение Тогда
			ОрганизацияПолучатель = ОрганизацияПолучатель.ГоловнаяОрганизация;
			// Внутреннее перемещение ДС между филиалами не выгружаем.
			// Обмен работает для головной организации.
			Если Организация = ОрганизацияПолучатель Тогда
			   Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
