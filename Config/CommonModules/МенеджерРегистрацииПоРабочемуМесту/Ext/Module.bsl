	ГлавныйУзел = ПланыОбмена.ГлавныйУзел();
	Если ГлавныйУзел <> Неопределено И ТипЗнч(ГлавныйУзел) = Тип("ПланОбменаСсылка.ПоРабочемуМесту") Тогда
		МассивУзлов = Новый Массив;
		МассивУзлов.Добавить(ПланыОбмена.ГлавныйУзел());
		ОбменДаннымиСобытия.СократитьПолучателей(Объект, МассивУзлов);
	КонецЕсли;
КонецПроцедуры
