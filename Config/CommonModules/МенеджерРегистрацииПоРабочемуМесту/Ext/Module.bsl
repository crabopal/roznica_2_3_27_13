//  ПРО - СтрокаТаблицыЗначений - Правило регистрации объекта
//  Отказ - Булево - Отказ от выполнения правила регистрации.
//  Объект - КонстантаМенеджерЗначения
//         - СправочникОбъект
//         - ДокументОбъект
//         - ПланВидовХарактеристикОбъект
//         - ПланСчетовОбъект
//         - ПланВидовРасчетаОбъект
//         - БизнесПроцессОбъект
//         - ЗадачаОбъект
//         - РегистрСведенийНаборЗаписей
//         - РегистрНакопленияНаборЗаписей
//         - РегистрБухгалтерииНаборЗаписей
//         - РегистрРасчетаНаборЗаписей - объект для которого выполняется правило регистрации.
//  ОбъектМетаданных - ОбъектМетаданных - Объект метаданных, соответствующий объекту.
//  Выгрузка - Булево - контекст выполнения правила регистрации, если Истина то происходит выгрузка объекта.
Процедура ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка) Экспорт
	Если ПРО.Идентификатор = "Документ_СписаниеТоваров" Тогда 
		ПРО_Документ_СписаниеТоваров_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ВыводИзОборотаИСМП" Тогда 
		ПРО_Документ_ВыводИзОборотаИСМП_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ПрименениеСистемНалогообложения" Тогда 
		ПРО_РегистрСведений_ПрименениеСистемНалогообложения_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ПрименениеСистемНалогообложения2" Тогда 
		ПРО_РегистрСведений_ПрименениеСистемНалогообложения2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ДействиеСкидокНаценок" Тогда 
		ПРО_РегистрСведений_ДействиеСкидокНаценок_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ДействиеСкидокНаценок2" Тогда 
		ПРО_РегистрСведений_ДействиеСкидокНаценок2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ДанныеОперацийСБПc2b" Тогда 
		ПРО_РегистрСведений_ДанныеОперацийСБПc2b_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ИдентификаторыОперацийСБПc2b" Тогда 
		ПРО_РегистрСведений_ИдентификаторыОперацийСБПc2b_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_СтатусыДокументовИСМП" Тогда 
		ПРО_РегистрСведений_СтатусыДокументовИСМП_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	КонецЕсли;
