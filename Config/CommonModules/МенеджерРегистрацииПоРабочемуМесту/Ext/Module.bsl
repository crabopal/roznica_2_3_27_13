	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		Если Объект.Количество() > 0
			И ЗначениеЗаполнено(Объект[0].Документ)
			И ОбщегоНазначения.СсылкаСуществует(Объект[0].Документ) Тогда
			Получатели = ОпределитьПолучателей(Объект[0].Документ.ПолучитьОбъект(), "ПоРабочемуМесту");
		Иначе
			Получатели = Новый Массив;
		КонецЕсли;
	Иначе
		Получатели.Добавить(ПланыОбмена.ГлавныйУзел());
	КонецЕсли;
