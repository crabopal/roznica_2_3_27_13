Процедура ПРО_РегистрСведений_СтатусыДокументовИСМП_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если ПланыОбмена.ГлавныйУзел() = Неопределено
		И Объект.Количество() > 0
		Тогда
		Если Не ЗначениеЗаполнено(Объект[0].Документ)
			ИЛИ Не ОбщегоНазначения.СсылкаСуществует(Объект[0].Документ) Тогда
			Отказ = Истина;
		Иначе
			Отказ = ТипЗнч(Объект[0].Документ) <> Тип("ДокументСсылка.ПодключениеКегаКОборудованиюРозливаИСМП");
		КонецЕсли;
	КонецЕсли;
