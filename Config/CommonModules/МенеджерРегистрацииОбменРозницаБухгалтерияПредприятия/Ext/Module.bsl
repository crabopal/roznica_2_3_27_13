Процедура ПРО_Документ_УстановкаЦенНоменклатуры_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыЦен.ВидЦены КАК ВидЦены
	|ПОМЕСТИТЬ ВидыЦен
	|ИЗ 
	|   Документ.УстановкаЦенНоменклатуры.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.Ссылка = &Ссылка
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.ПравилоЦенообразования КАК ПравилоЦенообразования
	|ИЗ
	|	Справочник.Магазины КАК Магазины
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаЦенообразования КАК СправочникПравилаЦенообразования
	|		ПО (СправочникПравилаЦенообразования.Ссылка = Магазины.ПравилоЦенообразования)
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВидыЦен КАК ВидыЦен
	|       ПО СправочникПравилаЦенообразования.ВидЦен = ВидыЦен.ВидЦены
	|ГДЕ
	|	(НЕ Магазины.ИспользоватьПрименениеЦен)
	|
	|ОБЪЕДИНИТЬ 
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.ПравилоЦенообразования
	|ИЗ
	|	Справочник.Магазины КАК Магазины
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаЦенообразования.ЦеновыеГруппы КАК ЦеновыеГруппыПравила
	|		ПО (ЦеновыеГруппыПравила.Ссылка = Магазины.ПравилоЦенообразования)
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВидыЦен КАК ВидыЦен
	|       ПО ЦеновыеГруппыПравила.ВидЦен = ВидыЦен.ВидЦены
	|ГДЕ
	|	(НЕ Магазины.ИспользоватьПрименениеЦен)");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ  
		|ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		|(ЛОЖЬ
		| И ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
		| И ПланОбменаОсновнаяТаблица.ПередаватьРозничныеЦены)
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ОбменРозницаБухгалтерияПредприятияЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";
		
	Иначе
		
		ТекстЗапроса = "
		|ВЫБРАТЬ  
		|ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		|(ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
		| И ПланОбменаОсновнаяТаблица.ПередаватьРозничныеЦены)
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ОбменРозницаБухгалтерияПредприятияЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";	
		
	КонецЕсли;
КонецПроцедуры

Процедура ПРО_Документ_УстановкаЦенНоменклатуры_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.ПравилоЦенообразования КАК ПравилоЦенообразования
	|ИЗ
	|	Справочник.Магазины КАК Магазины
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаЦенообразования КАК СправочникПравилаЦенообразования
	|		ПО (СправочникПравилаЦенообразования.Ссылка = Магазины.ПравилоЦенообразования)
	|ГДЕ
	|	(НЕ Магазины.ИспользоватьПрименениеЦен)
	|	И СправочникПравилаЦенообразования.ВидЦен В(&СвойстваОбъекта_ВидыЦенДокумента)
	|
	|ОБЪЕДИНИТЬ 
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Магазины.ПравилоЦенообразования
	|ИЗ
	|	Справочник.Магазины КАК Магазины
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаЦенообразования.ЦеновыеГруппы КАК ЦеновыеГруппыПравила
	|		ПО (ЦеновыеГруппыПравила.Ссылка = Магазины.ПравилоЦенообразования)
	|ГДЕ
	|	(НЕ Магазины.ИспользоватьПрименениеЦен)
	|	И ЦеновыеГруппыПравила.ВидЦен В(&СвойстваОбъекта_ВидыЦенДокумента)");
	Запрос.УстановитьПараметр("СвойстваОбъекта_ВидыЦенДокумента", Объект.ВидыЦен.ВыгрузитьКолонку("ВидЦены"));
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ  
		|ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		|(ЛОЖЬ
		| И ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
		| И ПланОбменаОсновнаяТаблица.ПередаватьРозничныеЦены)
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ОбменРозницаБухгалтерияПредприятияЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";
		
	Иначе
		
		ТекстЗапроса = "
		|ВЫБРАТЬ  
		|ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		|(ПланОбменаОсновнаяТаблица.ДатаНачалаВыгрузкиДокументов <= &СвойствоОбъекта_Дата
		| И ПланОбменаОсновнаяТаблица.ПередаватьРозничныеЦены)
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ОбменРозницаБухгалтерияПредприятияЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";	
		
	КонецЕсли;
КонецПроцедуры
