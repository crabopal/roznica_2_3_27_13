Процедура ПКС_ОтчетОРозничныхПродажах_ДеятельностьНаПатенте_ПередВыгрузкойСвойства_56_23(ФайлОбмена, Источник, Приемник, ВходящиеДанные, ИсходящиеДанные,
	ПКС, ПКО, ОбъектКоллекции, Отказ, Значение, ТипПриемника, ИмяПКО,
	ИмяПКОВидСубконто, Пусто, Выражение, УзелКоллекцииСвойств, НеЗамещать,
	ВыгрузитьОбъект) Экспорт

	Если ВходящиеДанные.Свойство("Патент") Тогда
		Значение = ВходящиеДанные.Патент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		ТекстЗапроса = "
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЕСТЬNULL(ВЫБОР
			|			КОГДА Налогообложение.СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ТипыСистемНалогообложенияККТ.Патент)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ, ЛОЖЬ) КАК ДеятельностьНаПатенте
			|ИЗ
			|	РегистрСведений.ПрименениеСистемНалогообложения.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Магазин = &Магазин
			|				И ВЫБОР
			|					КОГДА СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ТипыСистемНалогообложенияККТ.Патент)
			|						ТОГДА &Период >= ДатаНачалаПатента
			|									И &Период <= ДатаОкончанияПатента
			|								ИЛИ ДатаНачалаПатента = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|									И ДатаОкончанияПатента = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|					ИНАЧЕ ИСТИНА
			|				КОНЕЦ) КАК Налогообложение
			|";
	
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
	
		Запрос.УстановитьПараметр("Магазин", Источник.Магазин);
		Запрос.УстановитьПараметр("Организация", Источник.Организация);
		Запрос.УстановитьПараметр("Период", Источник.Дата);
	
		Выборка = Запрос.Выполнить().Выбрать();
	
		Пока Выборка.Следующий() Цикл
			Значение = Выборка.ДеятельностьНаПатенте;	
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

