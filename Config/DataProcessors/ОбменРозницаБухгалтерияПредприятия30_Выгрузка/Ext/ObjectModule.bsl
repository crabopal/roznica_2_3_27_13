Процедура ВыгрузитьЛицензиюПоставщикаАлкогольнойПродукции(ИсточникДанных, ЭтоУдаление) Экспорт

	Если ЭтоУдаление Тогда
		РеквизитыЛицензии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсточникДанных, 
			"Владелец, ВидЛицензии, ДатаНачала, ДатаОкончания, КемВыдана, Наименование");
	Иначе
		РеквизитыЛицензии = ИсточникДанных;
	КонецЕсли;
			
	Если Не ЗначениеЗаполнено(РеквизитыЛицензии.ДатаНачала) Тогда
		РеквизитыЛицензии.ДатаНачала = Дата(1980, 1, 1);
	КонецЕсли;
	
	// Создание пустого набора записей
	Отбор = Новый ТаблицаЗначений;
	Отбор.Колонки.Добавить("Имя");
	Отбор.Колонки.Добавить("Значение");
	Отбор.Колонки.Добавить("Использование");
	
	СтрокаОтбора = Отбор.Добавить();
	СтрокаОтбора.Имя           = "Поставщик";
	СтрокаОтбора.Значение      = РеквизитыЛицензии.Владелец;
	СтрокаОтбора.Использование = Истина;
	
	СтрокаОтбора = Отбор.Добавить();
	СтрокаОтбора.Имя           = "ВидЛицензии";
	СтрокаОтбора.Значение      = РеквизитыЛицензии.ВидЛицензии;
	СтрокаОтбора.Использование = Истина;
	
	СтрокаОтбора = Отбор.Добавить();
	СтрокаОтбора.Имя           = "Период";
	СтрокаОтбора.Значение      = РеквизитыЛицензии.ДатаНачала;
	СтрокаОтбора.Использование = Истина;
	
	Если Не ЗначениеЗаполнено(СтрокаОтбора.Значение) Тогда
		Значение = Дата(1980, 1, 1);
	КонецЕсли;
	
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Ссылка");
	Строки.Колонки.Добавить("Поставщик");
	Строки.Колонки.Добавить("ВидЛицензии");
	Строки.Колонки.Добавить("Период");
	Строки.Колонки.Добавить("ДатаОкончания");
	Строки.Колонки.Добавить("КемВыдана");
	Строки.Колонки.Добавить("СерияНомер");
	
	Если Не ЭтоУдаление Тогда
	
		Строка = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, РеквизитыЛицензии);
		Строка.Поставщик  = РеквизитыЛицензии.Владелец;
		Строка.Период     = РеквизитыЛицензии.ДатаНачала;
		Строка.СерияНомер = РеквизитыЛицензии.Наименование;
		
	КонецЕсли;
	
	// Выгрузка набора записей
	// создаем виртуальный набор записей
	НаборЗаписей = Новый Структура("Отбор, Строки");
	НаборЗаписей.Отбор  = Отбор;
	НаборЗаписей.Строки = Строки;
	
	ВыгрузитьРегистр(НаборЗаписей, , , Истина, "ЛицензииПоставщиковАлкогольнойПродукции");
	
	Отказ = Истина;

КонецПроцедуры

Процедура ВыгрузитьПодразделениеОрганизации(ИсточникДанных) Экспорт

	ВыгрузитьПоПравилу(ИсточникДанных,,,,"ПодразделенияОрганизаций");

КонецПроцедуры

Процедура ВыгрузкаНоменклатуры(ОбъектКоллекции, ИмяПКО, Значение, ИсходящиеДанные) Экспорт

	Если ОбъектКоллекции.ПередатьИсходящиеДанные Тогда
		Значение = ОбъектКоллекции.Характеристика;
		ИсходящиеДанные = Новый Структура("Номенклатура", ОбъектКоллекции.Номенклатура);
		Если ТипЗнч(ОбъектКоллекции.Характеристика.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
			ВыгрузитьОбъект = Истина;
			ИмяПКО = "ХарактеристикиНоменклатурыОбщиеДляВида";
		Иначе
			ИмяПКО = "ХарактеристикиНоменклатуры";
		КонецЕсли;	
	Иначе
		ИмяПКО = "Номенклатура";
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьОРП(Объект, Параметры, ИмяПКОДокументаОснования) Экспорт

	СписокВидовОплаты = Новый СписокЗначений;
	СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ЗачетАванса"));
	СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ОплатаВрассрочку"));
	СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.БанковскийПлатеж"));
	
	ПередаватьЦеныХарактеристик = Параметры.РеквизитыУзла.ПередаватьЦеныХарактеристик;
	ТаблицаВозвратовОплат 		= Новый ТаблицаЗначений;
	МенеджерВременныхТаблиц 	= Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.Текст;
	Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.Текст = СтрЗаменить(ТекстЗапроса, "И ВЫБОР КОГДА &Патент
		|ТОГДА Док.СистемаНалогообложения = ЗНАЧЕНИЕ(перечисление.ТипыСистемНалогообложенияККТ.Патент)
		|ИНАЧЕ Док.СистемаНалогообложения <> ЗНАЧЕНИЕ(перечисление.ТипыСистемНалогообложенияККТ.Патент)
		|КОНЕЦ", "");
	
	Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
	
	РезультатыЗапросаВозвраты = Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.ВыполнитьПакет();
	
	ТаблицаПромежуточная = Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.МенеджерВременныхТаблиц.Таблицы["ТаблицаПромежуточная"].ПолучитьДанные().Выгрузить();
	
	ЕстьВозвратыНеВТекущуюСмену = ТаблицаПромежуточная.Найти(Истина, "ЭтоВозвратПослеЗакрытияСмены");
	ВыгружатьВозврат = ?(ЕстьВозвратыНеВТекущуюСмену = Неопределено, Ложь, Истина);
	Если НЕ ВыгружатьВозврат Тогда
		МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	
	Если ТаблицаПромежуточная.Количество() = 0 Тогда // Нет Чеков или ОРП загружен из ККМОффлайн.
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("ПередаватьЦеныХарактеристик", ПередаватьЦеныХарактеристик);
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("КонтрагентСклад", Объект.Магазин);
		РезультатыЗапроса = Запросы.ОтчетОРозничныхПродажах.ВыполнитьПакет();
		Если Не РезультатыЗапроса[7].Пустой() Тогда
			ТаблицаВозвратовОплат =	РезультатыЗапроса[7].Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	Если ВыгружатьВозврат Тогда
		
		ЗапросВозвратыОплат = Новый Запрос;
		ЗапросВозвратыОплат.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
		ЗапросВозвратыОплат.Текст = " 
		|ВЫБРАТЬ
		|	&КонтрагентСклад КАК Контрагент,
		|	СУММА(ЧекККМОплата.Сумма) КАК СуммаДокумента
		|ИЗ
		|	Документ.ЧекККМ.Оплата КАК ЧекККМОплата
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			Док.Ссылка КАК Ссылка,
		|			Док.ВидОперации КАК ВидОперации
		|		ИЗ
		|			ТаблицаПромежуточная КАК Док
		|		ГДЕ
		|			Док.ЭтоВозвратПослеЗакрытияСмены) КАК ЧекККМ
		|		ПО ЧекККМОплата.Ссылка = ЧекККМ.Ссылка
		|ГДЕ
		|	ЧекККМОплата.Ссылка.ОтчетОРозничныхПродажах = &Ссылка
		|	И ЧекККМОплата.ВидОплаты.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЧекККМОплата.Сумма) > 0
		|";
		ЗапросВозвратыОплат.УстановитьПараметр("Ссылка", Объект.Ссылка);
		ЗапросВозвратыОплат.УстановитьПараметр("КонтрагентСклад", Объект.Магазин);
	
		ТаблицаВозвратовОплат = ЗапросВозвратыОплат.Выполнить().Выгрузить();
		
		МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	
	Если ТаблицаВозвратовОплат.Количество() > 0 Тогда
		ХозОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(ХозОперация);
	
		Для каждого Строка Из ТаблицаВозвратовОплат Цикл
			
			ВходящиеДанные = Новый Структура;
			ВходящиеДанные.Вставить("Номер", 			Объект.Номер);
			ВходящиеДанные.Вставить("ВидОперации", 		"ВозвратРозничномуПокупателю");
			ВходящиеДанные.Вставить("ИмяПКО", 			ИмяПКОДокументаОснования);
			ВходящиеДанные.Вставить("ДокументОснование",Объект.Ссылка);
			ВходящиеДанные.Вставить("НомерЧекаККМ", 	Неопределено);
			ВходящиеДанные.Вставить("Контрагент", 		Строка.Контрагент);
			ВходящиеДанные.Вставить("СуммаДокумента", 	Строка.СуммаДокумента);
			
			ТаблицаРасшифровки = Новый ТаблицаЗначений;
			ТаблицаРасшифровки.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
			ТаблицаРасшифровки.Колонки.Добавить("Сумма");
			ТаблицаРасшифровки.Колонки.Добавить("СуммаПлатежа");
			ТаблицаРасшифровки.Колонки.Добавить("СуммаВзаиморасчетов");
			
			СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
			СтрокаРасшифровки.Сумма = Строка.СуммаДокумента;
			СтрокаРасшифровки.СуммаПлатежа = Строка.СуммаДокумента;
			СтрокаРасшифровки.СуммаВзаиморасчетов = Строка.СуммаДокумента;
			СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = ?(ЗначениеЗаполнено(СтатьяДДС), СтатьяДДС, Неопределено);
					
			ВходящиеДанные.Вставить("РасшифровкаПлатежа", ТаблицаРасшифровки);
			ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "РКО_ОтчетОРозничныхПродажах");
		КонецЦикла;
	КонецЕсли;
	
	//54ФЗ
	//
	СуммаБезналичнойОплаты 	= Объект.ОплатаПлатежнымиКартами.Итог("Сумма");
	СуммаНаличнойОплаты  	= Объект.СуммаДокумента - СуммаБезналичнойОплаты - Объект.ОплатаБанковскимиКредитами.Итог("Сумма") - Объект.ОплатаПодарочнымиСертификатами;
	СуммаВозвратов			= Объект.СуммаВозвратов;			
	РасчетыСКлиентами 		= Объект.РасчетыСКлиентами.Количество() > 0;
	
	Если СуммаНаличнойОплаты <> 0
		Или СуммаБезналичнойОплаты <> 0
		Или СуммаВозвратов <> 0
		Или РасчетыСКлиентами Тогда
		
		МВТ = Новый МенеджерВременныхТаблиц;
		
		ЗапросЧЕКИ54ФЗ = Новый Запрос;
		ЗапросЧЕКИ54ФЗ.МенеджерВременныхТаблиц = МВТ;
		ЗапросЧЕКИ54ФЗ.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
		ЗапросЧЕКИ54ФЗ.УстановитьПараметр("Ссылка", Объект.Ссылка);
		ЗапросЧЕКИ54ФЗ.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЧекККМ.Ссылка КАК Ссылка,
		|	ЧекККМ.Номер КАК Номер,
		|	ЧекККМ.НомерЧекаККМ КАК НомерЧекаККМ
		|ПОМЕСТИТЬ ЧЕКИ54ФЗ
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		|		ПО РасчетыСКлиентами.Регистратор = ЧекККМ.ОтчетОРозничныхПродажах
		|ГДЕ
		|	ЧекККМ.ОтчетОРозничныхПродажах = &Ссылка
		|	И (ЧекККМ.Оплата.ВидОплаты В (&ВидОплаты)
		|			ИЛИ ЧекККМ.ОперацияСДенежнымиСредствами = ИСТИНА)
		|";
		
		Результат = ЗапросЧЕКИ54ФЗ.Выполнить();
		ЧЕКИ54ФЗ = ЗапросЧЕКИ54ФЗ.МенеджерВременныхТаблиц.Таблицы["ЧЕКИ54ФЗ"].ПолучитьДанные().Выгрузить();
		ОбработатьЧЕКИ54ФЗ = ?(ЧЕКИ54ФЗ.Количество() > 0, Истина, Ложь);
		Если Не ОбработатьЧЕКИ54ФЗ Тогда
			МВТ.Закрыть();
		КонецЕсли;
		
		Если ОбработатьЧЕКИ54ФЗ Тогда
			СуммаОформлено = 0;
			Запросы.ОтчетОРозничныхПродажах_54ФЗ.УстановитьПараметр("Ссылка", Объект.Ссылка);
			Запросы.ОтчетОРозничныхПродажах_54ФЗ.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
			Запросы.ОтчетОРозничныхПродажах_54ФЗ.УстановитьПараметр("ПередаватьЦеныХарактеристик", ПередаватьЦеныХарактеристик);
			Запросы.ОтчетОРозничныхПродажах_54ФЗ.МенеджерВременныхТаблиц = МВТ;
			РезультатыЗапроса = Запросы.ОтчетОРозничныхПродажах_54ФЗ.ВыполнитьПакет();
			МВТ.Закрыть();
			Для Индекс = 7 по РезультатыЗапроса.ВГраница() Цикл
				Если НЕ РезультатыЗапроса[Индекс].Пустой() Тогда
					ТаблицаЗначений = РезультатыЗапроса[Индекс].Выгрузить();
					Реализация	= ТаблицаЗначений.Колонки.Найти("Реализация");
					Если Реализация = Неопределено Тогда
						ПКО 		= ТаблицаЗначений.Колонки.Найти("ПКО");
						Аванс		= ТаблицаЗначений.Колонки.Найти("Аванс");
						Для каждого Строка Из ТаблицаЗначений Цикл
							
							Сумма = ?(Строка.СуммаДокумента < 0, -Строка.СуммаДокумента, Строка.СуммаДокумента);
							ХозОперацияСтрокой = ?(Строка.СуммаДокумента < 0, "ВозвратПокупателю", "ОплатаПокупателя");
							
							Если ХозОперацияСтрокой = СокрЛП("ВозвратПокупателю") Тогда
								ХозОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
							ИначеЕсли ХозОперацияСтрокой = СокрЛП("ОплатаПокупателя") Тогда
								ХозОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
							КонецЕсли;
							
							СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(ХозОперация);
							
							ВходящиеДанные = Новый Структура;
							ВходящиеДанные.Вставить("Номер", 			Строка.НомерДокумента);
							ВходящиеДанные.Вставить("Контрагент", 		Строка.Контрагент);
							ВходящиеДанные.Вставить("СуммаДокумента", 	Сумма);
							ВходящиеДанные.Вставить("ВидОперации", 		ХозОперацияСтрокой);
							ВходящиеДанные.Вставить("НомерЧекаККМ", 	Строка.НомерЧекаККМ);
							
							ТаблицаРасшифровки = Новый ТаблицаЗначений;
							ТаблицаРасшифровки.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
							ТаблицаРасшифровки.Колонки.Добавить("Сумма");
							ТаблицаРасшифровки.Колонки.Добавить("СуммаПлатежа");
							ТаблицаРасшифровки.Колонки.Добавить("СуммаВзаиморасчетов");
							
							СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
							СтрокаРасшифровки.Сумма = Сумма;
							СтрокаРасшифровки.СуммаПлатежа = Сумма;
							СтрокаРасшифровки.СуммаВзаиморасчетов = Сумма;
							СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = ?(ЗначениеЗаполнено(СтатьяДДС), СтатьяДДС, Неопределено);
							
							ВходящиеДанные.Вставить("РасшифровкаПлатежа", ТаблицаРасшифровки);
							
							Если ПКО <> Неопределено Тогда
								Если Строка.СуммаДокумента < 0 Тогда //Возврат ДС без передачи товаров
									ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "РКО_ОтчетОРозничныхПродажах");
									Продолжить;
								КонецЕсли;
								
								ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, ?(Аванс = Неопределено, "ПКО_ОтчетОРозничныхПродажах_Предоплата" ,"ПКО_ОтчетОРозничныхПродажах_Аванс"));
								СуммаОформлено = СуммаОформлено + Сумма;
							Иначе
								ВходящиеДанные.Вставить("ВидОплаты", Строка.ВидОплаты);
								ВходящиеДанные.Вставить("Эквайер", Строка.Эквайер);							
								Если Строка.СуммаДокумента < 0 Тогда //Возврат ДС без передачи товаров
									ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ЭО_ОтчетОРозничныхПродажах_Возврат");
									Продолжить;
								КонецЕсли;
								
								ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, ?(Аванс = Неопределено, "ЭО_ОтчетОРозничныхПродажах_Аванс" ,"ЭО_ОтчетОРозничныхПродажах_Предоплата"));
							КонецЕсли;
						КонецЦикла;
					Иначе    
						
						//Реализация
						Для Каждого Строка Из ТаблицаЗначений Цикл
							
							ТаблицаТоварыИУслуги = Строка.Реализация.Товары.Выгрузить();
	
							ТаблицаТоварыИУслуги.Колонки.Добавить("ТипНоменклатуры");
							ТаблицаТоварыИУслуги.Колонки.Добавить("ПередатьИсходящиеДанные");
							
							Для Каждого СтрокаТаблицы Из ТаблицаТоварыИУслуги Цикл
								ТипНоменклатуры = СтрокаТаблицы.Номенклатура.ТипНоменклатуры;
								СтрокаТаблицы.ТипНоменклатуры = ТипНоменклатуры;
								СтрокаТаблицы.ПередатьИсходящиеДанные = ПередаватьЦеныХарактеристик И ЗначениеЗаполнено(СтрокаТаблицы.Характеристика);
							КонецЦикла;
							
							ОтборПоТоварам = Новый Структура("ТипНоменклатуры", ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар"));
							ОтборПоУслугам = Новый Структура("ТипНоменклатуры", ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
							ТаблицаТовары = ТаблицаТоварыИУслуги.Скопировать(ОтборПоТоварам);
							ТаблицаУслуги = ТаблицаТоварыИУслуги.Скопировать(ОтборПоУслугам);
							
							ВходящиеДанные = Новый Структура;
							ВходящиеДанные.Вставить("Товары", ТаблицаТовары);
							ВходящиеДанные.Вставить("Услуги", ТаблицаУслуги);
							ВходящиеДанные.Вставить("Номер", Строка.НомерДокумента);
							ВходящиеДанные.Вставить("Контрагент", Строка.Контрагент);
							ВходящиеДанные.Вставить("СуммаДокумента", Строка.СуммаДокумента);
							
							ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ОтчетОРозничныхПродажах_Реализация");
							
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Объект.СуммаОплатыНаличных > СуммаОформлено Тогда
				ВходящиеДанные = Новый Структура;
				ВходящиеДанные.Вставить("СуммаДокумента", Объект.СуммаОплатыНаличных - СуммаОформлено);
				ВходящиеДанные.Вставить("ИмяПКО", ИмяПКОДокументаОснования);
				ВходящиеДанные.Вставить("ДокументОснование", Объект.Ссылка);
				ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ПКО_АТТ_ОтчетОРозничныхПродажах");
			КонецЕсли;
			
		ИначеЕсли (Объект.СуммаОплатыНаличных > 0 ИЛИ ВыгружатьВозврат) Тогда
			
			ВходящиеДанные = Новый Структура;
			ВходящиеДанные.Вставить("СуммаДокумента", 0);
			ВходящиеДанные.Вставить("ИмяПКО", ИмяПКОДокументаОснования);
			ВходящиеДанные.Вставить("ДокументОснование", Объект.Ссылка);
			ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ПКО_АТТ_ОтчетОРозничныхПродажах");
			
		КонецЕсли;
		
	Иначе
		СсылкаНаУдаляемыйОбъект = Объект.Ссылка;
		ТипИсточника = "ДокументСсылка.ОтчетОРозничныхПродажах";
		ТипПриемника = "ДокументСсылка.ПриходныйКассовыйОрдер";
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, ТипПриемника, ТипИсточника);         
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьИВыгрузитьКонтрагентаИзОрганизации(ОрганизацияКонтрагента, НовыйКонтрагент) Экспорт

	Если ЗначениеЗаполнено(ОрганизацияКонтрагента) Тогда
		
		ИспользоватьОбменЭД = ПолучитьФункциональнуюОпцию("ИспользоватьОбменЭД");
		Если ИспользоватьОбменЭД Тогда
			СсылкаНаКонтрагента = ОбщегоНазначенияРТВызовСервера.ЗначениеРеквизитаОбъекта(ОрганизацияКонтрагента, "СобственныйКонтрагент");
		Иначе
			// Проверим, есть ли в базе контрагент, созданный по организации, если нету, то создадим его и выгрузим
			СсылкаНаКонтрагента = Справочники.Контрагенты.ПолучитьСсылку(ОрганизацияКонтрагента.УникальныйИдентификатор());
		КонецЕсли;
	
		Если НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаНаКонтрагента) Тогда
			
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.ПометкаУдаления		= ОрганизацияКонтрагента.ПометкаУдаления;
			НовыйКонтрагент.ИНН					= ОрганизацияКонтрагента.ИНН;
			НовыйКонтрагент.КодПоОКПО			= ОрганизацияКонтрагента.КодПоОКПО;
			НовыйКонтрагент.КПП					= ОрганизацияКонтрагента.КПП;
			НовыйКонтрагент.НаименованиеПолное	= ОрганизацияКонтрагента.НаименованиеПолное;
			НовыйКонтрагент.ЮрФизЛицо			= ОрганизацияКонтрагента.ЮрФизЛицо;
			НовыйКонтрагент.Наименование		= ОрганизацияКонтрагента.Наименование;
			НовыйКонтрагент.УстановитьСсылкуНового(СсылкаНаКонтрагента);
			НовыйКонтрагент.Записать();
			
			Параметры.СписокОбъектовСозданныхВТекущемСеансеОбмена.Добавить(НовыйКонтрагент.Ссылка);
			
			ВыгрузитьПоПравилу(НовыйКонтрагент,,,, "Контрагенты");
			НовыйКонтрагент = НовыйКонтрагент.Ссылка;
			
		Иначе
			НовыйКонтрагент = СсылкаНаКонтрагента;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
// Данный раздел изменять запрещено.

// Производит выгрузку объекта в соответствии с указанным правилом конвертации
//
// Параметры:
//  Источник				 - произвольный источник данных
//  Приемник				 - xml-узел объекта приемника
//  ВходящиеДанные			 - произвольные вспомогательные данные, передаваемые правилу
//                             для выполнения конвертации
//  ИсходящиеДанные			 - произвольные вспомогательные данные, передаваемые правилам
//                             конвертации свойств
//  ИмяПКО					 - имя правила конвертации, согласно которому осуществляется выгрузка
//
// Возвращаемое значение:
//  xml-узел ссылки или значение приемника
//
Функция ВыгрузитьПоПравилу(Источник					= Неопределено,
						   Приемник					= Неопределено,
						   ВходящиеДанные			= Неопределено,
						   ИсходящиеДанные			= Неопределено,
						   ИмяПКО					= "")
						   
	Возврат ОбщиеПроцедурыФункции.ВыгрузитьПоПравилу(Источник, Приемник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО);

КонецФункции

// Выгружает регистр по отбору.
// 
// Параметры:
//	НаборЗаписейДляВыгрузки - Структура или НаборЗаписей - Отбор
//
Процедура ВыгрузитьРегистр(НаборЗаписейДляВыгрузки, 
							Правило = Неопределено, 
							ВходящиеДанные = Неопределено, 
							НеВыгружатьОбъектыПоСсылкам = Ложь, 
							ИмяПКО = "",
