Процедура ПКС_СчетФактураПолученный_ДоговорКонтрагента_ПередВыгрузкойСвойства_16_21(ФайлОбмена, Источник, Приемник, ВходящиеДанные, ИсходящиеДанные,
	ПКС, ПКО, ОбъектКоллекции, Отказ, Значение, ТипПриемника, ИмяПКО,
	ИмяПКОВидСубконто, Пусто, Выражение, УзелКоллекцииСвойств, НеЗамещать,
	ВыгрузитьОбъект) Экспорт

	ДокументОснование = Источник.ДокументыОснования[0].ДокументОснование;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ЭтоКомиссия = Ложь;	
		Значение 	= Новый Структура;
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
			
			ЭтоКомиссия = ДокументОснование.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию;
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ДоговорыКонтрагентов.СпособРасчетаКомиссионногоВознаграждения КАК СпособРасчета,
			|	ДоговорыКонтрагентов.ПроцентКомиссионногоВознаграждения КАК Процент
			|ИЗ
			|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|		ПО (ПоступлениеТоваров.Договор = ДоговорыКонтрагентов.Ссылка)
			|ГДЕ
			|	ПоступлениеТоваров.Ссылка = &Ссылка
			|");
			Запрос.УстановитьПараметр("Ссылка", ДокументОснование.Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Значение.Вставить("ПроцентКомиссионногоВознаграждения", 		Выборка.Процент);
				Значение.Вставить("СпособРасчетаКомиссионногоВознаграждения", 	Выборка.СпособРасчета);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			Контрагент = ДокументОснование.Организация.СобственныйКонтрагент;
		Иначе
			Контрагент = ДокументОснование.Контрагент;
		КонецЕсли;
		
		Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
		
			Значение.Вставить("Ссылка");
			Значение.Вставить("ВидДоговора", ?(ЭтоКомиссия, "СКомитентом", "СПоставщиком"));
			Значение.Вставить("Владелец",    Контрагент);
			Значение.Вставить("Организация", Источник.Организация);
			
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

