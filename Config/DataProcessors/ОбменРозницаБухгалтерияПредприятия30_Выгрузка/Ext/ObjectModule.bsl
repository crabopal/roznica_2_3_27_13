	Если ВходящиеДанные <> Неопределено И ТипЗнч(ВходящиеДанные) = Тип("Структура")	Тогда
		ВходящиеДанные.Вставить("ИмяПКО",Строка(ИмяПКО));
	Иначе
		Отказ = Истина;
	КонецЕсли;

