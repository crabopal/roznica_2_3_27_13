	МенеджерВременныхТаблиц.Закрыть();
	
	Отказ = РезультатЗапроса[0].Пустой() И РезультатЗапроса[1].Пустой() И РезультатЗапроса[2].Пустой()
		И РезультатЗапроса[3].Пустой() И РезультатЗапроса[4].Пустой()
			И РезультатЗапроса[5].Пустой() И РезультатЗапроса[6].Пустой();
	Если Не Отказ Тогда
		ВходящиеДанные.Вставить("Товары", 					РезультатЗапроса[0].Выгрузить());
		ВходящиеДанные.Вставить("Оплата", 					РезультатЗапроса[1].Выгрузить());
		ВходящиеДанные.Вставить("АгентскиеУслуги", 			РезультатЗапроса[2].Выгрузить());
		ВходящиеДанные.Вставить("ПодарочныеСертификаты", 	РезультатЗапроса[3].Выгрузить());
		ВходящиеДанные.Вставить("Возвраты", 				РезультатЗапроса[4].Выгрузить());
		ВходящиеДанные.Вставить("ВозвратОплаты", 			РезультатЗапроса[5].Выгрузить());
		Строка = Параметры.ТаблицаВыгруженныхОРП.Добавить();
		Строка.ИмяПКО = "ОтчетОРозничныхПродажах";
		Строка.Объект = Источник.Ссылка;
	ИначеЕсли РезультатЗапроса[7].Пустой() Тогда
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("ПередаватьЦеныХарактеристик", Параметры.РеквизитыУзла.ПередаватьЦеныХарактеристик);
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("КонтрагентСклад", Источник.Магазин);
		РезультатыЗапроса = Запросы.ОтчетОРозничныхПродажах.ВыполнитьПакет();
		
		Отказ = РезультатыЗапроса[0].Пустой() И РезультатыЗапроса[1].Пустой()
			И РезультатыЗапроса[2].Пустой() И РезультатыЗапроса[3].Пустой()
				И РезультатыЗапроса[4].Пустой() И РезультатыЗапроса[5].Пустой();
				
		Если Не Отказ Тогда
			ВходящиеДанные.Вставить("Товары", 					РезультатыЗапроса[0].Выгрузить());
			ВходящиеДанные.Вставить("Возвраты", 				РезультатыЗапроса[1].Выгрузить());
			ВходящиеДанные.Вставить("Оплата", 					РезультатыЗапроса[2].Выгрузить());
			ВходящиеДанные.Вставить("ВозвратОплаты", 			РезультатыЗапроса[3].Выгрузить());
			ВходящиеДанные.Вставить("АгентскиеУслуги", 			РезультатыЗапроса[4].Выгрузить());
			ВходящиеДанные.Вставить("ПодарочныеСертификаты", 	РезультатыЗапроса[5].Выгрузить());
			
			ВходящиеДанные.Удалить("Патент"); // Для ОРП без чеков определяется по Организации и Магазину.
			Строка = Параметры.ТаблицаВыгруженныхОРП.Добавить();
			Строка.ИмяПКО = "ОтчетОРозничныхПродажах";
			Строка.Объект = Источник.Ссылка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ОтчетОРозничныхПродажах_Патент_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
