////////////////////////////////////////////////////////////////////////////////
// АЛГОРИТМЫ
// Данный раздел разрешено изменять.
// Также допустимо размещать процедуры с алгоритмами в любом из разделов выше.

Процедура ЗаполнитьВидПродукцииИС(ПараметрыОбъекта, Объект) Экспорт

	Если ПараметрыОбъекта <> Неопределено Тогда
	
		Значение = ПараметрыОбъекта["ВидПродукцииИС"];
		
		ВидПродукцииИС = XMLЗначение(Тип("ПеречислениеСсылка.ВидыПродукцииИС"), Значение);
		
		Если ЗначениеЗаполнено(ВидПродукцииИС) Тогда
		
			СтрокаЗаписи = РегистрыСведений.ОписаниеНоменклатурыИС.СоздатьМенеджерЗаписи();
			СтрокаЗаписи.Номенклатура = Объект.Ссылка;
			СтрокаЗаписи.Прочитать();
			
			Если Не СтрокаЗаписи.Выбран() Тогда
				СтрокаЗаписи.Номенклатура = Объект.Ссылка;
			КонецЕсли;
			
			СтрокаЗаписи.КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.КлючПоЗначениюПеречисления(
				ВидПродукцииИС,
				Неопределено,
				Объект.ВидАлкогольнойПродукцииЕГАИС.Маркируемый);
	
			Если ЗначениеЗаполнено(СтрокаЗаписи.КлючВидовПродукции) Тогда	
				Попытка
					СтрокаЗаписи.Записать();
				Исключение
					ИмяСобытия = НСтр("ru = 'Не удалось записать Описание номенклатуры ИС по товару %1'",
						ОбщегоНазначения.КодОсновногоЯзыка());
					ИмяСобытия = СтрШаблон(ИмяСобытия, Объект.Ссылка);
					
					ЗаписьЖурналаРегистрации(ИмяСобытия,
						УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

