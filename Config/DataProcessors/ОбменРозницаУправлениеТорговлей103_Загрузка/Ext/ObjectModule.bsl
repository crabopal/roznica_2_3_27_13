Процедура ПКО_СписаниеТоваров_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	ЗаполнитьРеквизитОтветственный (Объект);
	ЗаполнитьСкладПоступления (Объект);
	ЗаполнитьСтатусыУказанияСерий (Объект);
	Аналитика =Перечисления.ХозяйственныеОперации.СписаниеНаЗатраты;
	ЗаполнитьДДСВШапке (Объект, Аналитика);
	
	Если ПараметрыОбъекта <> Неопределено Тогда
		УИ = ПараметрыОбъекта.Получить("УИ");
		Если УИ <> Неопределено Тогда
			ПересортицаТоваров = Документы.ПересортицаТоваров.ПолучитьСсылку(УИ);
			Отказ = НЕ ПересортицаТоваров.ПолучитьОбъект() = Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если НЕ Отказ Тогда
		ЦеныРассчитаны = ЗапасыСервер.ЗаполнитьЦеныПоСебестоимости(Объект, "Товары", Объект.Дата);
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_УпаковкиНоменклатуры_ПоследовательностьПолейПоиска(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск,
	СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, СтрокаИменСвойствПоиска) Экспорт

	Владелец         = СвойстваПоиска.Получить("Владелец");
	Коэффициент      = СвойстваПоиска.Получить("Коэффициент");
	ЕдиницаИзмерения = СвойстваПоиска.Получить("ЕдиницаИзмерения");
	Наименование     = СвойстваПоиска.Получить("Наименование");
	ПрекратитьПоиск = Истина;
	СсылкаНаОбъект = Неопределено;
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|   УпаковкиНоменклатуры.Ссылка КАК Упаковка
		|ИЗ
		|   Справочник.УпаковкиНоменклатуры КАК УпаковкиНоменклатуры
		|ГДЕ
		|   УпаковкиНоменклатуры.Владелец = &Владелец
		|   И УпаковкиНоменклатуры.Наименование = &Наименование
		|   И УпаковкиНоменклатуры.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|   И УпаковкиНоменклатуры.Коэффициент = &Коэффициент";
		Если НЕ Владелец.НаборУпаковок.Пустая()
			И Владелец.НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
			Владелец = Владелец.НаборУпаковок;
		КонецЕсли;
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
		Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
		Запрос.УстановитьПараметр("Наименование", Наименование);
		Запрос.УстановитьПараметр("Владелец", Владелец);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СсылкаНаОбъект = ВыборкаДетальныеЗаписи.Упаковка;
		Иначе
			СвойстваПоиска.Вставить("Владелец",Владелец);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

