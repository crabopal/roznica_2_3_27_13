Процедура ЗаполнитьСтатьиДДС(Объект, ИмяТЧ) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	| СтатьиДвиженияДенежныхСредств.Ссылка КАК СтатьяДвиженияДенежныхСредств,
	| ВЫБОР
	|     КОГДА СтатьиДвиженияДенежныхСредств.Предопределенный
	|         ТОГДА 0
	|     ИНАЧЕ 1
	| КОНЕЦ КАК Порядок
	|ИЗ
	| Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	| НЕ СтатьиДвиженияДенежныхСредств.ПометкаУдаления
	| И СтатьиДвиженияДенежныхСредств.ХозяйственнаяОперация = &ХозяйственнаяОперация
	|
	|УПОРЯДОЧИТЬ ПО
	| Порядок");
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", Объект.ХозяйственнаяОперация);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		СтатьяДвиженияДенежныхСредств = Выборка.СтатьяДвиженияДенежныхСредств;
		Для каждого Строка Из Объект[ИмяТЧ] Цикл
			Если НЕ ЗначениеЗаполнено(Строка.СтатьяДвиженияДенежныхСредств) Тогда
				Строка.СтатьяДвиженияДенежныхСредств = СтатьяДвиженияДенежныхСредств;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
		СтатьяДДС.ХозяйственнаяОперация = Объект.ХозяйственнаяОперация;
		СтатьяДДС.Наименование = СтатьяДДС.Наименование = Строка(Объект.ХозяйственнаяОперация);
		СтатьяДДС.Записать();
		СтатьяДвиженияДенежныхСредств = СтатьяДДС.Ссылка;
		Для каждого Строка Из Объект[ИмяТЧ] Цикл
			Строка.СтатьяДвиженияДенежныхСредств = СтатьяДвиженияДенежныхСредств;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьДДСВШапке(Объект, Аналитика) Экспорт

	Если НЕ ЗначениеЗаполнено(Объект.АналитикаХозяйственнойОперации) Тогда
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	| АналитикаХозяйственныхОпераций.Ссылка,
	| ВЫБОР
	|     КОГДА АналитикаХозяйственныхОпераций.Предопределенный
	|         ТОГДА 0
	|     ИНАЧЕ 1
	| КОНЕЦ КАК Порядок
	|ИЗ
	| Справочник.АналитикаХозяйственныхОпераций КАК АналитикаХозяйственныхОпераций
	|ГДЕ
	| НЕ АналитикаХозяйственныхОпераций.ПометкаУдаления
	| И АналитикаХозяйственныхОпераций.ХозяйственнаяОперация = &ХозяйственнаяОперация
	|
	|УПОРЯДОЧИТЬ ПО
	| Порядок");
		Запрос.УстановитьПараметр("ХозяйственнаяОперация", Аналитика);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Объект.АналитикаХозяйственнойОперации = Выборка.Ссылка; 
		Иначе
			АналитикаХО = Справочники.АналитикаХозяйственныхОпераций.СоздатьЭлемент();
			АналитикаХО.ХозяйственнаяОперация = Аналитика;
			АналитикаХО.Наименование = Строка(Аналитика);
			АналитикаХО.Записать();
			Объект.АналитикаХозяйственнойОперации = АналитикаХО.Ссылка; 
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьМагазинПоУмолчанию(Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   Магазины.Ссылка КАК МагазинККМ
	|ИЗ
	|   Справочник.Магазины КАК Магазины
	|ГДЕ
	|   Магазины.СкладПродажи.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Объект.Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Объект.Магазин = ВыборкаДетальныеЗаписи.МагазинККМ;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитОтветственный(Объект) Экспорт

	Если Объект.Ответственный.Пустая() Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСкладПоступления(Объект) Экспорт

	 Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПоступления");
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПоступления;
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Неопределено
				И ЗначениеЗаполнено(РеквизитМагазин)
				И РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСкладПродажи(Объект) Экспорт

	 Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПродажи");
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПродажи;
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Неопределено
				И ЗначениеЗаполнено(РеквизитМагазин)
				И РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСкладПродажиВТЧ(Объект, ИмяТЧ) Экспорт

	Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПродажи");
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Склад = Справочники.Склады.ПустаяСсылка();
		Иначе
			Склад = СтруктураРеквизитов.СкладПродажи;
		КонецЕсли;
		Для каждого Строка Из Объект[ИмяТЧ] Цикл
			Строка.Склад = Склад;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСтатусыУказанияСерий(Объект) Экспорт

	Если РежимЗагрузкиДанныхВИнформационнуюБазу() Тогда
			ИмяДокумента = Объект.Метаданные().Имя;
			Если ИмяДокумента = "СборкаТоваров" Тогда
				ПараметрыУказанияСерий = Документы[ИмяДокумента].ПараметрыУказанияСерий(Объект);
				Если ПараметрыУказанияСерий.Свойство("ТЧ") Тогда
					ПараметрыУказанияСерий = ПараметрыУказанияСерий.ТЧ;
				КонецЕсли;
			Иначе
				ПараметрыУказанияСерий = Документы[ИмяДокумента].ПараметрыУказанияСерий(Объект);
			КонецЕсли;
		ОбработкаТабличнойЧастиТоварыСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
		ОбщегоНазначенияРТ.УдалитьНеиспользуемыеСтрокиСерий(Объект, ПараметрыУказанияСерий);
	КонецЕсли;

КонецПроцедуры

