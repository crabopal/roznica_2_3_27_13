			ИмяПКО = "ЕдиницыИзмеренияОбщие";
		Иначе
			ИмяПКО = "ЕдиницыИзмеренияИндивидуальные";
		    Значение = Упаковка;
		КонецЕсли;
	Иначе
		ИмяПКО = "ЕдиницыИзмеренияПоУмолчанию";
