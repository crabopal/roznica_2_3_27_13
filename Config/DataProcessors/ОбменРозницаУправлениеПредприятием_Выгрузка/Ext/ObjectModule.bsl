Процедура Конвертация_ПередВыгрузкойДанных(ФайлОбмена, Отказ) Экспорт

	Параметры.Вставить("ИспользоватьДополнительныеРеквизитыИСведения", Константы.ИспользоватьДополнительныеРеквизитыИСведения.Получить());
	Параметры.Вставить("ИспользоватьУпаковкиНоменклатуры", Константы.ИспользоватьУпаковкиНоменклатуры.Получить());

КонецПроцедуры

Процедура Конвертация_ПередКонвертациейОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены,ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Если ТипЗнч(ВходящиеДанные) <> Тип("Структура") Тогда
		ВходящиеДанные = Новый Структура;
	КонецЕсли;

КонецПроцедуры

Процедура Конвертация_ПередОтправкойИнформацииОбУдалении(Ссылка, Отказ) Экспорт

	СсылкаНаУдаляемыйОбъект = Ссылка;
	Если ТипЗнч(СсылкаНаУдаляемыйОбъект) = Тип("СправочникСсылка.УпаковкиНоменклатуры") Тогда
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, "СправочникСсылка.ЕдиницыИзмерения", "СправочникСсылка.УпаковкиНоменклатуры");
		Отказ = Истина;
	ИначеЕсли ТипЗнч(СсылкаНаУдаляемыйОбъект) = Тип("ДокументСсылка.ПересортицаТоваров") Тогда
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, "ДокументСсылка.СписаниеТоваров", "ДокументСсылка.ПересортицаТоваров");
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, "ДокументСсылка.ОприходованиеТоваров", "ДокументСсылка.ПересортицаТоваров");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

