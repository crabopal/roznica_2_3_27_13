Процедура ВыгрузитьДопРеквизиты(Объект) Экспорт

	Если Параметры.ИспользоватьДополнительныеРеквизитыИСведения Тогда
		СвойстваОтбор = Новый ТаблицаЗначений;
		СвойстваОтбор.Колонки.Добавить("Имя");
		СвойстваОтбор.Колонки.Добавить("Значение");
		СвойстваОтбор.Колонки.Добавить("Использование");
		
		СтрокаОтбора = СвойстваОтбор.Добавить();
		СтрокаОтбора.Имя           = "Объект";
		СтрокаОтбора.Значение      = Объект.Ссылка;
		СтрокаОтбора.Использование = Истина;
		
		СвойстваСтроки = Новый ТаблицаЗначений;
		СвойстваСтроки.Колонки.Добавить("Активность");
		СвойстваСтроки.Колонки.Добавить("Объект");
		СвойстваСтроки.Колонки.Добавить("Свойство");
		СвойстваСтроки.Колонки.Добавить("Значение");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизиты.Ссылка КАК Объект,
		|	ДополнительныеРеквизиты.Свойство,
		|	ДополнительныеРеквизиты.Значение,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	Справочник.#ИмяСправочника#.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
		|ГДЕ
		|	ДополнительныеРеквизиты.Ссылка = &Объект";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяСправочника#", Объект.Метаданные().Имя);
		
		Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СвойстваСтрока = СвойстваСтроки.Добавить();
			СвойстваСтрока.Активность	= Истина;
			СвойстваСтрока.Объект   = ВыборкаДетальныеЗаписи.Объект;
			СвойстваСтрока.Свойство = ВыборкаДетальныеЗаписи.Свойство;
			СвойстваСтрока.Значение = ВыборкаДетальныеЗаписи.Значение;
		КонецЦикла;
		
		СвойстваНаборЗаписей = Новый Структура("Отбор, Строки");
		СвойстваНаборЗаписей.Отбор  = СвойстваОтбор;
		СвойстваНаборЗаписей.Строки = СвойстваСтроки;
		
		ВыгрузитьРегистр(СвойстваНаборЗаписей, , , Истина, "ЗначенияСвойствОбъектовРС");
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьТаблицуТоварыБезНДС(Источник, ВходящиеДанные,ДокументЗапроса) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	| ДокументЗапросаТовары.Номенклатура,
	| ДокументЗапросаТовары.Характеристика КАК ХарактеристикаНоменклатуры,
	| ДокументЗапросаТовары.КоличествоУпаковок КАК Количество,
	| ДокументЗапросаТовары.Сумма,
	| ДокументЗапросаТовары.Упаковка,
	| ДокументЗапросаТовары.Цена,
	| 1 КАК Коэффициент
	|ИЗ
	| Документ.ДокументЗапроса.Товары КАК ДокументЗапросаТовары
	|     ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|     ПО ДокументЗапросаТовары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	| ДокументЗапросаТовары.Ссылка = &Ссылка
	| И СпрНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)");
	Если ДокументЗапроса = "ОприходованиеТоваров" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ДокументЗапросаТовары.Сумма,","ДокументЗапросаТовары.Сумма,
		| ДокументЗапросаТовары.Сумма КАК СуммаРегл,");
	КонецЕсли; 
	Если ДокументЗапроса = "ВозвратТоваровОтПокупателя" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"1 КАК Коэффициент","1 КАК Коэффициент,
		| ДокументЗапросаТовары.ДокументПродажи КАК ДокументПартии");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЗапроса", ДокументЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Товары =РезультатЗапроса.Выгрузить();
	ВходящиеДанные.Вставить("Товары", Товары);
	СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(Товары, Истина);
	ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);
	Если ДокументЗапроса = "ОприходованиеТоваров" Тогда
		ВходящиеДанные.Вставить("СуммаДокументаРегл", СуммаДокумента);
	КонецЕсли;

