	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		Отказ = Истина;
	ИначеЕсли ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.НаборыУпаковок") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка.НаборУпаковок = &ВладелецЕдиницыИзмерения";
		Запрос.УстановитьПараметр("ВладелецЕдиницыИзмерения", Объект.Владелец);
		ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаСНоменклатурой Из ТаблицаНоменклатуры Цикл
			ПараметрыЕдиницы = Новый Структура("Владелец", СтрокаСНоменклатурой.Ссылка);
			ВыгрузитьПоПравилу(Объект,, ПараметрыЕдиницы,, "ЕдиницыИзмеренияОбщие");
		КонецЦикла;
		Отказ = Истина;
	Иначе
		ИмяПКО = "ЕдиницыИзмеренияИндивидуальные";
