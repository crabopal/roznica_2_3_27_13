Процедура ПКС_ПереоценкаТоваровВРознице_Организация_ПередВыгрузкойСвойства_8_25(ФайлОбмена, Источник, Приемник, ВходящиеДанные, ИсходящиеДанные,
	ПКС, ПКО, ОбъектКоллекции, Отказ, Значение, ТипПриемника, ИмяПКО,
	ИмяПКОВидСубконто, Пусто, Выражение, УзелКоллекцииСвойств, НеЗамещать,
	ВыгрузитьОбъект) Экспорт

	ОбъектЦенообразования = Источник.ОбъектЦенообразования;
	Если ЗначениеЗаполнено(ОбъектЦенообразования) 
			И ТипЗнч(ОбъектЦенообразования) = Тип("СправочникСсылка.Магазины") Тогда
		СкладПродажи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектЦенообразования,"СкладПродажи");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|   Магазины.СкладПродажи.Организация КАК Организация
		|ИЗ
		|   Справочник.Магазины КАК Магазины
		|ГДЕ
		|   Магазины.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ОбъектЦенообразования);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Значение = ВыборкаДетальныеЗаписи.Организация;
			Если Значение.ОбособленноеПодразделение Тогда
				ИсточникДанных = Значение;
				ВыгрузитьПодразделениеОрганизации (ИсточникДанных);
				Значение = Значение.ГоловнаяОрганизация;
			КонецЕсли;
		Иначе
			Отказ = Истина;
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;

