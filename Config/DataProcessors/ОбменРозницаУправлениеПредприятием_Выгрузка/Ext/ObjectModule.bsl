Процедура ПВД_Номенклатура_ПослеВыгрузкиОбъекта(ФайлОбмена, Объект, ИмяПКО, ВходящиеДанные, ИсходящиеДанные, УзелСсылки) Экспорт

	Если НЕ Объект.ЭтоГруппа И ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		ПараметрыЕдиницы = Новый Структура("Владелец", Объект.Ссылка);
		ВыгрузитьПоПравилу(Объект.ЕдиницаИзмерения,,ПараметрыЕдиницы,,"ЕдиницыИзмеренияПоУмолчанию");
	КонецЕсли;
	НаборУпаковок = Объект.НаборУпаковок;
	Если Параметры.ИспользоватьУпаковкиНоменклатуры И ЗначениеЗаполнено(НаборУпаковок) 
		И НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УпаковкиНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.УпаковкиНоменклатуры КАК УпаковкиНоменклатуры
		|ГДЕ
		|	УпаковкиНоменклатуры.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", НаборУпаковок);
		ТаблицаУпаковок = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаСУпаковкой Из ТаблицаУпаковок Цикл
			ПараметрыЕдиницы = Новый Структура("Владелец", Объект.Ссылка);
			ВыгрузитьПоПравилу(СтрокаСУпаковкой.Ссылка,,ПараметрыЕдиницы,,"ЕдиницыИзмеренияОбщие");
		КонецЦикла;
	КонецЕсли;
	
	ВыгрузитьДопРеквизиты (Объект);

КонецПроцедуры

