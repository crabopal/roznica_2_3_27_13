Процедура ВыгрузитьУпаковкуВТЧТовары(ОбъектКоллекции, Значение, ИмяПКО, ИсходящиеДанные) Экспорт

	Значение = ОбъектКоллекции.Упаковка;
	ИсходящиеДанные = Новый Структура("Владелец", ОбъектКоллекции.Номенклатура);
	Если ЗначениеЗаполнено(Значение) И Параметры.ИспользоватьУпаковкиНоменклатуры Тогда
		Если ТипЗнч(Значение.Владелец) = Тип("СправочникСсылка.НаборыУпаковок") Тогда
			ИмяПКО = "ЕдиницыИзмеренияОбщие";	
		Иначе
			ИмяПКО = "ЕдиницыИзмеренияИндивидуальные";
		КонецЕсли;
	Иначе
		ИмяПКО = "ЕдиницыИзмеренияПоУмолчанию";
		Значение = ОбъектКоллекции.Номенклатура.ЕдиницаИзмерения;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Значение = Справочники.БазовыеЕдиницыИзмерения.НайтиПоКоду("796");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьКоэффициентЕдиницыИзмеренияВДокументе(Источник, Значение) Экспорт

	Если ЗначениеЗаполнено(Источник.Упаковка) Тогда
		Значение = Источник.Упаковка.Коэффициент;
	Иначе
		Значение = 1;
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьТаблицыТоварыУслуги(Источник, ВходящиеДанные,ДокументЗапроса) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	| ДокументЗапросаТовары.Номенклатура,
	| ДокументЗапросаТовары.Характеристика КАК ХарактеристикаНоменклатуры,
	| ДокументЗапросаТовары.КоличествоУпаковок КАК Количество,
	| ДокументЗапросаТовары.СтавкаНДС,
	| ДокументЗапросаТовары.СуммаНДС,
	| ДокументЗапросаТовары.Сумма,
	| ДокументЗапросаТовары.Упаковка,
	| ДокументЗапросаТовары.Цена,
	| 1 КАК Коэффициент
	|ИЗ
	| Документ.ДокументЗапроса.Товары КАК ДокументЗапросаТовары
	|     ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|     ПО ДокументЗапросаТовары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	| ДокументЗапросаТовары.Ссылка = &Ссылка
	| И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	| ДокументЗапросаТовары.Номенклатура,
	| ДокументЗапросаТовары.КоличествоУпаковок КАК Количество,
	| ДокументЗапросаТовары.СтавкаНДС,
	| ДокументЗапросаТовары.СуммаНДС,
	| ДокументЗапросаТовары.Сумма,
	| ДокументЗапросаТовары.Цена,
	| СпрНоменклатура.Представление КАК Содержание
	|ИЗ
	| Документ.ДокументЗапроса.Товары КАК ДокументЗапросаТовары
	|     ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|     ПО ДокументЗапросаТовары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	| ДокументЗапросаТовары.Ссылка = &Ссылка
	| И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
	
	Если ДокументЗапроса = "ВозвратТоваровОтПокупателя" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"1 КАК Коэффициент","1 КАК Коэффициент,
		| ДокументЗапросаТовары.ДокументПродажи КАК ДокументПартии");
		КонецЕсли;
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЗапроса", ДокументЗапроса);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		Товары =РезультатЗапроса[0].Выгрузить();
		Услуги =РезультатЗапроса[1].Выгрузить();
		ВходящиеДанные.Вставить("Товары", Товары);
		ВходящиеДанные.Вставить("Услуги", Услуги);
		СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(Товары, Источник.ЦенаВключаетНДС)
			+ ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(Услуги, Источник.ЦенаВключаетНДС);
		ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);

КонецПроцедуры

