Процедура ПВД_ОтчетОРозничныхПродажах_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если Объект.СерийныеНомера.Количество() > 0 Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЧекККМТовары.Ссылка КАК Ссылка,
		|	СУММА(ВЫБОР
		|		КОГДА ПодарочныеСертификаты.ПроизвольныйНоминал
		|			ТОГДА ЧекККМТовары.Сумма
		|		ИНАЧЕ ПодарочныеСертификаты.Номинал
		|	КОНЕЦ) КАК СуммаНоминалов
		|ПОМЕСТИТЬ ПродажаПС
		|ИЗ
		|	Справочник.Номенклатура КАК ПодарочныеСертификаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
		|		ПО ПодарочныеСертификаты.Ссылка = ЧекККМТовары.Номенклатура
		|ГДЕ
		|	ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах = &Ссылка
		|	И ПодарочныеСертификаты.ТипНоменклатуры = &ТипНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	ЧекККМТовары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЧекККМ.Ссылка КАК Ссылка,
		|	ЧекККМ.ВидОперации КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА ЧекККМ.ВидОперации = &ВидОперацииПродажа
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК КоэффициентВидаОплаты,
		|	ПродажаПС.СуммаНоминалов КАК СуммаНоминалов
		|ПОМЕСТИТЬ ТаблицаЧеков
		|ИЗ
		|	ПродажаПС КАК ПродажаПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		|		ПО ПродажаПС.Ссылка = ЧекККМ.Ссылка
		|ГДЕ
		|	ЧекККМ.ОтчетОРозничныхПродажах = &Ссылка
		|	И ЧекККМ.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЧекККМОплата.Ссылка КАК Ссылка,
		|	ЧекККМОплата.НомерСтроки КАК НомерСтроки,
		|	ЧекККМОплата.ВидОплаты КАК ВидОплаты,
		|	ЧекККМОплата.ВидОплаты.ТипОплаты КАК ТипОплаты,
		|	ЧекККМОплата.ВидОплаты.ПлатежнаяСистема КАК ПлатежнаяСистема,
		|	ЧекККМОплата.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
		|	ЧекККМОплата.Сумма КАК Сумма
		|ПОМЕСТИТЬ ТаблицаОплат
		|ИЗ
		|	Документ.ЧекККМ.Оплата КАК ЧекККМОплата
		|ГДЕ
		|	ЧекККМОплата.ВидОплаты.ТипОплаты В(&ТипОплатыПлатежнаяКарта)
		|	И ЧекККМОплата.Ссылка В
		|			(ВЫБРАТЬ
		|				ТаблицаЧеков.Ссылка
		|			ИЗ
		|				ТаблицаЧеков КАК ТаблицаЧеков)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОплат.ВидОплаты КАК ВидОплаты,
		|	ТаблицаОплат.ТипОплаты КАК ТипОплаты,
		|	ТаблицаОплат.ПлатежнаяСистема КАК ПлатежнаяСистема,
		|	ТаблицаОплат.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
		|	ВЫБОР
		|		КОГДА ТаблицаЧеков.СуммаНоминалов <= ТаблицаЧеков.КоэффициентВидаОплаты * ТаблицаОплат.Сумма
		|			ТОГДА ТаблицаЧеков.СуммаНоминалов
		|		ИНАЧЕ ТаблицаЧеков.КоэффициентВидаОплаты * ТаблицаОплат.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА ТаблицаЧеков.КоэффициентВидаОплаты * ТаблицаОплат.Сумма < 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоВозврат
		|ПОМЕСТИТЬ ПодготовительнаяТаблица
		|ИЗ
		|	ТаблицаОплат КАК ТаблицаОплат
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЧеков КАК ТаблицаЧеков
		|		ПО ТаблицаОплат.Ссылка = ТаблицаЧеков.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодготовительнаяТаблица.ТипОплаты КАК ТипОплаты,
		|	ПодготовительнаяТаблица.ПлатежнаяСистема КАК ПлатежнаяСистема,
		|	ПодготовительнаяТаблица.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
		|	СУММА(ПодготовительнаяТаблица.Сумма) КАК Сумма
		|ИЗ
		|	ПодготовительнаяТаблица КАК ПодготовительнаяТаблица
		|ГДЕ
		|	ПодготовительнаяТаблица.ЭтоВозврат = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ПодготовительнаяТаблица.ТипОплаты,
		|	ПодготовительнаяТаблица.ПлатежнаяСистема,
		|	ПодготовительнаяТаблица.ЭквайринговыйТерминал
		|
		|ИМЕЮЩИЕ
		|	СУММА(ПодготовительнаяТаблица.Сумма) <> 0
		|";
		
		ТипыОплаты = Новый СписокЗначений;
		ТипыОплаты.Добавить(Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта);
		ТипыОплаты.Добавить(Перечисления.ТипыОплатЧекаККМ.ПлатежнаяСистема);
	
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.ПодарочныйСертификат);
		Запрос.УстановитьПараметр("ВидОперацииПродажа"		, Перечисления.ВидыОперацийЧекККМ.Продажа);
		Запрос.УстановитьПараметр("ТипОплатыПлатежнаяКарта"	, ТипыОплаты);
	
		ОплатаПлатежнымиКартамиПС = Запрос.Выполнить().Выгрузить();
		ВходящиеДанные = Новый Структура;
		ВходящиеДанные.Вставить("ОплатаПлатежнымиКартамиПС", ОплатаПлатежнымиКартамиПС);
	
		ВыгрузитьПоПравилу(Объект, , ВходящиеДанные, , "РеализацияПодарочныхСертификатов");
	Иначе
		СсылкаНаУдаляемыйОбъект = Объект.Ссылка;
		ТипИсточника = "ДокументСсылка.ОтчетОРозничныхПродажах";
		ТипПриемника = "ДокументСсылка.РеализацияПодарочныхСертификатов";
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, ТипПриемника, ТипИсточника);
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_ОтчетОРозничныхПродажах_ПослеВыгрузкиОбъекта(ФайлОбмена, Объект, ИмяПКО, ВходящиеДанные, ИсходящиеДанные, УзелСсылки) Экспорт

	МВТ = Новый МенеджерВременныхТаблиц;
	ЗапросЧЕКИ54ФЗ = Новый Запрос;
	ЗапросЧЕКИ54ФЗ.МенеджерВременныхТаблиц = МВТ;
	СписокВидовОплаты = Новый СписокЗначений;
	СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ЗачетАванса"));
	СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ОплатаВрассрочку"));
	ЗапросЧЕКИ54ФЗ.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
	ЗапросЧЕКИ54ФЗ.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ЗапросЧЕКИ54ФЗ.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЧекККМ.Ссылка КАК Ссылка,
	|	ЧекККМ.Номер КАК Номер,
	|	ВЫБОР
	|		КОГДА ЧекККМ.НомерСменыККМ = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЧекККМ.НомерСменыККМ
	|	КОНЕЦ КАК НомерСменыККМ,
	|	ЧекККМ.НомерЧекаККМ КАК НомерЧекаККМ
	|ПОМЕСТИТЬ ЧЕКИ54ФЗ
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
	|		ПО РасчетыСКлиентами.Регистратор = ЧекККМ.ОтчетОРозничныхПродажах
	|ГДЕ
	|	ЧекККМ.ОтчетОРозничныхПродажах = &Ссылка
	|	И (ЧекККМ.Оплата.ВидОплаты В (&ВидОплаты)
	|			ИЛИ ЧекККМ.ОперацияСДенежнымиСредствами = ИСТИНА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЧЕКИ54ФЗ.Ссылка КАК Ссылка
	|ИЗ
	|	ЧЕКИ54ФЗ КАК ЧЕКИ54ФЗ";
	
	Выборка = ЗапросЧЕКИ54ФЗ.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запросы.ОтчетОРозничныхПродажах.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
		Запросы.ОтчетОРозничныхПродажах.МенеджерВременныхТаблиц = МВТ;
		РезультатыЗапроса = Запросы.ОтчетОРозничныхПродажах.ВыполнитьПакет();
		МВТ.Закрыть();
		Для Индекс = 7 по РезультатыЗапроса.ВГраница() Цикл
			Если НЕ РезультатыЗапроса[Индекс].Пустой() Тогда
				ТаблицаЗначений = РезультатыЗапроса[Индекс].Выгрузить();
				Реализация	= ТаблицаЗначений.Колонки.Найти("Реализация");
				Если Реализация = Неопределено Тогда
					ПКО 		= ТаблицаЗначений.Колонки.Найти("ПКО");
					Аванс		= ТаблицаЗначений.Колонки.Найти("ЗаказПокупателя");
					Для каждого Строка Из ТаблицаЗначений Цикл
						ВходящиеДанные = Новый Структура;
						ВходящиеДанные.Вставить("Номер", Строка.НомерДокумента);
						ВходящиеДанные.Вставить("Контрагент", Строка.Контрагент);
						ВходящиеДанные.Вставить("ДокументОснование", ?(Аванс = Неопределено, Неопределено, Строка.ЗаказПокупателя));
						ВходящиеДанные.Вставить("СуммаДокумента", ?(Строка.Сумма < 0, -Строка.Сумма, Строка.Сумма));
						ХозОперация = ?(Строка.Сумма < 0, Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту, Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента);
						ВходящиеДанные.Вставить("ХозяйственнаяОперация", ХозОперация);
						СтатьяДДС = ЗначениеНастроекПовтИсп.ПредопределеннаяСтатьяДвиженияДенежныхСредств(ХозОперация);
						ВходящиеДанные.Вставить("НомерСменыККМ", Строка.НомерСменыККМ);
						ВходящиеДанные.Вставить("НомерЧекаККМ", Строка.НомерЧекаККМ);
						
						ТаблицаРасшифровки = Новый ТаблицаЗначений;
						ТаблицаРасшифровки.Колонки.Добавить("Заказ");
						ТаблицаРасшифровки.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
						ТаблицаРасшифровки.Колонки.Добавить("Сумма");
						ТаблицаРасшифровки.Колонки.Добавить("СуммаВзаиморасчетов");
						СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
						СтрокаРасшифровки.Заказ = ?(Аванс = Неопределено, Неопределено, Строка.ЗаказПокупателя);
						СтрокаРасшифровки.Сумма = ?(Строка.Сумма < 0, -Строка.Сумма, Строка.Сумма);
						СтрокаРасшифровки.СуммаВзаиморасчетов = ?(Строка.Сумма < 0, -Строка.Сумма, Строка.Сумма);
						СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = ?(ЗначениеЗаполнено(СтатьяДДС), СтатьяДДС, Неопределено);
						ВходящиеДанные.Вставить("РасшифровкаПлатежа", ТаблицаРасшифровки);
						
						Если ПКО <> Неопределено Тогда
							Если Строка.Сумма < 0 Тогда //Возврат ДС без передачи товаров
								ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "РКО_ОтчетОРозничныхПродажах");
								Продолжить;
							КонецЕсли;
							
							ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, ?(Аванс = Неопределено, "ПКО_ОтчетОРозничныхПродажах_Аванс" ,"ПКО_ОтчетОРозничныхПродажах_Предоплата"));
						Иначе
							Если Строка.Сумма < 0 Тогда //Возврат ДС без передачи товаров
								ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ЭО_ОтчетОРозничныхПродажах_Возврат");
								Продолжить;
							КонецЕсли;
							
							ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, ?(Аванс = Неопределено, "ЭО_ОтчетОРозничныхПродажах_Аванс" ,"ЭО_ОтчетОРозничныхПродажах_Предоплата"));
						КонецЕсли;
					КонецЦикла;
				Иначе
					//Реализация
					Для каждого Строка Из ТаблицаЗначений Цикл
						ТаблицаТовары = Строка.Реализация.Товары.Выгрузить();
						ТаблицаСерии = Строка.Реализация.Серии.Выгрузить();
						ВходящиеДанные = Новый Структура;
						ВходящиеДанные.Вставить("Товары", ТаблицаТовары);
						ВходящиеДанные.Вставить("Серии", ТаблицаСерии);
						ВходящиеДанные.Вставить("Номер", Строка.НомерДокумента);
						ВходящиеДанные.Вставить("Контрагент", Строка.Контрагент);
						ВходящиеДанные.Вставить("ЗаказКлиента", ?(ЗначениеЗаполнено(Строка.ЗаказПокупателя), Строка.ЗаказПокупателя, Неопределено));
						ВходящиеДанные.Вставить("СуммаДокумента", ?(Строка.Сумма < 0, -Строка.Сумма, Строка.Сумма));
						ВходящиеДанные.Вставить("Продавец", Строка.Продавец);
						ВходящиеДанные.Вставить("Чек", Строка.Реализация);
	
						Если Строка.Сумма < 0 Тогда //Возврат товаров без оплаты
							ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ОРП_ВозвратОтРозничногоПокупателя");
							Продолжить;
						КонецЕсли;
						
						ВыгрузитьПоПравилу(Объект,,ВходящиеДанные,, "ОтчетОРозничныхПродажах_Реализация");
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_ПеремещениеТоваров_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	ВыгружатьИнтеркампани	= Ложь;
	
	Организация = Объект.Организация;
	Если Организация.ОбособленноеПодразделение Тогда
		Организация = Организация.ГоловнаяОрганизация;
	КонецЕсли;
	
	ОрганизацияПолучатель = Объект.ОрганизацияПолучатель;
	Если ОрганизацияПолучатель.ОбособленноеПодразделение Тогда
		ОрганизацияПолучатель = ОрганизацияПолучатель.ГоловнаяОрганизация;
	КонецЕсли;
	
	Если Организация <> ОрганизацияПолучатель Тогда
		
		Если Объект.МагазинОтправитель = Объект.МагазинПолучатель Тогда
			Отказ = Истина;
		Иначе
			ВходящиеДанные = Новый Структура("ОрганизацияПолучатель", Организация);
		КонецЕсли;
		
		ВыгружатьИнтеркампани = Истина;
		ВыгрузитьПоПравилу(Объект,,,, "ПеремещениеВИнтеркампани");	
	КонецЕсли;
	
	Если НЕ ВыгружатьИнтеркампани Тогда
		СсылкаНаУдаляемыйОбъект = Объект.Ссылка;
		ТипИсточника = "ДокументСсылка.ПеремещениеТоваров";
		ТипПриемника = "ДокументСсылка.ПередачаТоваровМеждуОрганизациями";
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, ТипПриемника, ТипИсточника);
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_ПриказНаПроведениеИнвентаризацииТоваров_ПередОбработкойПравила(Отказ, ИмяПКО, Правило, ИсходящиеДанные, ВыборкаДанных) Экспорт

	Отказ = Истина;

КонецПроцедуры

Процедура ПВД_ПриходныйКассовыйОрдер_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзДругойОрганизации Тогда
		ИмяПКО = "ПКО_ВыдачаДСВДругуюОрганизацию";
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств Тогда
		Отказ = Истина;
	Иначе
		ИмяПКО = "ПриходныйКассовыйОрдер";
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_ПриходныйОрдерНаТовары_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Если Объект.Магазин.ИспользоватьОрдернуюСхемуПриПоступлении ИЛИ Объект.Магазин.ИспользоватьОрдернуюСхемуПриПеремещении Тогда
			ВыгрузитьПоПравилу(Объект.ДокументОснование,,,,"ПеремещениеТоваров");
		Иначе
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_РасходныйКассовыйОрдер_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствВДругуюОрганизацию
		Тогда
		ИмяПКО = "РКО_ВыдачаДСВДругуюОрганизацию";
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗаработнойПлатыПоВедомостям
			ИЛИ Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗаработнойПлатыРаботнику
		Тогда
		ИмяПКО = "РКО_ВыплатаЗарплаты";
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств
		Тогда
		Отказ = Истина;
	Иначе
		ИмяПКО = "РКО";
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_СерийныеНомера_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	ТипНоменклатурыОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ТипНоменклатуры");
	Если ТипНоменклатурыОбъекта <> Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_СписаниеТоваров_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) = Тип ("ДокументСсылка.ОрдерНаОтражениеНедостачТоваров") Тогда
		СсылкаНаУдаляемыйОбъект = Объект.Ссылка;
		ТипИсточника = "ДокументСсылка.СписаниеТоваров";
		ТипПриемника = "ДокументСсылка.ВнутреннееПотребление";
		ЗаписатьВФайлУдалениеОбъекта(СсылкаНаУдаляемыйОбъект, ТипПриемника, ТипИсточника);
	КонецЕсли;
	
	Если Объект.АналитикаХозяйственнойОперации.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеПоИнвентаризации 
		ИЛИ ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) = Тип ("ДокументСсылка.ОрдерНаОтражениеНедостачТоваров") Тогда
		ИмяПКО = "СписаниеНедостачиТоваров";
	Иначе
		ИмяПКО = "ВнутреннееПотреблениеТоваров";
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_СчетФактураПолученный_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если Объект.Корректировочный
		И Не Объект.СчетФактураОснование.Корректировочный Тогда
		ВыгрузитьПоПравилу(Объект,,,, "КорректировкаПриобретения");
	КонецЕсли;

КонецПроцедуры

Процедура ПВД_ТоварноТранспортнаяНакладнаяЕГАИС_ПередОбработкойПравила(Отказ, ИмяПКО, Правило, ИсходящиеДанные, ВыборкаДанных) Экспорт

	Отказ = Истина;

КонецПроцедуры

Процедура ПВД_Штрихкоды_ПередВыгрузкойОбъекта(ФайлОбмена, Отказ, ИмяПКО, Правило, ВходящиеДанные, ИсходящиеДанные, Объект) Экспорт

	Если ТипЗнч(Объект.Отбор.Владелец) = Тип("СправочникСсылка.СерийныеНомера") Тогда
		
		Отказ = Истина;
		
		Если ИсходящиеДанные = Неопределено Тогда
			ИсходящиеДанные = Новый Структура;
		КонецЕсли;
	
		ИсходящиеДанные.Вставить("ШтрихКод", Объект.Отбор.ШтрихКод);
		ВыгрузитьПоПравилу(Объект.Отбор.Владелец, , ИсходящиеДанные, , "ПодарочныеСертификаты");
		
	ИначеЕсли ТипЗнч(Объект.Отбор.Владелец.Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		ИмяПКО = "ШтрихкодыНоменклатуры";
	
	Иначе
		
		Отказ = Истина;
		
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// АЛГОРИТМЫ
// Данный раздел разрешено изменять.
// Также допустимо размещать процедуры с алгоритмами в любом из разделов выше.

Процедура ВыгрузитьТоварыСерииВДокументах(Источник, ТипДокумента, КоллекцияОбъектов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	NULL КАК Серия,
	|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ИЗ
	|	Документ.%1.Товары КАК Товары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ПО
	|	СпрНоменклатура.Ссылка = Товары.Номенклатура
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.СтатусУказанияСерий = 0
	|	И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Серии.Номенклатура,
	|	Серии.Характеристика,
	|	Серии.Количество,
	|	Серии.Номенклатура.ЕдиницаИзмерения,
	|	Серии.Количество,
	|	Серии.Серия,
	|	ТоварыСтатусы.СтатусУказанияСерий
	|ИЗ
	|	Документ.%1.Серии КАК Серии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерНаТовары.Товары КАК ТоварыСтатусы
	|		ПО Серии.Номенклатура = ТоварыСтатусы.Номенклатура
	|			И Серии.Характеристика = ТоварыСтатусы.Характеристика
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ПО
	|	СпрНоменклатура.Ссылка = Серии.Номенклатура
	|ГДЕ
	|	Серии.Ссылка = &Ссылка
	|	И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|",ТипДокумента);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	КоллекцияОбъектов = Запрос.Выполнить().Выгрузить();

КонецПроцедуры

Процедура ЗаполнитьПользователяПоФизЛицу(ОбъектКоллекции, Значение) Экспорт

	Если ЗначениеЗаполнено(ОбъектКоллекции.Продавец) Тогда
		
		Запросы.ПользовательПоФизлицу.УстановитьПараметр("Физлицо", ОбъектКоллекции.Продавец);
		РезультатыЗапроса = Запросы.ПользовательПоФизлицу.ВыполнитьПакет();
		Выборка = РезультатыЗапроса[0].Выбрать();
		
		Если Выборка.Следующий() Тогда
			Значение = Выборка.Пользователь;
		Иначе
			Пусто = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьРегистрациюВИФНС(ИсточникДанных) Экспорт

	ВыгрузитьПоПравилу(ИсточникДанных,,,,"ОбособленныеПодразделения");
	ВыгрузитьПоПравилу(ИсточникДанных,,,,"РегистрацииВНалоговомОргане");

КонецПроцедуры

Процедура ТаблицаСОтбором(ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат) Экспорт

	Если ИсходнаяТаблица.Колонки.Найти("Возврат") = Неопределено Тогда
		ИсходнаяТаблица.Сортировать("Сумма");
		ИсходнаяТаблица.Колонки.Добавить("Возврат", Новый ОписаниеТипов("Булево"));
		Для Каждого Строка Из ИсходнаяТаблица Цикл
			Если Строка.Сумма < 0 Тогда
		    	Строка.Возврат = ЭтоВозврат;
		    Иначе
		    	Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Отбор = Новый Структура("Возврат", ЭтоВозврат);
	
	ТаблицаРезультат = ИсходнаяТаблица.Скопировать(Отбор);

КонецПроцедуры

