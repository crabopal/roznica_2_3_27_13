Процедура ПКС_ПередачаТоваровМеждуОрганизациями_СуммаДокумента_ПередВыгрузкойСвойства_9_33(ФайлОбмена, Источник, Приемник, ВходящиеДанные, ИсходящиеДанные,
	ПКС, ПКО, ОбъектКоллекции, Отказ, Значение, ТипПриемника, ИмяПКО,
	ИмяПКОВидСубконто, Пусто, Выражение, УзелКоллекцииСвойств, НеЗамещать,
	ВыгрузитьОбъект) Экспорт

	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ЦенаВключаетНДС
	|			ТОГДА СУММА(Товары.Сумма)
	|		ИНАЧЕ СУММА(Товары.Сумма + Товары.СуммаНДС)
	|	КОНЕЦ КАК СуммаДокумента
	|ИЗ
	|	Документ.ПередачаТоваровМеждуОрганизациями.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)");
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ЦенаВключаетНДС", Источник.ЦенаВключаетНДС);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Значение = 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Значение = Выборка.СуммаДокумента;
	КонецЕсли;

КонецПроцедуры

