Процедура ПКО_ОтчетКомитентуОСписании_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	ВходящиеДанные = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Наименование КАК Наименование,
	|	ДоговорыКонтрагентов.СпособРасчетаКомиссионногоВознаграждения КАК СпособРасчета,
	|	ДоговорыКонтрагентов.ПроцентКомиссионногоВознаграждения КАК Процент
	|ИЗ
	|	Документ.ОтчетКомитентуОСписании КАК ОтчетКомитентуОСписании
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО (ОтчетКомитентуОСписании.Договор = ДоговорыКонтрагентов.Ссылка)
	|ГДЕ
	|	ОтчетКомитентуОСписании.Ссылка = &Ссылка
	|");
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВходящиеДанные.Вставить("Наименование", Выборка.Наименование);
		ВходящиеДанные.Вставить("ПроцентВознаграждения", Выборка.Процент);
		ВходящиеДанные.Вставить("СпособРасчетаВознаграждения", Выборка.СпособРасчета);
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ОтчетОРозничныхВозвратах_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Если ТипЗнч(ВходящиеДанные) = Тип("Структура")
		И ВходящиеДанные.Свойство("ТоварыВозврат")
		И ВходящиеДанные.ТоварыВозврат.Количество() > 0 Тогда
		
		СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(ВходящиеДанные.ТоварыВозврат, Источник.ЦенаВключаетНДС);
		ВходящиеДанные.Вставить("СуммаДокумента", -СуммаДокумента);
	Иначе 
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ОтчетОРозничныхПродажах_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Если Не ВходящиеДанные.Свойство("ТолькоПолучитьУзелСсылки") Тогда
	
		СписокВидовОплаты = Новый СписокЗначений;
		СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ЗачетАванса"));
		СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ОплатаВрассрочку"));
	
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
		Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
		РезультатыЗапросаВозвраты = Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.ВыполнитьПакет();
	
		ТаблицаПромежуточная = Запросы.ОтчетОРозничныхПродажах_ТаблицаПромежуточная.МенеджерВременныхТаблиц.Таблицы["ТаблицаПромежуточная"].ПолучитьДанные().Выгрузить();
	
		ТаблицаРезультат = Новый ТаблицаЗначений;
	
		Если ТаблицаПромежуточная.Количество() = 0 Тогда // Нет Чеков или ОРП загружен из ККМОффлайн.
			МенеджерВременныхТаблиц.Закрыть();
			
			ЗапросТовары = Новый Запрос();
			ЗапросТовары.Текст =
			"ВЫБРАТЬ
			|	Товары.Номенклатура       		КАК Номенклатура,
			|	Товары.Характеристика     		КАК Характеристика,
			|	СУММА(Товары.Количество)  		КАК Количество,
			|	СУММА(Товары.КоличествоУпаковок) КАК КоличествоУпаковок,
			|	Товары.Упаковка           		КАК Упаковка,
			|	Товары.СтавкаНДС          		КАК СтавкаНДС,
			|	Товары.Цена           		    КАК Цена,
			|	СУММА(Товары.Сумма)             КАК Сумма,
			|	СУММА(Товары.СуммаНДС)          КАК СуммаНДС,
			|	Товары.СтатусУказанияСерий 		КАК СтатусУказанияСерий,
			|	Товары.ДисконтнаяКарта 	  		КАК ДисконтнаяКарта,
			|	Товары.Продавец		 	  		КАК Продавец
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах.Товары КАК Товары
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.Номенклатура КАК СпрНоменклатура
			|ПО
			|	СпрНоменклатура.Ссылка = Товары.Номенклатура
			|ГДЕ
			|	Товары.Ссылка = &Ссылка
			|	И СпрНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
			|
			|СГРУППИРОВАТЬ ПО
			|	Товары.Номенклатура,
			|	Товары.Характеристика,
			|	Товары.Упаковка,
			|	Товары.СтавкаНДС,
			|	Товары.Цена,
			|	Товары.СтатусУказанияСерий,
			|	Товары.ДисконтнаяКарта,
			|	Товары.Продавец
			|
			|ИМЕЮЩИЕ
			|	СУММА(Товары.Количество) <> 0
			|";
	
			ЗапросТовары.УстановитьПараметр("Ссылка", Источник.Ссылка);
			ТаблицаТовары = ЗапросТовары.Выполнить().Выгрузить();
			
			ИсходнаяТаблица = ТаблицаТовары;
			
			ЭтоВозврат = Истина;
			ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
			ВходящиеДанные.Вставить("ТоварыВозврат", ТаблицаРезультат);
			
			ЭтоВозврат = Ложь;
			ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
			ВходящиеДанные.Вставить("Товары", ТаблицаРезультат);
			
			ЗапросОплаты = Новый Запрос();
			ЗапросОплаты.Текст = 
			"ВЫБРАТЬ
			|	СУММА(ВЫБОР
			|			КОГДА ОтчетОРозничныхПродажахТовары.Количество < 0
			|				ТОГДА ОтчетОРозничныхПродажахТовары.Сумма
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Сумма
			|ПОМЕСТИТЬ СуммаВозвратаТоваров
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах.Товары КАК ОтчетОРозничныхПродажахТовары
			|ГДЕ
			|	ОтчетОРозничныхПродажахТовары.Ссылка = &Ссылка
			|;
			|ВЫБРАТЬ
			|	ОплатаПК.ЭквайринговыйТерминал 	КАК ЭквайринговыйТерминал,
			|	ОплатаПК.ВидОплаты 				КАК ВидОплаты,
			|	СУММА(ОплатаПК.Сумма) 			КАК Сумма,
			|	ВЫБОР
			|		КОГДА ОплатаПК.Сумма = СуммаВозвратаТоваров.Сумма
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ПолеГруппировки
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах.ОплатаПлатежнымиКартами КАК ОплатаПК,
			|	СуммаВозвратаТоваров КАК СуммаВозвратаТоваров
			|ГДЕ
			|	ОплатаПК.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	ОплатаПК.ЭквайринговыйТерминал,
			|	ОплатаПК.ВидОплаты,
			|	ВЫБОР
			|		КОГДА ОплатаПК.Сумма = СуммаВозвратаТоваров.Сумма
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ
			|
			|ИМЕЮЩИЕ
			|	СУММА(ОплатаПК.Сумма) <> 0
			|";
	
			ЗапросОплаты.УстановитьПараметр("Ссылка", Источник.Ссылка);
			ТаблицаОплаты = ЗапросОплаты.Выполнить().Выгрузить();
			
			ИсходнаяТаблица = ТаблицаОплаты;
			
			ЭтоВозврат = Истина;
			ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
			ВходящиеДанные.Вставить("ОплатыВозврат", ТаблицаРезультат);
	
			ЭтоВозврат = Ложь;
			ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
			ВходящиеДанные.Вставить("Оплаты", ТаблицаРезультат);
			
			ВыгрузитьПоПравилу(Источник, , ВходящиеДанные, , "ОтчетОРозничныхВозвратах");
	
		Иначе
			
			Запрос = Новый Запрос();
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	Док.ДисконтнаяКарта КАК ДисконтнаяКарта,
			|	Док.Номенклатура КАК Номенклатура,
			|	Док.Характеристика КАК Характеристика,
			|	Док.Продавец КАК Продавец,
			|	СУММА(ВЫБОР
			|			КОГДА Док.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
			|				ТОГДА Док.Количество
			|			ИНАЧЕ -Док.Количество
			|		КОНЕЦ) КАК Количество,
			|	Док.Цена КАК Цена,
			|	Док.СтавкаНДС КАК СтавкаНДС,
			|	СУММА(ВЫБОР
			|			КОГДА Док.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
			|				ТОГДА Док.СуммаНДС
			|			ИНАЧЕ -Док.СуммаНДС
			|		КОНЕЦ) КАК СуммаНДС,
			|	СУММА(ВЫБОР
			|			КОГДА Док.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
			|				ТОГДА Док.Сумма
			|			ИНАЧЕ -Док.Сумма
			|		КОНЕЦ) КАК Сумма,
			|	Док.Упаковка КАК Упаковка,
			|	СУММА(ВЫБОР
			|			КОГДА Док.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
			|				ТОГДА Док.КоличествоУпаковок
			|			ИНАЧЕ -Док.КоличествоУпаковок
			|		КОНЕЦ) КАК КоличествоУпаковок,
			|	Док.СтатусУказанияСерий КАК СтатусУказанияСерий,
			|	Док.ЭтоВозвратПослеЗакрытияСмены КАК ЭтоВозвратПослеЗакрытияСмены,
			|	Док.ДокументРеализации КАК ДокументРеализации
			|ИЗ
			|	ТаблицаПромежуточная КАК Док
			|
			|СГРУППИРОВАТЬ ПО
			|	Док.ДисконтнаяКарта,
			|	Док.Номенклатура,
			|	Док.Характеристика,
			|	Док.Продавец,
			|	Док.СтавкаНДС,
			|	Док.Цена,
			|	Док.Упаковка,
			|	Док.СтатусУказанияСерий,
			|	Док.ЭтоВозвратПослеЗакрытияСмены,
			|	Док.ДокументРеализации
			|
			|ИМЕЮЩИЕ
			|	СУММА(ВЫБОР
			|			КОГДА Док.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
			|				ТОГДА Док.Количество
			|			ИНАЧЕ -Док.Количество
			|		КОНЕЦ) <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЧекККМОплата.Ссылка КАК Ссылка,
			|	ЧекККМОплата.НомерСтроки КАК НомерСтроки,
			|	Док.ДисконтнаяКарта КАК ДисконтнаяКарта,
			|	ЧекККМОплата.ВидОплаты КАК ВидОплаты,
			|	ЧекККМОплата.ВидОплаты.ТипОплаты КАК ТипОплаты,
			|	ЧекККМОплата.ВидОплаты.ПлатежнаяСистема КАК ПлатежнаяСистема,
			|	ЧекККМОплата.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
			|	ЧекККМОплата.Сумма КАК Сумма,
			|	ЧекККМОплата.СуммаБонусовВСкидках КАК СуммаОплатыБонусами,
			|	ВЫБОР
			|		КОГДА Док.ВидОперации = &ВидОперацииПродажа
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ КАК КоэффициентВидаОплаты,
			|	ВЫБОР
			|		КОГДА Док.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
			|				И (Док.ЧекККМПродажа.ОтчетОРозничныхПродажах <> &Ссылка
			|					ИЛИ Док.ЧекККМПродажа = ЗНАЧЕНИЕ(Документ.ЧекККМ.ПустаяСсылка))
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ЭтоВозвратПослеЗакрытияСмены
			|ПОМЕСТИТЬ ТаблицаОплат
			|ИЗ
			|	Документ.ЧекККМ.Оплата КАК ЧекККМОплата
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК Док
			|		ПО (Док.Ссылка = ЧекККМОплата.Ссылка)
			|ГДЕ
			|	ЧекККМОплата.ВидОплаты.ТипОплаты В(&ТипыОплаты)
			|	И НЕ Док.Ссылка В
			|				(ВЫБРАТЬ
			|					ЧЕКИ54ФЗ.Ссылка КАК Ссылка
			|				ИЗ
			|					ЧЕКИ54ФЗ КАК ЧЕКИ54ФЗ)
			|	И Док.ОтчетОРозничныхПродажах = &Ссылка
			|	И Док.Проведен
			|	И НЕ Док.ОперацияСДенежнымиСредствами
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаОплат.ДисконтнаяКарта КАК ДисконтнаяКарта,
			|	ТаблицаОплат.ВидОплаты КАК ВидОплаты,
			|	ТаблицаОплат.ТипОплаты КАК ТипОплаты,
			|	ТаблицаОплат.ПлатежнаяСистема КАК ПлатежнаяСистема,
			|	ТаблицаОплат.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
			|	ТаблицаОплат.КоэффициентВидаОплаты * ТаблицаОплат.Сумма КАК Сумма,
			|	ТаблицаОплат.КоэффициентВидаОплаты * ТаблицаОплат.СуммаОплатыБонусами КАК СуммаОплатыБонусами,
			|	ТаблицаОплат.ЭтоВозвратПослеЗакрытияСмены КАК ЭтоВозвратПослеЗакрытияСмены
			|ПОМЕСТИТЬ ПодготовительнаяТаблица
			|ИЗ
			|	ТаблицаОплат КАК ТаблицаОплат
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПодготовительнаяТаблица.ВидОплаты КАК ВидОплаты,
			|	ПодготовительнаяТаблица.ТипОплаты КАК ТипОплаты,
			|	ПодготовительнаяТаблица.ПлатежнаяСистема КАК ПлатежнаяСистема,
			|	ПодготовительнаяТаблица.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
			|	СУММА(ПодготовительнаяТаблица.Сумма) КАК Сумма
			|ИЗ
			|	ПодготовительнаяТаблица КАК ПодготовительнаяТаблица
			|
			|СГРУППИРОВАТЬ ПО
			|	ПодготовительнаяТаблица.ТипОплаты,
			|	ПодготовительнаяТаблица.ПлатежнаяСистема,
			|	ПодготовительнаяТаблица.ЭквайринговыйТерминал,
			|	ПодготовительнаяТаблица.ВидОплаты,
			|	ПодготовительнаяТаблица.ЭтоВозвратПослеЗакрытияСмены
			|
			|ИМЕЮЩИЕ
			|	СУММА(ПодготовительнаяТаблица.Сумма) <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПодготовительнаяТаблица.ДисконтнаяКарта.БонуснаяПрограммаЛояльности КАК БонуснаяПрограммаЛояльности,
			|	ПодготовительнаяТаблица.ДисконтнаяКарта КАК ДисконтнаяКарта,
			|	СУММА(ПодготовительнаяТаблица.СуммаОплатыБонусами) КАК Сумма
			|ИЗ
			|	ПодготовительнаяТаблица КАК ПодготовительнаяТаблица
			|
			|СГРУППИРОВАТЬ ПО
			|	ПодготовительнаяТаблица.ДисконтнаяКарта,
			|	ПодготовительнаяТаблица.ЭтоВозвратПослеЗакрытияСмены,
			|	ПодготовительнаяТаблица.ДисконтнаяКарта.БонуснаяПрограммаЛояльности
			|
			|ИМЕЮЩИЕ
			|	СУММА(ПодготовительнаяТаблица.СуммаОплатыБонусами) <> 0
			|";
	
			ТипыОплаты = Новый СписокЗначений;
			ТипыОплаты.Добавить(Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта);
			ТипыОплаты.Добавить(Перечисления.ТипыОплатЧекаККМ.ПлатежнаяСистема);
			ТипыОплаты.Добавить(Перечисления.ТипыОплатЧекаККМ.Бонусы);
	
			Запрос.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			Запрос.УстановитьПараметр("ВидОперацииПродажа", Перечисления.ВидыОперацийЧекККМ.Продажа);
			Запрос.УстановитьПараметр("ТипыОплаты", ТипыОплаты);
	
			РезультатЗапроса = Запрос.ВыполнитьПакет();
			МенеджерВременныхТаблиц.Закрыть();
			
			Если ТаблицаПромежуточная.Количество() > 0 Тогда
				ТаблицаТовары =  РезультатЗапроса[0].Выгрузить();
				
				ИсходнаяТаблица = ТаблицаТовары;
			
				ЭтоВозврат = Истина;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ВходящиеДанные.Вставить("ТоварыВозврат", ТаблицаРезультат);
				
				ЭтоВозврат = Ложь;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ВходящиеДанные.Вставить("Товары", ТаблицаРезультат);
	
				ТаблицаОплаты =  РезультатЗапроса[3].Выгрузить();
				
				ИсходнаяТаблица = ТаблицаОплаты;
			
				ЭтоВозврат = Истина;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ВходящиеДанные.Вставить("ОплатыВозврат", ТаблицаРезультат);
	
				ЭтоВозврат = Ложь;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ВходящиеДанные.Вставить("Оплаты", ТаблицаРезультат);
				
				ТаблицаОплатыБонусами =  РезультатЗапроса[4].Выгрузить();
				
				ИсходнаяТаблица = ТаблицаОплатыБонусами;
			
				ЭтоВозврат = Истина;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ТаблицаРезультат.Колонки.Сумма.Имя = "КоличествоБонусныхБаллов";
				ВходящиеДанные.Вставить("ВозвратБонусов", ТаблицаРезультат);
	
				ЭтоВозврат = Ложь;
				ТаблицаСОтбором (ИсходнаяТаблица, ТаблицаРезультат,  ЭтоВозврат);
				ТаблицаРезультат.Колонки.Сумма.Имя = "КоличествоБонусовВСкидках";
				ВходящиеДанные.Вставить("ОплатыБонусами", ТаблицаРезультат);
	
				ВыгрузитьПоПравилу(Источник, , ВходящиеДанные, , "ОтчетОРозничныхВозвратах");
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(ВходящиеДанные) = Тип("Структура")
			И ВходящиеДанные.Свойство("Товары")
			И ВходящиеДанные.Товары.Количество() > 0 Тогда
			
			СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(ВходящиеДанные.Товары, Источник.ЦенаВключаетНДС);
			ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);
		Иначе 
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ОтчетОРозничныхПродажах_ПослеВыгрузкиОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, КлючВыгружаемыхДанных, Отказ, Приемник, УзелСсылки) Экспорт

	ВходящиеДанные = Неопределено;

КонецПроцедуры

Процедура ПКО_ПоступлениеТоваровУслуг_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Если Источник.ЕстьРасхождения Тогда
		Запросы.ПриобретениеТоваровУслугРасхождения.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запросы.ПриобретениеТоваровУслугРасхождения.УстановитьПараметр("ЦенаВключаетНДС", Источник.ЦенаВключаетНДС);
		РезультатЗапроса = Запросы.ПриобретениеТоваровУслугРасхождения.Выполнить();	
	Иначе
		Запросы.ПриобретениеТоваровУслуг.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запросы.ПриобретениеТоваровУслуг.УстановитьПараметр("ЦенаВключаетНДС", Источник.ЦенаВключаетНДС);
		РезультатЗапроса = Запросы.ПриобретениеТоваровУслуг.Выполнить();
	КонецЕсли;
	
	ТаблицаТовары = РезультатЗапроса.Выгрузить();
	
	ВходящиеДанные.Вставить("Товары", ТаблицаТовары);
	СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(ТаблицаТовары, Источник.ЦенаВключаетНДС);
	ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);
	
	Запросы.ПоступлениеТоваровЭтапыОплат.УстановитьПараметр("Ссылка", Источник.Ссылка);
	РезультатЗапроса = Запросы.ПоступлениеТоваровЭтапыОплат.Выполнить();
	ЭтапыОплат = РезультатЗапроса.Выгрузить();
	ВходящиеДанные.Вставить("ЭтапыОплат", ЭтапыОплат);

КонецПроцедуры

Процедура ПКО_ПоступлениеТоваровУслуг_ПослеВыгрузкиОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, КлючВыгружаемыхДанных, Отказ, Приемник, УзелСсылки) Экспорт

	Если НЕ ВходящиеДанные.Свойство("ФлагВыгрузкиТолькоСсылки") Тогда
		СтруктураФлагаВыгрузки = Новый Структура("ФлагВыгрузкиТолькоСсылки");
		СтруктураФлагаВыгрузки.Вставить("ВыгруженныеОбъекты", ВыгруженныеОбъекты);
		
		ТекстЗапроса = "
			|ВЫБРАТЬ
			|	ПоступлениеТоваровЭтапыОплат.ДокументВзаимозачета КАК ДокументВзаимозачета
			|ИЗ
			|	Документ.ПоступлениеТоваров.ЭтапыОплат КАК ПоступлениеТоваровЭтапыОплат
			|ГДЕ
			|	ПоступлениеТоваровЭтапыОплат.ДокументВзаимозачета ССЫЛКА Документ.ВозвратТоваровПоставщику
			|	И ПоступлениеТоваровЭтапыОплат.Ссылка = &Ссылка
			|	И ПоступлениеТоваровЭтапыОплат.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Взаимозачет)
			|";
	
		Запрос = Новый Запрос(ТекстЗапроса);
	
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
		Выборка = Запрос.Выполнить().Выбрать();
	
		Пока Выборка.Следующий() Цикл
			Если ВыгруженныеОбъекты.Найти(Выборка.ДокументВзаимозачета, "Ключ") = Неопределено Тогда
			    СтруктураФлагаВыгрузки.Вставить("КлючВыгружаемыхДанных", Выборка.ДокументВзаимозачета);
				ВозвратОбъект = Выборка.ДокументВзаимозачета.ПолучитьОбъект();
				ВыгрузитьПоПравилу(ВозвратОбъект,,СтруктураФлагаВыгрузки,, "ВозвратТоваровПоставщику");
				ВыгруженныеОбъекты = СтруктураФлагаВыгрузки.ВыгруженныеОбъекты;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПриказНаПроведениеИнвентаризацииТоваров_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПриходныйКассовыйОрдер_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	ВходящиеДанные = Новый Структура;
	ВходящиеДанные.Вставить("СуммаДокумента", Источник.СуммаДокумента);
	
	Если ЗначениеЗаполнено(Источник.ДокументОснование) И ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ВыемкаДенежныхСредствИзКассыККМ") Тогда
		МВТ = Новый МенеджерВременныхТаблиц;
		ЗапросЧЕКИ54ФЗ = Новый Запрос;
		ЗапросЧЕКИ54ФЗ.МенеджерВременныхТаблиц = МВТ;
		СписокВидовОплаты = Новый СписокЗначений;
		СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ЗачетАванса"));
		СписокВидовОплаты.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОплатЧекаККМ.ОплатаВрассрочку"));
		ЗапросЧЕКИ54ФЗ.УстановитьПараметр("ВидОплаты", СписокВидовОплаты);
		ЗапросЧЕКИ54ФЗ.УстановитьПараметр("Ссылка", Источник.ДокументОснование.ОтчетОРозничныхПродажах);
		ЗапросЧЕКИ54ФЗ.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЧекККМ.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ЧЕКИ54ФЗ
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
		|		ПО РасчетыСКлиентами.Регистратор = ЧекККМ.ОтчетОРозничныхПродажах
		|ГДЕ
		|	ЧекККМ.ОтчетОРозничныхПродажах = &Ссылка
		|	И (ЧекККМ.Оплата.ВидОплаты В (&ВидОплаты)
		|			ИЛИ ЧекККМ.ОперацияСДенежнымиСредствами = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЧЕКИ54ФЗ.Ссылка КАК Ссылка
		|ИЗ
		|	ЧЕКИ54ФЗ КАК ЧЕКИ54ФЗ";
		
		Выборка = ЗапросЧЕКИ54ФЗ.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 0 Тогда
			
			ЗапросПоВыемкам = Новый Запрос;
			ЗапросПоВыемкам.УстановитьПараметр("ОтчетОРозничныхПродажах", Источник.ДокументОснование.ОтчетОРозничныхПродажах);
			ЗапросПоВыемкам.Текст = "
			|ВЫБРАТЬ
			|	ВыемкаДенежныхСредствИзКассыККМ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ВыемкаДенежныхСредствИзКассыККМ КАК ВыемкаДенежныхСредствИзКассыККМ
			|ГДЕ
			|	ВыемкаДенежныхСредствИзКассыККМ.ОтчетОРозничныхПродажах = &ОтчетОРозничныхПродажах
			|";
			Выборка = ЗапросПоВыемкам.Выполнить().Выбрать();
			
			Если Выборка.Количество() <> 1 Тогда
				Отказ = Истина;
			Иначе
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МВТ;
				Запрос.УстановитьПараметр("Ссылка", Источник.ДокументОснование.ОтчетОРозничныхПродажах);
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЧекККМОплата.Ссылка КАК Ссылка
				|ПОМЕСТИТЬ ТаблицаЧековСОплатойНаличными
				|ИЗ
				|	Документ.ЧекККМ.Оплата КАК ЧекККМОплата
				|ГДЕ
				|	ЧекККМОплата.Ссылка.Проведен
				|	И НЕ ЧекККМОплата.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Аннулированный)
				|	И НЕ ЧекККМОплата.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Отложенный)
				|	И ЧекККМОплата.ВидОплаты.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
				|	И ЧекККМОплата.Ссылка.ОтчетОРозничныхПродажах = &Ссылка
				|	И ЧекККМОплата.Ссылка В
				|			(ВЫБРАТЬ
				|				ЧЕКИ54ФЗ.Ссылка КАК Ссылка
				|			ИЗ
				|				ЧЕКИ54ФЗ КАК ЧЕКИ54ФЗ)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЧекККМТовары.Сумма КАК СуммаТоваров,
				|	0 КАК СуммаОплат,
				|	0 КАК СуммаНаличных,
				|	ЧекККМТовары.Ссылка КАК Ссылка
				|ПОМЕСТИТЬ ТаблицаСумм
				|ИЗ
				|	Документ.ЧекККМ.Товары КАК ЧекККМТовары
				|ГДЕ
				|	ЧекККМТовары.Ссылка.Проведен
				|	И НЕ ЧекККМТовары.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Аннулированный)
				|	И НЕ ЧекККМТовары.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Отложенный)
				|	И ЧекККМТовары.Ссылка В
				|			(ВЫБРАТЬ
				|				ТаблицаЧековСОплатойНаличными.Ссылка КАК Ссылка
				|			ИЗ
				|				ТаблицаЧековСОплатойНаличными КАК ТаблицаЧековСОплатойНаличными)
				|	И ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах = &Ссылка
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	0,
				|	ЧекККМОплата.Сумма,
				|	ВЫБОР
				|		КОГДА ЧекККМОплата.ВидОплаты.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
				|			ТОГДА ЧекККМОплата.Сумма
				|		ИНАЧЕ 0
				|	КОНЕЦ,
				|	ЧекККМОплата.Ссылка
				|ИЗ
				|	Документ.ЧекККМ.Оплата КАК ЧекККМОплата
				|ГДЕ
				|	ЧекККМОплата.Ссылка.Проведен
				|	И НЕ ЧекККМОплата.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Аннулированный)
				|	И НЕ ЧекККМОплата.Ссылка.СтатусЧекаККМ = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Отложенный)
				|	И ЧекККМОплата.Ссылка В
				|			(ВЫБРАТЬ
				|				ТаблицаЧековСОплатойНаличными.Ссылка КАК Ссылка
				|			ИЗ
				|				ТаблицаЧековСОплатойНаличными КАК ТаблицаЧековСОплатойНаличными)
				|	И ЧекККМОплата.Ссылка.ОтчетОРозничныхПродажах = &Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СУММА(ТаблицаСумм.СуммаТоваров) КАК СуммаТоваров,
				|	СУММА(ТаблицаСумм.СуммаОплат) КАК СуммаОплат,
				|	СУММА(ТаблицаСумм.СуммаНаличных) КАК СуммаНаличных,
				|	ТаблицаСумм.Ссылка КАК Ссылка
				|ПОМЕСТИТЬ ТаблицаПоЧекам
				|ИЗ
				|	ТаблицаСумм КАК ТаблицаСумм
				|
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаСумм.Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СУММА(ВЫБОР
				|			КОГДА ТаблицаПоЧекам.СуммаТоваров = 0
				|				ТОГДА ВЫБОР
				|						КОГДА ТаблицаПоЧекам.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
				|							ТОГДА ТаблицаПоЧекам.СуммаНаличных
				|						ИНАЧЕ -ТаблицаПоЧекам.СуммаНаличных
				|					КОНЕЦ
				|			ИНАЧЕ ВЫБОР
				|					КОГДА ТаблицаПоЧекам.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
				|						ТОГДА ТаблицаПоЧекам.СуммаТоваров - ТаблицаПоЧекам.СуммаОплат + ТаблицаПоЧекам.СуммаНаличных
				|					ИНАЧЕ -(ТаблицаПоЧекам.СуммаТоваров - ТаблицаПоЧекам.СуммаОплат + ТаблицаПоЧекам.СуммаНаличных)
				|				КОНЕЦ
				|		КОНЕЦ) КАК НаличныеБезСдачи
				|ИЗ
				|	ТаблицаПоЧекам КАК ТаблицаПоЧекам
				|
				|ИМЕЮЩИЕ
				|	СУММА(ВЫБОР
				|			КОГДА ТаблицаПоЧекам.СуммаТоваров = 0
				|				ТОГДА ВЫБОР
				|						КОГДА ТаблицаПоЧекам.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
				|							ТОГДА ТаблицаПоЧекам.СуммаНаличных
				|						ИНАЧЕ -ТаблицаПоЧекам.СуммаНаличных
				|					КОНЕЦ
				|			ИНАЧЕ ВЫБОР
				|					КОГДА ТаблицаПоЧекам.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
				|						ТОГДА ТаблицаПоЧекам.СуммаТоваров - ТаблицаПоЧекам.СуммаОплат + ТаблицаПоЧекам.СуммаНаличных
				|					ИНАЧЕ -(ТаблицаПоЧекам.СуммаТоваров - ТаблицаПоЧекам.СуммаОплат + ТаблицаПоЧекам.СуммаНаличных)
				|				КОНЕЦ
				|		КОНЕЦ) ЕСТЬ НЕ NULL
				|";
				РезультатаЗапроса = Запрос.Выполнить();
				Если Не РезультатаЗапроса.Пустой() Тогда
					ВыборкаРезультатаЗапроса = РезультатаЗапроса.Выбрать();
					ВыборкаРезультатаЗапроса.Следующий();
					СуммаДокумента = Источник.СуммаДокумента - ВыборкаРезультатаЗапроса.НаличныеБезСдачи;
					Если СуммаДокумента > 0 Тогда
						ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);
					Иначе
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПриходныйОрдерНаТовары_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Если ЗначениеЗаполнено(Источник.ДокументОснование) Тогда
		ВходящиеДанные = Новый Структура("Отправитель, Распоряжение");
		Если ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПоступлениеТоваров.Ссылка КАК Поступление
			|ИЗ
			|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
			|ГДЕ
			|	ПоступлениеТоваров.ЗаказПоставщику = &ЗаказПоставщику
			|	И ПоступлениеТоваров.Проведен");		
			Запрос.УстановитьПараметр("ЗаказПоставщику", Источник.ДокументОснование);
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				Отказ = Истина;
			Иначе
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				ВходящиеДанные.Отправитель = Неопределено;
				ВходящиеДанные.Распоряжение = Выборка.Поступление;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			Перемещение = Источник.ДокументОснование;
			ВходящиеДанные.Отправитель = Перемещение.МагазинОтправитель;
			
			Если ЗначениеЗаполнено(Перемещение.ДокументОснование) 
				И ТипЗнч(Перемещение.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
				ВходящиеДанные.Распоряжение = Перемещение.ДокументОснование;
			Иначе
				ВходящиеДанные.Распоряжение = Источник.ДокументОснование;
			КонецЕсли;
	
		Иначе
			ВходящиеДанные.Отправитель = Неопределено;
			ВходящиеДанные.Распоряжение = Источник.ДокументОснование;
		КонецЕсли;
		
	Иначе
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_РеализацияПодарочныхСертификатов_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	Запросы.РеализацияПодарочныхСертификатов.УстановитьПараметр("Ссылка", Источник.Ссылка);
	РезультатЗапроса = Запросы.РеализацияПодарочныхСертификатов.Выполнить();
	СерийныеНомера = РезультатЗапроса.Выгрузить();
	ВходящиеДанные.Вставить("СерийныеНомера", СерийныеНомера);

КонецПроцедуры

Процедура ПКО_РеализацияПодарочныхСертификатов_ПослеВыгрузкиОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, КлючВыгружаемыхДанных, Отказ, Приемник, УзелСсылки) Экспорт

	ВходящиеДанные = Неопределено;

КонецПроцедуры

Процедура ПКО_РеализацияТоваровУслуг_ПередВыгрузкойОбъекта(ФайлОбмена, Источник, ВходящиеДанные, ИсходящиеДанные, ИмяПКО, ПКО,
	ВыгруженныеОбъекты, Отказ, КлючВыгружаемыхДанных, ЗапоминатьВыгруженные,
	НеЗамещатьОбъектПриЗагрузке, ВсеОбъектыВыгружены, ТолькоПолучитьУзелСсылки,
	Приемник, РежимЗаписи, РежимПроведения, НеСоздаватьЕслиНеНайден) Экспорт

	ВходящиеДанные = Новый Структура;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Товары.Номенклатура                КАК Номенклатура,
	|	Товары.Характеристика              КАК Характеристика,
	|	Товары.Количество                  КАК Количество,
	|	Товары.КоличествоУпаковок          КАК КоличествоУпаковок,
	|	Товары.Упаковка                    КАК Упаковка,
	|	Товары.СтавкаНДС                   КАК СтавкаНДС,
	|	Товары.Цена                        КАК Цена,
	|	Товары.Сумма                       КАК Сумма,
	|	Товары.ПроцентАвтоматическойСкидки КАК ПроцентАвтоматическойСкидки,
	|	Товары.ПроцентРучнойСкидки         КАК ПроцентРучнойСкидки,
	|	Товары.СуммаАвтоматическойСкидки   КАК СуммаАвтоматическойСкидки,
	|	Товары.СуммаРучнойСкидки           КАК СуммаРучнойСкидки,
	|	Товары.СуммаНДС                    КАК СуммаНДС,
	|	ВЫБОР	КОГДА &ЦенаВключаетНДС
	|			ТОГДА Товары.Сумма
	|			ИНАЧЕ Товары.Сумма + Товары.СуммаНДС
	|	КОНЕЦ                              КАК СуммаСНДС,
	|	Товары.СтатусУказанияСерий		   КАК СтатусУказанияСерий,
	|	Товары.КлючСвязи				   КАК КлючСвязи
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК Товары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ПО
	|	СпрНоменклатура.Ссылка = Товары.Номенклатура
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И СпрНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	|");
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ЦенаВключаетНДС", Источник.ЦенаВключаетНДС);
	ТаблицаТовары = Запрос.Выполнить().Выгрузить();
	
	ВходящиеДанные.Вставить("Товары", ТаблицаТовары);
	СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(ТаблицаТовары, Источник.ЦенаВключаетНДС);
	ВходящиеДанные.Вставить("СуммаДокумента", СуммаДокумента);
	ВходящиеДанные.Вставить("СуммаВзаиморасчетов", СуммаДокумента);
	
	ГрафикОплатыКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Контрагент, "ГрафикОплаты");
	Если ЗначениеЗаполнено(ГрафикОплатыКонтрагента) Тогда
		ЭтапОплаты = ГрафикОплатыКонтрагента.ЭтапыОплаты[0];
		Если ЭтапОплаты.ПроцентПлатежа = 100 Тогда
			СрокОплаты = (ЭтапОплаты.Срок * 86400);
			ДатаПлатежа = "00010101";
	
			Если ЭтапОплаты.ВидПлатежа = Перечисления.ВидПлатежа.Предоплата Тогда
				ДатаПлатежа = Источник.Дата - СрокОплаты;
				ВариантОплаты = "ПредоплатаДоОтгрузки";
			ИначеЕсли ЭтапОплаты.ВидПлатежа = Перечисления.ВидПлатежа.ОтсрочкаПлатежа Тогда
				ДатаПлатежа = Источник.Дата + СрокОплаты;
				ВариантОплаты = "КредитПослеОтгрузки";
			КонецЕсли;
				
			ВходящиеДанные.Вставить("ФормаОплаты", ЭтапОплаты.ФормаОплаты);
			ВходящиеДанные.Вставить("ДатаПлатежа", ДатаПлатежа);
			ВходящиеДанные.Вставить("ВариантОплаты", ВариантОплаты);
			ВходящиеДанные.Вставить("ВариантОтсчета", "ОтДатыОтгрузки");
			ВходящиеДанные.Вставить("ПроцентПлатежа", ЭтапОплаты.ПроцентПлатежа);
			ВходящиеДанные.Вставить("СуммаПлатежа", СуммаДокумента * (ЭтапОплаты.ПроцентПлатежа / 100));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

