////////////////////////////////////////////////////////////////////////////////
// Обработчики загрузки конвертации УправлениеТорговлей --> Розница {41646727-bd9a-11f1-8424-0050569f5bf2}                                                                                           
// 
// Данный модуль содержит экспортные процедуры обработчиков событий конвертации 
// и предназначен для отладки правил обмена. После отладки рекомендуется
// скопировать текст модуля в буфер обмена и импортировать его в базу
// "Конвертация данных".
//
////////////////////////////////////////////////////////////////////////////////
// ИСПОЛЬЗУЕМЫЕ СОКРАЩЕНИЯ ИМЕН ПЕРЕМЕННЫХ (АББРЕВИАТУРЫ)
//
//  ПКО  - правило конвертации объектов
//  ПКС  - правило конвертации свойств объектов
//  ПКГС - правило конвертации группы свойств объектов
//  ПВД  - правило выгрузки данных
//  ПОД  - правило очистки данных

////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБРАБОТКИ
// Данный раздел изменять запрещено.

Перем ОбщиеПроцедурыФункции;
Перем Параметры;
Перем Запросы;
Перем Алгоритмы;
Перем Правила;
Перем ТаблицаПравилВыгрузки;
Перем ТаблицаНастройкиПараметров;
Перем УзелДляОбмена; // только для on-line обмена
Перем ДатаНачала;
Перем ДатаОкончания;
Перем ДатаВыгрузкиДанных; // только для on-line обмена
Перем КомментарийПриВыгрузкеДанных;
Перем КомментарийПриЗагрузкеДанных;

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОНВЕРТАЦИИ (ГЛОБАЛЬНЫЕ)
// В данном разделе разрешено изменять реализацию процедур.

Процедура Конвертация_ПослеЗагрузкиДанных() Экспорт

	Для Каждого ОбъектДоЗаполнения Из Параметры.ОбъектыДоЗаполнения Цикл
		ТипОбъекта = ТипЗнч(ОбъектДоЗаполнения);
		Если ТипОбъекта = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ФизЛицо = ОбъектДоЗаполнения.ПолучитьОбъект();
			Если ФизЛицо <> Неопределено Тогда
				ОбновлениеФИОФизЛица (ОбъектДоЗаполнения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьШтрихкодыУЗагруженныхКартЛояльности (Параметры);
	УстановитьШтрихкодыУЗагруженныхПС (Параметры);

КонецПроцедуры

Процедура Конвертация_ПриПолученииИнформацииОбУдалении(Объект, Отказ) Экспорт

	МетаданныеОбъекта = Объект.Метаданные();
	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта)	Тогда	
		Отказ  = Истина;	
		Если НЕ Объект.Предопределенный Тогда
			УстановитьПометкуУдаленияУОбъекта(Объект, Истина, "Справочник");	
		КонецЕсли;
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда	
		Отказ  = Истина;	
		Если Объект.Проведен Тогда		
			ОтменитьПроведениеОбъектаВИБ(Объект, ТипЗнч(Объект));		
		КонецЕсли;	
		УстановитьПометкуУдаленияУОбъекта(Объект, Истина, "Документ");	
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда	
		Отказ  = Истина;	
		Если НЕ Объект.Предопределенный Тогда
			УстановитьПометкуУдаленияУОбъекта(Объект, Истина, "ПланВидовХарактеристик");	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура Конвертация_ПослеПолученияИнформацииОбУзлахОбмена(УзелОбменаЗагрузкаДанных) Экспорт

	Параметры.Вставить("АналитикаХозОперации_ОприходованиеТоваров", УзелОбменаЗагрузкаДанных.АналитикаХозОперации_ОприходованиеТоваров);
	Параметры.Вставить("АналитикаХозОперации_СписаниеТоваров", УзелОбменаЗагрузкаДанных.АналитикаХозОперации_СписаниеТоваров);
	Параметры.Вставить("АналитикаХозОперации_ВозвратПоставщику", УзелОбменаЗагрузкаДанных.АналитикаХозОперации_ВозвратПоставщику);
	Параметры.Вставить("ГруппаПодарочныеСертификаты", УзелОбменаЗагрузкаДанных.ГруппаПодарочныеСертификаты);
	Параметры.Вставить("ОбъектыДоЗаполнения", Новый Массив());
	
	Параметры.Вставить("ЗагружаемыеКартыЛояльности", Новый ТаблицаЗначений);
	Параметры.ЗагружаемыеКартыЛояльности.Колонки.Добавить("Объект");
	Параметры.ЗагружаемыеКартыЛояльности.Колонки.Добавить("Штрихкод");
	
	Параметры.Вставить("ЗагружаемыеПодарочныеСертификаты", Новый ТаблицаЗначений);
	Параметры.ЗагружаемыеПодарочныеСертификаты.Колонки.Добавить("Объект");
	Параметры.ЗагружаемыеПодарочныеСертификаты.Колонки.Добавить("Штрихкод");
	
	Параметры.Вставить("ВидыНоменклатурыПоУмолчанию", Справочники.ВидыНоменклатуры.ПустаяСсылка());

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОНВЕРТАЦИИ ОБЪЕКТОВ
// В данном разделе разрешено изменять реализацию процедур.

Процедура ПКО_ВидыНоменклатуры_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ Объект.ЭтоГруппа Тогда
		Если Объект.ЭтоНовый() Тогда
			ЗаполнитьВидПродукцииИС (ПараметрыОбъекта, Объект);
			
			ОписаниеНоменклатуры = РегистрыСведений.ОписаниеНоменклатурыИС.Получить(Новый Структура("Номенклатура", Объект.Ссылка));
			Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
				КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ЗначениеПеречисленияПоКлючу(ОписаниеНоменклатуры.КлючВидовПродукции);
			КонецЕсли;
			Объект.ПризнакПредметаРасчета = РозничныеПродажиСервер.ПолучитьОжидаемыйПризнакПредметаРасчета(Объект.ТипНоменклатуры, КлючВидовПродукции, Объект.ПродаетсяВРозлив);
	
			ЗаписатьОбъектВИБ(Объект, Тип("СправочникОбъект.ВидыНоменклатуры"));					
		Иначе	
			ТипНоменклатурыСсылки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ТипНоменклатуры");
			Если ТипНоменклатурыСсылки =  Перечисления.ТипыНоменклатуры.ПодарочныйСертификат Тогда
				Объект.ТипНоменклатуры = ТипНоменклатурыСсылки;
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ВидыПодарочныхСертификатов_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	ЗаполнитьВидНоменклатурыПодарочныйСертификат (Объект, Параметры);
	
	Если Не ЗначениеЗаполнено(Объект.Родитель) Тогда
		Объект.Родитель = Параметры.ГруппаПодарочныеСертификаты;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		Код = "796";
		Объект.ЕдиницаИзмерения = Справочники.БазовыеЕдиницыИзмерения.НайтиПоКоду(Код);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		Объект.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию();
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ВозвратТоваровПоставщику_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	ЗаполнитьСкладПоступления (Объект);
	Если Объект.АналитикаХозяйственнойОперации.Пустая() Тогда
		Объект.АналитикаХозяйственнойОперации = Параметры.АналитикаХозОперации_ВозвратПоставщику;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ДоговорыКомиссии_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Объект.БанковскийСчет = ЗначениеНастроекПовтИсп.БанковскийСчетОрганизацииПоУмолчанию(Объект.Организация,,);

КонецПроцедуры

Процедура ПКО_ДоговорыКомиссии_ПоследовательностьПолейПоиска(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск,
	СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, СтрокаИменСвойствПоиска) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Агент = &Агент
	|	И ДоговорыКонтрагентов.ПроцентКомиссионногоВознаграждения = &ПроцентКомиссионногоВознаграждения
	|	И ДоговорыКонтрагентов.СпособРасчетаКомиссионногоВознаграждения = &СпособРасчетаКомиссионногоВознаграждения
	|	И ДоговорыКонтрагентов.ЦенаВключаетНДС = &ЦенаВключаетНДС
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления");
	Для Каждого СвойствоПоиска Из СвойстваПоиска Цикл 
		Запрос.УстановитьПараметр(СвойствоПоиска.Ключ, СвойствоПоиска.Значение);
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СсылкаНаОбъект = Выборка.Ссылка;
	КонецЕсли;
	ПрекратитьПоиск = Истина;

КонецПроцедуры

Процедура ПКО_ДоговорыПлатежныхАгентов_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ ОбъектНайден Тогда
	Объект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	Объект.БанковскийСчет = Справочники.БанковскиеСчета.ПолучитьБанковскийСчетПоУмолчанию(Объект.Организация, Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ДополнительныеРеквизитыИСведения_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если ПараметрыОбъекта <> Неопределено Тогда
		ТипСвойства = ПараметрыОбъекта["ТипСвойства"];
	КонецЕсли;
	
	Если ТипСвойства = "Строка"
		Или ТипСвойства = "Число"
		Или ТипСвойства = "Дата"
		Или ТипСвойства = "Булево"
		Или ТипСвойства = "Неопределено" Тогда
		
		Объект.ТипЗначения = Новый ОписаниеТипов(ТипСвойства);
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ЗаявкаНаРасходованиеДенежныхСредств_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Отказ = Не Константы.ИспользоватьЗаявкиНаРасходованиеДС.Получить();

КонецПроцедуры

Процедура ПКО_ИнвентаризацияТоваров_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	ЗаполнитьСкладПоступления (Объект);
	Объект.СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(Объект.Товары, Истина);
	Если НЕ ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Склад)
		И ЗначениеЗаполнено(Объект.Склад.Организация) Тогда
		Объект.Организация = Объект.Склад.Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_КартыЛояльности_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	НоваяСтрока = Параметры.ЗагружаемыеКартыЛояльности.Добавить();
	НоваяСтрока.Объект = Объект;
	НоваяСтрока.Штрихкод = ПараметрыОбъекта["Штрихкод"];

КонецПроцедуры

Процедура ПКО_Контрагенты_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если Объект.ЭтоНовый() Тогда
		КонтрагентСсылка = Объект.ПолучитьСсылкуНового();
		ИскомаяСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(КонтрагентСсылка.УникальныйИдентификатор());
		Если ОбщегоНазначения.СсылкаСуществует(ИскомаяСсылка) Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_МаркировкаТоваровГИСМ_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПоступления"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПоступления;		
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_НаборыДополнительныхРеквизитовИСведений_ПоследовательностьПолейПоиска(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск,
	СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, СтрокаИменСвойствПоиска) Экспорт

	Если СвойстваПоиска["ЭтоГруппа"] Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
			|ВЫБРАТЬ
			|	Т.Ссылка КАК Ссылка,
			|	Т.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
			|ИЗ
			|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК Т
			|ГДЕ
			|	Т.ИмяПредопределенныхДанных <> """"
			|	И Т.ЭтоГруппа = &ЭтоГруппа
			|	И НЕ Т.ПометкаУдаления
			|";
		Запрос.УстановитьПараметр("ЭтоГруппа", СвойстваПоиска["ЭтоГруппа"]);
	
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ИмяПредопределенныхДанных = СвойстваПоиска["ИмяПредопределенногоНабора"] Тогда
				СсылкаНаОбъект = Выборка.Ссылка;
				ПрекратитьПоиск = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_Номенклатура_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ Объект.ЭтоГруппа Тогда
	
		ЗаполнитьВидПродукцииИС (ПараметрыОбъекта, Объект);
	
		Если Объект.ЭтоНовый() Тогда
			ЗаписатьОбъектВИБ(Объект, Тип("СправочникОбъект.Номенклатура"));
		Иначе
			СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "ТипНоменклатуры, ВидНоменклатуры");
			Если СтруктураРеквизитов.ТипНоменклатуры =  Перечисления.ТипыНоменклатуры.ПодарочныйСертификат 
				ИЛИ (ЗначениеЗаполнено(СтруктураРеквизитов.ВидНоменклатуры) 
				И СтруктураРеквизитов.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат) Тогда
				Объект.ТипНоменклатуры = СтруктураРеквизитов.ТипНоменклатуры;
				Объект.ВидНоменклатуры = СтруктураРеквизитов.ВидНоменклатуры;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

