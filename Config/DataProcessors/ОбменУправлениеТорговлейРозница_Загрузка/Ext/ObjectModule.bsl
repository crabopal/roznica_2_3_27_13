Процедура ЗаполнитьВидНоменклатурыПодарочныйСертификат(Объект, Параметры) Экспорт

	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Если Не ЗначениеЗаполнено(Параметры.ВидыНоменклатурыПоУмолчанию) Тогда
	
	          НеобходимоСоздатьЭлемент = Ложь;
	          НаименованиеЭлементаДляОбменаПоУмолчанию = НСтр("ru = 'Подарочный сертификат'", Метаданные.ОсновнойЯзык.КодЯзыка);
	
	          Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
	               |     ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры,
	               |     ВЫБОР
	               |          КОГДА ВидыНоменклатуры.Наименование = &НаименованиеЭлементаДляОбменаПоУмолчанию
	               |               ТОГДА ИСТИНА
	               |          ИНАЧЕ ЛОЖЬ
	               |     КОНЕЦ КАК ЭтоЭлементПоУмолчаниюДляОбмена
	               |ИЗ
	               |     Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	               |ГДЕ
	               |     НЕ ВидыНоменклатуры.ПометкаУдаления
	               |     И ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |     ЭтоЭлементПоУмолчаниюДляОбмена УБЫВ");
	
	          Запрос.УстановитьПараметр("НаименованиеЭлементаДляОбменаПоУмолчанию", НаименованиеЭлементаДляОбменаПоУмолчанию);
	          РезультатЗапроса = Запрос.Выполнить();
	
	          Выборка = РезультатЗапроса.Выбрать();
	          Если Выборка.Следующий() Тогда
	               Если Выборка.Количество() = 1 Или Выборка.ЭтоЭлементПоУмолчаниюДляОбмена Тогда
	                    ВидНоменклатуры = Выборка.ВидНоменклатуры;
	               Иначе
	                    НеобходимоСоздатьЭлемент = Истина;
	               КонецЕсли;
	          Иначе
	               НеобходимоСоздатьЭлемент = Истина;
	          КонецЕсли;
	
	          // Создание элемента для обмена с заданными параметрами
	          Если НеобходимоСоздатьЭлемент Тогда
	               
	               ВидНоменклатурыОбъект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	               
	               ВидНоменклатурыОбъект.Наименование               = НаименованиеЭлементаДляОбменаПоУмолчанию;
	               ВидНоменклатурыОбъект.ИспользованиеХарактеристик = Ложь;
	               ВидНоменклатурыОбъект.ТипНоменклатуры            = Перечисления.ТипыНоменклатуры.ПодарочныйСертификат;
	               
	               Попытка
	                    ВидНоменклатурыОбъект.Записать();
	                    ВидНоменклатуры = ВидНоменклатурыОбъект.Ссылка;
	               Исключение
	                    ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	               КонецПопытки
	          КонецЕсли;
	          
	          Параметры.ВидыНоменклатурыПоУмолчанию = ВидНоменклатуры;
	          
	     КонецЕсли;
	     
	     Объект.ВидНоменклатуры = Параметры.ВидыНоменклатурыПоУмолчанию;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьВидПродукцииИС(ПараметрыОбъекта, Объект) Экспорт

	Если Объект.ЭтоНовый() Тогда
		СсылкаНаОбъект = Объект.ПолучитьСсылкуНового();
	Иначе
		СсылкаНаОбъект = Объект.Ссылка;
	КонецЕсли;
	
	Если ПараметрыОбъекта <> Неопределено
		И ПараметрыОбъекта.Получить("ВидПродукцииИС") <> Неопределено Тогда
	
		Значение = ПараметрыОбъекта["ВидПродукцииИС"];
		
		ВидПродукцииИС = Неопределено;
		
		Попытка
			ВидПродукцииИС = XMLЗначение(Тип("ПеречислениеСсылка.ВидыПродукцииИС"), Значение);
		Исключение
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ВидПродукцииИС) Тогда
		
			СтрокаЗаписи = РегистрыСведений.ОписаниеНоменклатурыИС.СоздатьМенеджерЗаписи();
			СтрокаЗаписи.Номенклатура = СсылкаНаОбъект;
			СтрокаЗаписи.Прочитать();
			
			Если Не СтрокаЗаписи.Выбран() Тогда
				СтрокаЗаписи.Номенклатура = СсылкаНаОбъект;
			КонецЕсли;
			
			СтрокаЗаписи.КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.КлючПоЗначениюПеречисления(
				ВидПродукцииИС,
				Неопределено,
				Объект.ВидАлкогольнойПродукцииЕГАИС.Маркируемый);
	
			Если ЗначениеЗаполнено(СтрокаЗаписи.КлючВидовПродукции) Тогда	
				Попытка
					СтрокаЗаписи.Записать();
				Исключение
					ИмяСобытия = НСтр("ru = 'Не удалось записать Описание номенклатуры ИС по товару %1'",
						ОбщегоНазначения.КодОсновногоЯзыка());
					ИмяСобытия = СтрШаблон(ИмяСобытия, СсылкаНаОбъект);
					
					ЗаписьЖурналаРегистрации(ИмяСобытия,
						УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
	
		СтрокаЗаписи = РегистрыСведений.ОписаниеНоменклатурыИС.СоздатьМенеджерЗаписи(); 
	    СтрокаЗаписи.Номенклатура = СсылкаНаОбъект; 
	    СтрокаЗаписи.Прочитать(); 
	    
	    Если СтрокаЗаписи.Выбран() Тогда 
	        Попытка 
	            СтрокаЗаписи.Удалить(); 
	        Исключение 
	            ИмяСобытия = НСтр("ru = 'Не удалось удалить Описание номенклатуры ИС по товару %1'"); 
	            ИмяСобытия = СтрШаблон(ИмяСобытия, СсылкаНаОбъект); 
	            ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
	        КонецПопытки;
	    КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОрганизациюПоСкладу(Объект) Экспорт

	Если НЕ ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Склад)
		И ЗначениеЗаполнено(Объект.Склад.Организация) Тогда
		Объект.Организация = Объект.Склад.Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСкладПоступления(Объект) Экспорт

	 Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПоступления"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПоступления;
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Неопределено
				И ЗначениеЗаполнено(РеквизитМагазин)
				И РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСкладПродажи(Объект) Экспорт

	 Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПродажи"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПродажи;
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Неопределено
				И ЗначениеЗаполнено(РеквизитМагазин)
				И РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОбновлениеОтветственныхЛицОрганизации(Объект, ПараметрыОбъекта) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Должность,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
	|			,
	|			СтруктурнаяЕдиница = &Ссылка
	|				И ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаОрганизацийСрезПоследних");
						  
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ПериодЗаписи				= '19800101';
		СтароеЗначениеРуководителя	= Справочники.ФизическиеЛица.ПустаяСсылка();
		СтараяДолжностьРуководителя	= Справочники.ДолжностиОрганизаций.ПустаяСсылка();
	Иначе
		ВыборкаРезультата = Результат.Выбрать();
		ВыборкаРезультата.Следующий();
		ПериодЗаписи				= ВыборкаРезультата.Период;
		СтароеЗначениеРуководителя	= ВыборкаРезультата.ФизическоеЛицо;
		СтараяДолжностьРуководителя	= ВыборкаРезультата.Должность;
	КонецЕсли;
	
	НовоеЗначениеРуководителя = ПараметрыОбъекта["Руководитель"];
	НовоеЗначениеРуководителя = ?(ЗначениеЗаполнено(НовоеЗначениеРуководителя), НовоеЗначениеРуководителя, Справочники.ФизическиеЛица.ПустаяСсылка());
	НоваяДолжностьРуководителя = ПараметрыОбъекта.Получить("ДолжностьРуководителя");
	НоваяДолжностьРуководителя = ?(ЗначениеЗаполнено(НоваяДолжностьРуководителя), НоваяДолжностьРуководителя, Справочники.ДолжностиОрганизаций.ПустаяСсылка());
	Если НовоеЗначениеРуководителя <> СтароеЗначениеРуководителя 
		ИЛИ НоваяДолжностьРуководителя <> СтараяДолжностьРуководителя Тогда
		ЗаписьРегистра = РегистрыСведений.ОтветственныеЛицаОрганизаций.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Период				= ПериодЗаписи;
		ЗаписьРегистра.СтруктурнаяЕдиница	= Объект.Ссылка;
		ЗаписьРегистра.ОтветственноеЛицо	= Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;
		ЗаписьРегистра.ФизическоеЛицо		= НовоеЗначениеРуководителя;
		ЗаписьРегистра.Должность			= НоваяДолжностьРуководителя;
		ЗаписьРегистра.Записать();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Должность,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
	|			,
	|			СтруктурнаяЕдиница = &Ссылка
	|				И ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаОрганизацийСрезПоследних");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда  	
		ПериодЗаписи						= '19800101';
		СтароеЗначениеГлавногоБухгалтера	= Справочники.ФизическиеЛица.ПустаяСсылка();
		СтараяДолжностьГлавногоБухгалтера	= Справочники.ДолжностиОрганизаций.ПустаяСсылка();	
	Иначе                                                                                     	
		ВыборкаРезультата = Результат.Выбрать();
		ВыборкаРезультата.Следующий();                                                        	
		ПериодЗаписи						= ВыборкаРезультата.Период;
		СтароеЗначениеГлавногоБухгалтера	= ВыборкаРезультата.ФизическоеЛицо;
		СтараяДолжностьГлавногоБухгалтера	= ВыборкаРезультата.Должность;	
	КонецЕсли;                                                            
	НовоеЗначениеГлавногоБухгалтера = ПараметрыОбъекта["ГлавныйБухгалтер"];
	НовоеЗначениеГлавногоБухгалтера = ?(ЗначениеЗаполнено(НовоеЗначениеРуководителя), НовоеЗначениеГлавногоБухгалтера, Справочники.ФизическиеЛица.ПустаяСсылка());							  
	Если СтароеЗначениеГлавногоБухгалтера <> НовоеЗначениеГлавногоБухгалтера Тогда
		ЗаписьРегистра = РегистрыСведений.ОтветственныеЛицаОрганизаций.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Период				= ПериодЗаписи;
		ЗаписьРегистра.СтруктурнаяЕдиница	= Объект.Ссылка;
		ЗаписьРегистра.ОтветственноеЛицо	= Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер;
		ЗаписьРегистра.ФизическоеЛицо		= НовоеЗначениеГлавногоБухгалтера;
		ЗаписьРегистра.Должность			= СтараяДолжностьГлавногоБухгалтера;	
		ЗаписьРегистра.Записать();	
	КонецЕсли;

КонецПроцедуры

Процедура ОбновлениеФИОФизЛица(ОбъектДоЗаполнения) Экспорт

	ФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(ОбъектДоЗаполнения.Наименование)," ");
	КоличествоПодстрок = ФИО.Количество();
	Фамилия            = ?(КоличествоПодстрок > 0,ФИО[0],"");
	Имя                = ?(КоличествоПодстрок > 1,ФИО[1],"");
	Отчество           = ?(КоличествоПодстрок > 2,ФИО[2],"");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ФИОФизЛицСрезПоследних.Фамилия,
	                      |	ФИОФизЛицСрезПоследних.Имя,
	                      |	ФИОФизЛицСрезПоследних.Отчество
	                      |ИЗ
	                      |	РегистрСведений.ФИОФизЛиц.СрезПоследних(&Период, ФизЛицо = &Ссылка) КАК ФИОФизЛицСрезПоследних");
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Ссылка", ОбъектДоЗаполнения.Ссылка);
	Результат = Запрос.Выполнить();
	
	НужноОбновитьЗапись = Ложь;
	
	Если Результат.Пустой() Тогда
		ПериодЗаписи = '19800101';
		НужноОбновитьЗапись = Истина;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Если Выборка.Фамилия <> Фамилия
			ИЛИ Выборка.Отчество <> Отчество
			ИЛИ Выборка.Имя <> Имя Тогда
			ПериодЗаписи = ТекущаяДата();
			НужноОбновитьЗапись = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НужноОбновитьЗапись Тогда
		МенеджерЗаписи = РегистрыСведений.ФИОФизЛиц.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ФизЛицо 	= ОбъектДоЗаполнения.Ссылка;
		МенеджерЗаписи.Период 	= ПериодЗаписи;
		МенеджерЗаписи.Фамилия 	= Фамилия;
		МенеджерЗаписи.Имя 		= Имя;
		МенеджерЗаписи.Отчество = Отчество;
		МенеджерЗаписи.Записать(Истина);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьШтрихкодыУЗагруженныхКартЛояльности(Параметры) Экспорт

	Для Каждого Строка Из Параметры.ЗагружаемыеКартыЛояльности Цикл
		
		Объект = Строка.Объект;
		Если Объект.ЭтоНовый() Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка			= Объект.Ссылка;
		ВидКарты		= Объект.ВидКарты;
		ШтрихкодКарты	= Строка.Штрихкод;
		
		НаборЗаписейШтрихкодов = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		НаборЗаписейШтрихкодов.Отбор.Владелец.Установить(Ссылка);
		УстановитьОбменДаннымиЗагрузка(НаборЗаписейШтрихкодов);
		
		Если (ВидКарты = Перечисления.ВидыИнформационныхКарт.Штриховая
			ИЛИ  ВидКарты = Перечисления.ВидыИнформационныхКарт.Смешанная)
			И ЗначениеЗаполнено(ШтрихкодКарты) Тогда
			
			НаборЗаписейШтрихкодов.Прочитать();
			Если НаборЗаписейШтрихкодов.Количество() <> 1 Тогда
				ЗаписьШтрихкода              = НаборЗаписейШтрихкодов.Добавить();
				ЗаписьШтрихкода.Владелец     = Ссылка;
				ЗаписьШтрихкода.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
				ЗаписьШтрихкода.Штрихкод     = ШтрихкодКарты;
			Иначе
				ЗаписьШтрихкода				 = НаборЗаписейШтрихкодов[0];
				ЗаписьШтрихкода.Штрихкод     = ШтрихкодКарты;
			КонецЕсли;
		КонецЕсли;
		НаборЗаписейШтрихкодов.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьШтрихкодыУЗагруженныхПС(Параметры) Экспорт

	Для Каждого Строка Из Параметры.ЗагружаемыеПодарочныеСертификаты Цикл
		
		Объект = Строка.Объект;
		Если Объект.ЭтоНовый() Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка		= Объект.Ссылка;
		ШтрихкодПС	= Строка.Штрихкод;
		ТипШК		= ПодключаемоеОборудованиеРТ.ТипШтрихкода(ШтрихкодПС);
		
		ЗаписьШтрихкода        		 = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
		ЗаписьШтрихкода.Владелец     = Ссылка;
		ЗаписьШтрихкода.ТипШтрихкода = ТипШК;
		ЗаписьШтрихкода.Штрихкод     = ШтрихкодПС;
		
		ЕстьДубли = НЕ ЗаписьШтрихкода.ПроверитьЗаполнение();
		
		Если НЕ ЕстьДубли Тогда
			ЗаписьШтрихкода.Записать(Истина);
		Иначе
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

