Процедура ПКО_ПеремаркировкаТоваровГИСМ_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ Объект.Магазин.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Магазин, "СкладУправляющейСистемы, СкладПоступления"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.Склад = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.Склад.Пустая() Тогда
			Объект.Склад = СтруктураРеквизитов.СкладПоступления;		
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "Магазин");
			Если РеквизитМагазин <> Объект.Магазин Тогда
				Объект.Склад = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПеремещениеТоваров_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если ОбъектНайден
		И Ссылка.Организация <> Ссылка.ОрганизацияПолучатель Тогда
		Объект.ОрганизацияПолучатель = Ссылка.ОрганизацияПолучатель;
	КонецЕсли;
	Если НЕ Объект.МагазинОтправитель.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.МагазинОтправитель, "СкладУправляющейСистемы, СкладПоступления"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.СкладОтправитель = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.СкладОтправитель.Пустая() Тогда
			Объект.СкладОтправитель = СтруктураРеквизитов.СкладПоступления;		
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СкладОтправитель, "Магазин");
			Если РеквизитМагазин <> Объект.МагазинОтправитель Тогда
				Объект.СкладОтправитель = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Если НЕ Объект.МагазинПолучатель.Пустая() Тогда
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.МагазинПолучатель, "СкладУправляющейСистемы, СкладПоступления"); 
		Если СтруктураРеквизитов.СкладУправляющейСистемы = Истина Тогда
			Объект.СкладПолучатель = Справочники.Склады.ПустаяСсылка();
		ИначеЕсли Объект.СкладПолучатель.Пустая() Тогда
			Объект.СкладПолучатель = СтруктураРеквизитов.СкладПоступления;		
		Иначе
			РеквизитМагазин = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СкладПолучатель, "Магазин");
			Если РеквизитМагазин <> Объект.МагазинПолучатель Тогда
				Объект.СкладПолучатель = Справочники.Склады.ПустаяСсылка();
			КонецЕсли;	
		КонецЕсли; 
	КонецЕсли;
	
	Если ПараметрыОбъекта <> Неопределено Тогда
		НомерГТД = ПараметрыОбъекта.Получить("НомерГТД");
		ДвиженияТоварыОрганизацииНомераГТД (Объект);
	КонецЕсли;
	
	Объект.СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.СуммаДокумента(Объект.Товары, Истина);

КонецПроцедуры

