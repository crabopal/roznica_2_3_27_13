Процедура ПКО_УстановкаСебестоимости_ПоследовательностьПолейПоиска(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск,
	СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, СтрокаИменСвойствПоиска) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	УстановкаСебестоимости.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УстановкаСебестоимости КАК УстановкаСебестоимости
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(УстановкаСебестоимости.Дата, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|	И УстановкаСебестоимости.Магазин = &Магазин
	|	И УстановкаСебестоимости.ПринятИзУправляющейСистемы");
						  
	Запрос.УстановитьПараметр("Магазин", СвойстваПоиска["Магазин"]);
	Запрос.УстановитьПараметр("Дата", СвойстваПоиска["Дата"]);
	ВыборкаРезультатаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаРезультатаЗапроса.Следующий() Тогда
		СсылкаНаОбъект = ВыборкаРезультатаЗапроса.Ссылка;
	КонецЕсли;
	
	ПрекратитьПоиск = Истина;

КонецПроцедуры

Процедура ПКО_ФизическиеЛица_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если Объект.ЭтоНовый() Тогда
		Параметры.ОбъектыДоЗаполнения.Добавить(Объект.ПолучитьСсылкуНового());
	Иначе
		Параметры.ОбъектыДоЗаполнения.Добавить(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_Штрихкоды_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	ИскомыйШтрихкод = Объект.Отбор.Штрихкод.Значение; 
	ЗапросПоШтрихкодам = Новый Запрос;
	ЗапросПоШтрихкодам.Текст = "ВЫБРАТЬ
	|	Штрихкоды.Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &ИскомыйШтрихкод
	|	И Штрихкоды.Владелец ССЫЛКА Справочник.СерийныеНомера";
	
	ЗапросПоШтрихкодам.УстановитьПараметр("ИскомыйШтрихкод", ИскомыйШтрихкод);
	РезультатЗапроса = ЗапросПоШтрихкодам.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда 	
		Объект = Неопределено;              	
	Иначе
		ЗаписиНабора = Объект.Выгрузить();
		
		Для Каждого ЗаписьНабора Из ЗаписиНабора Цикл
			ЗаписьНабора.ТипШтрихкода = ПодключаемоеОборудованиеРТ.ТипШтрихкода(ИскомыйШтрихкод);
		КонецЦикла;
		
		Объект.Загрузить(ЗаписиНабора);
	КонецЕсли;

КонецПроцедуры

