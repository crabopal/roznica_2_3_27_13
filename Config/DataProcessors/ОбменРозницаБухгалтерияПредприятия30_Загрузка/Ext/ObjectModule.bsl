		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 2
		|	СоответствиеПодразделенийОрганизацийМагазинам.Магазин КАК Магазин
		|ИЗ
		|	РегистрСведений.СоответствиеПодразделенийОрганизацийМагазинам КАК СоответствиеПодразделенийОрганизацийМагазинам
		|ГДЕ
		|	СоответствиеПодразделенийОрганизацийМагазинам.КодПодразделения = &КодПодразделения
		|";
		Запрос.УстановитьПараметр("КодПодразделения", ПараметрыОбъекта.Получить("КодПодразделенияОрганизации"));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0.00 ИЛИ Выборка.Количество() > 1.00 Тогда
			Объект.Магазин = Справочники.Магазины.ПустаяСсылка();
		Иначе
			Если Выборка.Следующий() Тогда
				Объект.Магазин = Выборка.Магазин;
			Иначе
				Объект.Магазин = Справочники.Магазины.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПоступлениеНаРасчетныйСчет_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		ДокРасчетов = СтрокаРасшифровки.ДокументРасчетовСКонтрагентом;
		Если ДокРасчетов.Пустая()
			ИЛИ ДокРасчетов.Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Отказ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПКО_СписаниеСРасчетногоСчета_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		ДокРасчетов = СтрокаРасшифровки.ДокументРасчетовСКонтрагентом;
		Если ДокРасчетов.Пустая()
			ИЛИ ДокРасчетов.Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Отказ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПКО_ФизическиеЛица_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован,
	ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если НЕ Объект.ЭтоГруппа И Объект.ЭтоНовый() Тогда
		Если ТипЗнч(ПараметрыОбъекта) = Тип("Соответствие") И ПараметрыОбъекта.Получить("КодПодразделенияОрганизации") <> Неопределено Тогда
			Запрос = Новый Запрос();
			Запрос.Текст = "
			|ВЫБРАТЬ ПЕРВЫЕ 2
			|	СоответствиеПодразделенийОрганизацийМагазинам.Магазин КАК Магазин
			|ИЗ
			|	РегистрСведений.СоответствиеПодразделенийОрганизацийМагазинам КАК СоответствиеПодразделенийОрганизацийМагазинам
			|ГДЕ
			|	СоответствиеПодразделенийОрганизацийМагазинам.КодПодразделения = &КодПодразделения
			|";
			Запрос.УстановитьПараметр("КодПодразделения", ПараметрыОбъекта.Получить("КодПодразделенияОрганизации"));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Количество() = 0.00 ИЛИ Выборка.Количество() > 1.00 Тогда
				Объект.Магазин = Справочники.Магазины.ПустаяСсылка();
			Иначе
				Если Выборка.Следующий() Тогда
					Объект.Магазин = Выборка.Магазин;
					Объект.Сотрудник = Истина;
				Иначе
					Объект.Магазин = Справочники.Магазины.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

