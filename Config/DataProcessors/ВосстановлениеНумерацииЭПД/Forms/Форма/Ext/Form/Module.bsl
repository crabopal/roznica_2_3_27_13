#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ВидДокумента.СписокВыбора.Добавить("", НСтр("ru = 'Все виды'"));
	Для Каждого Вид Из НумерацияЭПД.ВидыДокументов() Цикл
		Элементы.ВидДокумента.СписокВыбора.Добавить(Вид.Имя, Вид.Представление);
	КонецЦикла;
	Элементы.ВидДокумента.РежимВыбораИзСписка = Истина;
	Элементы.Год.Формат = "ЧГ=0";
	Элементы.Год.ФорматРедактирования = "ЧГ=0";

	ИмяДокумента = Параметры.ИмяДокумента;
	Год = Год(?(ЗначениеЗаполнено(Параметры.Дата), Параметры.Дата, ТекущаяДатаСеанса()));
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		Заголовок = НСтр("ru = 'Нарушена нумерация документов'");
	КонецЕсли;

	Если ТипЗнч(Параметры.Итог) = Тип("Структура") Тогда
		ПоказатьИтог(Параметры.Итог);
	ИначеЕсли ЗначениеЗаполнено(ИмяДокумента) Тогда
		Элементы.ТекстПредупреждения.Заголовок = СтрШаблон(
			НСтр("ru = 'Нарушена нумерация документов «%1»: %2 есть документ с внутренним номером «%3», из-за которого сбилась автонумерация. Необходимо её восстановить.'"),
			Метаданные.Документы[ИмяДокумента].Представление(),
			?(Год = Год(ТекущаяДатаСеанса()), НСтр("ru = 'в текущем году'"),
				СтрШаблон(НСтр("ru = 'в %1 году'"), Формат(Год, "ЧГ=0"))),
			Параметры.Номер);
	КонецЕсли;

	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)

	СброситьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ГодПриИзменении(Элемент)

	СброситьИтог();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультаты

&НаКлиенте
Процедура РезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Элементы.Результаты.ТекущиеДанные.Документ);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Восстановить(Команда)

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Будут изменены внутренние номера у %1 ЭПД за %2 год. Номера, указанные в самих документах (в накладных, путевых листах и других ЭПД), не изменятся.
			|
			|Продолжить?'"),
		СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 документа;;%1 документов;%1 документов;%1 документа'"), КоличествоПроблемных),
		Формат(Год, "ЧГ=0"));
	ПоказатьВопрос(Новый ОписаниеОповещения("ВосстановитьПослеВопроса", ЭтотОбъект), ТекстВопроса,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ТехническаяИнформация(Команда)

	Элементы.ГруппаТехническаяИнформация.Видимость = Не Элементы.ГруппаТехническаяИнформация.Видимость;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВосстановитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = ВосстановитьНаСервере();

	Для Каждого Исправление Из Итог.Исправлено Цикл
		ОповеститьОбИзменении(Исправление.Документ);
	КонецЦикла;

	// Пока нумерация вида не восстановлена, запись документа снова откроет это окно.
	Если ЗначениеЗаполнено(ИмяДокумента) И Итог.НумерацияВидаВосстановлена Тогда
		Закрыть(Итог);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВосстановитьНаСервере()

	Итог = НумерацияЭПД.ВосстановитьНумерацию(ВидДокумента, Год);
	Итог.Вставить("НумерацияВидаВосстановлена", ЗначениеЗаполнено(ИмяДокумента)
		И НумерацияЭПД.ПроблемныеДокументы(ИмяДокумента, Год).Количество() = 0);
	ПоказатьИтог(Итог);
	ОбновитьСостояние();

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ПоказатьИтог(Итог)

	Восстановлено = Истина;

	Результаты.Очистить();
	Для Каждого Исправление Из Итог.Исправлено Цикл
		ЗаполнитьЗначенияСвойств(Результаты.Добавить(), Исправление);
	КонецЦикла;

	Исправлено = КоличествоДокументов(Итог.Исправлено.Количество());
	Если Итог.Ошибки.Количество() = 0 И Итог.ПропущеноБезПрав.Количество() = 0 И Итог.АвтонумерацияОбновлена Тогда
		ТекстИтога = СтрШаблон(НСтр("ru = 'Нумерация восстановлена: исправлено %1.'"), Исправлено);
	Иначе
		Части = Новый Массив;
		Части.Добавить(СтрШаблон(НСтр("ru = 'Исправлено %1.'"), Исправлено));
		Если Итог.ПропущеноБезПрав.Количество() > 0 Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Пропущено %1: недостаточно прав на изменение.'"),
				КоличествоДокументов(Итог.ПропущеноБезПрав.Количество())));
		КонецЕсли;
		Если Итог.Ошибки.Количество() > 0 Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Не удалось исправить %1, подробности в журнале регистрации.'"),
				КоличествоДокументов(Итог.Ошибки.Количество())));
		КонецЕсли;
		Если Не Итог.АвтонумерацияОбновлена Тогда
			Части.Добавить(НСтр("ru = 'Автонумерацию платформы обновить не удалось, подробности в журнале регистрации.'"));
		КонецЕсли;
		ТекстИтога = СтрСоединить(Части, " ");
	КонецЕсли;
	Элементы.НадписьИтог.Заголовок = ТекстИтога;

	Если Итог.Свойство("ДокументЗаписан") Тогда
		Если Итог.ДокументЗаписан Тогда
			ТекстЗаписи = СтрШаблон(НСтр("ru = 'Текущий документ записан: %1.'"), Итог.Документ);
		Иначе
			ТекстЗаписи = НСтр("ru = 'Нумерация восстановлена, но документ не записан: причины указаны в сообщениях формы документа. Закройте окно и исправьте документ.'");
		КонецЕсли;
		Элементы.ТекстДокументЗаписан.Заголовок = ТекстЗаписи;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СброситьИтог()

	Восстановлено = Ложь;
	Результаты.Очистить();
	Элементы.ГруппаТехническаяИнформация.Видимость = Ложь;
	ОбновитьСостояние();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояние()

	Проблемные = НумерацияЭПД.ПроблемныеДокументы(ВидДокумента, Год);
	КоличествоПроблемных = Проблемные.Количество();
	Если КоличествоПроблемных > 0 Тогда
		Элементы.НадписьПроблемы.Заголовок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';Есть %1 документ, у которого сбита внутренняя нумерация.;;Есть %1 документа, у которых сбита внутренняя нумерация.;Есть %1 документов, у которых сбита внутренняя нумерация.;Есть %1 документа, у которых сбита внутренняя нумерация.'"),
			КоличествоПроблемных);
		Элементы.НадписьРазбивка.Заголовок = РазбивкаПоВидам(Проблемные);
	КонецЕсли;

	РежимПредупреждения = ЗначениеЗаполнено(ИмяДокумента);

	Элементы.ГруппаПредупреждение.Видимость = РежимПредупреждения И Не Восстановлено;
	Элементы.ГруппаОтбор.Видимость = Не РежимПредупреждения;
	Элементы.НадписьИтог.Видимость = Восстановлено;
	Элементы.НадписьПроблемы.Видимость = КоличествоПроблемных > 0;
	Элементы.НадписьРазбивка.Видимость = КоличествоПроблемных > 0 И Не ЗначениеЗаполнено(ВидДокумента);
	Элементы.НадписьНетПроблем.Видимость = КоличествоПроблемных = 0;
	Элементы.ГруппаДокументЗаписан.Видимость = ЗначениеЗаполнено(СокрЛП(Элементы.ТекстДокументЗаписан.Заголовок));
	Элементы.ТехническаяИнформация.Видимость = Восстановлено И Результаты.Количество() > 0;

	Элементы.ФормаВосстановить.Видимость = Не РежимПредупреждения Или КоличествоПроблемных > 0;
	Элементы.ФормаВосстановить.Доступность = КоличествоПроблемных > 0;
	Элементы.ФормаВосстановить.КнопкаПоУмолчанию = Не Восстановлено;
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = Восстановлено;
	Элементы.ФормаЗакрыть.Заголовок = ?(Восстановлено, НСтр("ru = 'Закрыть'"), НСтр("ru = 'Отмена'"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция РазбивкаПоВидам(Проблемные)

	Количества = Новый Соответствие;
	Для Каждого Описание Из Проблемные Цикл
		Количество = Количества.Получить(Описание.ИмяДокумента);
		Количества.Вставить(Описание.ИмяДокумента, ?(Количество = Неопределено, 0, Количество) + 1);
	КонецЦикла;

	Части = Новый Массив;
	Для Каждого Вид Из НумерацияЭПД.ВидыДокументов() Цикл
		Количество = Количества.Получить(Вид.Имя);
		Если Количество <> Неопределено Тогда
			Части.Добавить(НРег(Вид.Представление) + ": " + Количество);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

&НаСервереБезКонтекста
Функция КоличествоДокументов(Количество)

	Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru = ';%1 документ;;%1 документа;%1 документов;%1 документа'"), Количество);

КонецФункции

#КонецОбласти
